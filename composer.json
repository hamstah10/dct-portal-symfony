{
    "name": "tfd/crm",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6",
        "dragonmantank/cron-expression": "^3.6",
        "easycorp/easyadmin-bundle": "*",
        "liip/imagine-bundle": "^2.17",
        "meilisearch/search-bundle": "^0.16.1",
        "nikic/php-parser": "^5.7",
        "pentiminax/ux-datatables": "^0.27.0",
        "symfony/ai-agent": "^0.6.0",
        "symfony/ai-bundle": "^0.6.0",
        "symfony/ai-chat": "^0.6.0",
        "symfony/ai-doctrine-message-store": "^0.6.0",
        "symfony/ai-firecrawl-tool": "^0.6.0",
        "symfony/ai-open-ai-platform": "*",
        "symfony/ai-platform": "^0.6.0",
        "symfony/ai-serp-api-tool": "*",
        "symfony/ai-store": "^0.6.0",
        "symfony/ai-youtube-tool": "*",
        "symfony/asset": "8.0.*",
        "symfony/asset-mapper": "8.0.*",
        "symfony/console": "8.0.*",
        "symfony/doctrine-messenger": "8.0.*",
        "symfony/dotenv": "8.0.*",
        "symfony/expression-language": "8.0.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "8.0.*",
        "symfony/http-client": "8.0.*",
        "symfony/loco-translation-provider": "8.0.*",
        "symfony/mailer": "8.0.*",
        "symfony/mcp-bundle": "^0.6.0",
        "symfony/mercure-bundle": "^0.4.2",
        "symfony/messenger": "8.0.*",
        "symfony/monolog-bundle": "^4.0",
        "symfony/notifier": "8.0.*",
        "symfony/runtime": "8.0.*",
        "symfony/scheduler": "8.0.*",
        "symfony/stimulus-bundle": "^2.32",
        "symfony/translation": "8.0.*",
        "symfony/twig-bundle": "8.0.*",
        "symfony/ux-autocomplete": "^2.32",
        "symfony/ux-chartjs": "^2.32",
        "symfony/ux-cropperjs": "^2.32",
        "symfony/ux-dropzone": "^2.32",
        "symfony/ux-icons": "^2.32",
        "symfony/ux-leaflet-map": "^2.32",
        "symfony/ux-live-component": "^2.32",
        "symfony/ux-map": "^2.32",
        "symfony/ux-notify": "^2.32",
        "symfony/ux-toolkit": "^2.32",
        "symfony/ux-turbo": "^2.33",
        "symfony/yaml": "8.0.*",
        "tfd/partner-wizard-bundle": "@dev",
        "tuningfux/instagram-bundle": "@dev",
        "twig/extra-bundle": "^2.12|^3.0",
        "twig/twig": "^2.12|^3.0",
        "webklex/php-imap": "^6.2"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.0.*"
        }
    },
    "require-dev": {
        "symfony/ai-mate": "^0.6.0",
        "symfony/debug-bundle": "8.0.*",
        "symfony/maker-bundle": "*",
        "symfony/stopwatch": "8.0.*",
        "symfony/web-profiler-bundle": "8.0.*"
    },
    "repositories": [
        {
            "name": "tfd-partner-wizard",
            "type": "path",
            "url": "./tfd-partner-wizard-bundle"
        },
        {
            "type": "path",
            "url": "tuningfux-instagram-bundle"
        }
    ]
}
