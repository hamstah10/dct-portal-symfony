ning/truck/peterbilt-trucks/389/2014", "engine_count": 1, "engines": [{"slug": "isx15-500", "name": "ISX15 500 PS - Diesel", "display_name": "ISX15 500 PS", "fuel_type": "Diesel", "url": "https://olsx.lu/de/chiptuning/truck/peterbilt-trucks/389/2014/isx15-500", "original": null, "controllers": [{"manufacturer": "Siemens/Continental", "items": [{"model": "CM2250", "ecu_type": "MCU", "tools": []}, {"model": "CM2350", "ecu_type": "MCU", "tools": []}]}], "options": [{"name": "DTC OFF", "description": "Die Option \"DTC OFF\" deaktiviert bestimmte Fehlercodes (Diagnostic Trouble Codes), die im Diagnosesystem des Fahrzeugs erscheinen können."}, {"name": "Vmax OFF", "description": "Die Option \"Vmax Off\" deaktiviert den vom Hersteller elektronisch vorgegebenen Begrenzer für die Höchstgeschwindigkeit, sodass das Fahrzeug sein volles Potenzial in Bezug auf die Höchstgeschwindigkeit ausschöpfen kann. Für Kunden ist diese Option ideal, wenn sie die Leistung ihres Fahrzeugs auf Rennstrecken oder in Umgebungen, in denen keine Geschwindigkeitsbegrenzungen gelten, maximieren möchten. Sie ermöglicht es, die volle Motorleistung zu nutzen, ohne durch eine künstliche Barriere eingeschränkt zu werden, und bietet so ein aufregenderes und befreiteres Fahrerlebnis."}, {"name": "Swirl Flap OFF", "description": "Die Option \"Swirl Flap OFF\" entfernt oder deaktiviert die Wirbelklappen im Ansaugkrümmer, die das Luft-Kraftstoff-Gemisch bei niedrigen Drehzahlen optimieren sollen. Diese Klappen können sich abnutzen oder blockieren, was zu Fehlfunktionen oder Leistungsverlust führen kann. Durch den Wegfall dieser Klappen profitieren die Kunden von einer verbesserten Gesamtleistung und einem geringeren Ausfallrisiko. Diese Option ist besonders nützlich für umgebaute Fahrzeuge oder solche, bei denen es immer wieder Probleme mit den Turbulenzklappen gibt. Sie sorgt für einen direkteren und zuverlässigeren Betrieb des Motors."}, {"name": "Vmax 30", "description": "Die Option \"Vmax 30\" begrenzt die Höchstgeschwindigkeit des Fahrzeugs elektronisch auf 30 km/h. Diese Option ist besonders nützlich für Kunden, die ihr Fahrzeug in Bereichen mit niedriger Geschwindigkeit einsetzen, z. B. in Lagerhäusern, auf Parkplätzen oder in speziellen Umgebungen, die eine strikte Geschwindigkeitsbegrenzung erfordern. Sie bietet eine geeignete Sicherheitslösung für Umgebungen, in denen es entscheidend ist, sehr niedrige Geschwindigkeiten einzuhalten, während gleichzeitig eine optimale Kontrolle über die Bewegung des Fahrzeugs in diesen Bereichen aufrechterhalten wird."}, {"name": "Checksum Correction", "description": "Die Option \"Checksum Correction\" berechnet die Prüfsumme (Checksumme) der modifizierten Datei neu, wenn das Lese-/Schreibtool dies nicht automatisch übernimmt. Eine korrekte Prüfsumme ist unerlässlich, damit das Steuergerät die Datei akzeptiert und der Motor anspringt."}, {"name": "Original File Restore", "description": "Die Option \"Original File Restore\" repariert die Steuergerätesoftware, um zu einer funktionsfähigen Originaldatei (ORI) zurückzukehren."}], "stage_count": 0, "stages": []}]}, {"slug": "2015", "name": "2015", "display_name": "2015", "url": "https://olsx.lu/de/chiptuning/truck/peterbilt-trucks/389/2015", "engine_count": 0, "engines": []}, {"slug": "2016", "name": "2016", "display_name": "2016", "url": "https://olsx.lu/de/chiptuning/truck/peterbilt-trucks/389/2016", "engine_count": 0, "engines": []}, {"slug": "2017", "name": "2017", "display_name": "2017", "url": "https://olsx.lu/de/chiptuning/truck/peterbilt-trucks/389/2017", "engine_count": 0, "engines": []}]}, {"slug": "567", "name": "567", "display_name": "567", "image": null, "url": "https://olsx.lu/de/chiptuning/truck/peterbilt-trucks/567", "version_count": 1, "versions": [{"slug": "2016", "name": "2016", "display_name": "2016", "url": "https://olsx.lu/de/chiptuning/truck/peterbilt-trucks/567/2016", "engine_count": 0, "engines": []}]}, {"slug": "579", "name": "579", "display_name": "579", "i