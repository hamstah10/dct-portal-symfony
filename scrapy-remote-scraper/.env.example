SCRAPER_NAME=products_spider
LOG_LEVEL=INFO
ROBOTSTXT_OBEY=true
START_URLS=https://example.com/products
ALLOWED_DOMAINS=example.com
OUTPUT_FORMAT=json
OUTPUT_PATH=output/data.json
DOWNLOAD_TIMEOUT=20
RETRY_TIMES=3
CONCURRENT_REQUESTS=8
DOWNLOAD_DELAY=0.5
AUTOTHROTTLE_ENABLED=true
UA_ROTATION_ENABLED=false
USER_AGENTS=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/120.0.0.0 Safari/537.36||Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/121.0.0.0 Safari/537.36
PROXY_ROTATION_ENABLED=false
PROXY_LIST=http://user:pass@proxy1:8080||http://user:pass@proxy2:8080
API_POST_ENABLED=false
API_POST_URL=https://api.example.com/ingest
API_POST_TOKEN=replace_me
MAX_PAGES=100
