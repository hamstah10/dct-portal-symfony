          {
            "$ref": "#/components/parameters/VehicleDataPoolHeader"
          },
          {
            "$ref": "#/components/parameters/ContextKeyQuery"
          },
          {
            "$ref": "#/components/parameters/PoolKeyQuery"
          },
          {
            "$ref": "#/components/parameters/TypeIdPath"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleBrandsResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/InvalidPool"
          }
        }
      }
    },
    "/api/fahrzeugdatenbank/series/{brandId}": {
      "get": {
        "tags": [
          "Vehicle Database"
        ],
        "summary": "Aktive Baureihen je Marke",
        "description": "Liefert aktive Baureihen fuer eine Marke aus dem aufgeloesten Datenpool.",
        "operationId": "vehicleSeries",
        "security": [
          {
