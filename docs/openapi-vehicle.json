            "$ref": "#/components/parameters/PoolKeyQuery"
          },
          {
            "$ref": "#/components/parameters/ModelIdPath"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleEnginesResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/InvalidPool"
          }
        }
      }
    },
    "/api/fahrzeugdatenbank/engine-details/{engineId}": {
      "get": {
        "tags": [
          "Vehicle Database"
        ],
        "summary": "Details fuer Motor inkl. Stages, ECUs und Getriebe",
        "description": "Liefert Detaildaten fuer einen aktiven Motor aus dem aufgeloesten Datenpool. Preise in Stages und ECU-Optionen werden nur gesetzt, wenn das gewaehlte Layout `showPrices` aktiviert.",
        "operationId": "vehicleEngineDetails",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TokenIdHeader"
          },
          {
            "$ref": "#/components/parameters/VehicleDataContextHeader"
          },
          {
            "$ref": "#/components/parameters/VehicleDataPoolHeader"
          },
          {
            "$ref": "#/components/parameters/ContextKeyQuery"
          },
          {
            "$ref": "#/components/parameters/PoolKeyQuery"
          },
          {
            "$ref": "#/components/parameters/EngineIdPath"
          },
          {
            "name": "stageId",
            "in": "query",
            "description": "Optionale Stage-ID fuer Tracking/Analyse. Die Antwort wird dadurch nicht auf diese Stage reduziert.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "templateVariant",
            "in": "query",
            "description": "Optionale Layout-Variante zur Preis-/Layout-Auswertung.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EngineDetailsResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/fahrzeugdatenbank/track": {
      "post": {
        "tags": [
          "Vehicle Database"
        ],
        "summary": "Tracking-Event erfassen",
        "description": "Erfasst ein Client-Tracking-Event. Ungueltige oder leere Eventnamen werden serverseitig auf `client_event` normalisiert.",
        "operationId": "vehicleTrack",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TokenIdHeader"
          },
          {
            "$ref": "#/components/parameters/VehicleDataContextHeader"
          },
          {
            "$ref": "#/components/parameters/VehicleDataPoolHeader"
          },
          {
            "$ref": "#/components/parameters/ContextKeyQuery"
          },
          {
            "$ref": "#/components/parameters/PoolKeyQuery"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrackRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Token"
      }
    },
    "parameters": {
      "TokenIdHeader": {
        "name": "X-Token-Id",
        "in": "header",
        "required": true,
        "description": "Eindeutige Token-ID aus Verwaltung -> API Tokens.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "VehicleDataContextHeader": {
        "name": "X-Vehicle-Data-Context",
        "in": "header",
        "required": false,
        "description": "Optionaler Datenkontext-Key. Muss zum Kontext des Tokens passen, falls der Token fest an einen Kontext gebunden ist.",
        "schema": {
          "type": "string"
        }
      },
      "VehicleDataPoolHeader": {
        "name": "X-Vehicle-Data-Pool",
        "in": "header",
        "required": false,
        "description": "Optionaler Datenpool-Key. Hat Vorrang vor `poolKey` und muss im gewaehlten Kontext erlaubt sein.",
        "schema": {
          "type": "string"
        }
      },
      "ContextKeyQuery": {
        "name": "contextKey",
        "in": "query",
        "required": false,
        "description": "Alternative zu `X-Vehicle-Data-Context`.",
        "schema": {
          "type": "string"
        }
      },
      "PoolKeyQuery": {
        "name": "poolKey",
        "in": "query",
        "required": false,
        "description": "Alternative zu `X-Vehicle-Data-Pool`. Wird ignoriert, wenn der Header gesetzt ist.",
        "schema": {
          "type": "string"
        }
      },
      "TypeIdPath": {
        "name": "typeId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "BrandIdPath": {
        "name": "brandId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "SeriesIdPath": {
        "name": "seriesId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "ModelIdPath": {
        "name": "modelId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "EngineIdPath": {
        "name": "engineId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Nicht autorisiert",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "InvalidPool": {
        "description": "Kein gueltiger Datenbestand gefunden",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "message": "Kein gueltiger Datenbestand gefunden."
            }
          }
        }
      },
      "NotFound": {
        "description": "Nicht gefunden",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "Pool": {
        "type": "object",
        "nullable": true,
        "properties": {
          "id": {
            "type": "integer",
            "nullable": true
          },
          "key": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ApiIndexResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Fahrzeugdatenbank API"
          },
          "pool": {
            "$ref": "#/components/schemas/Pool"
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "message",
          "pool",
          "endpoints"
        ]
      },
      "VehicleTypeItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
