{
  "openapi": "3.0.3",
  "info": {
    "title": "TFD Fahrzeugdatenbank API",
    "version": "1.2.0",
    "description": "Postman-kompatible OpenAPI-Beschreibung ausschliesslich fuer die geschuetzte Fahrzeugdatenbank-API. Die API liefert aktive Fahrzeugdaten aus einem aufloesbaren VehicleDataPool. Der Pool kann ueber Token-Kontext, Header oder Query-Parameter bestimmt werden."
  },
  "servers": [
    {
      "url": "https://portal.dct-files.de",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "Vehicle Database",
      "description": "Kaskadierende Fahrzeugsuche, Motor-Details und Client-Tracking"
    }
  ],
  "paths": {
    "/api/fahrzeugdatenbank": {
      "get": {
        "tags": [
          "Vehicle Database"
        ],
        "summary": "API-Uebersicht",
        "description": "Liefert eine kurze Uebersicht der verfuegbaren Fahrzeugdatenbank-Endpunkte und den aktuell aufgeloesten Datenpool.",
        "operationId": "vehicleApiIndex",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TokenIdHeader"
          },
          {
            "$ref": "#/components/parameters/VehicleDataContextHeader"
          },
          {
            "$ref": "#/components/parameters/VehicleDataPoolHeader"
          },
          {
            "$ref": "#/components/parameters/ContextKeyQuery"
          },
          {
            "$ref": "#/components/parameters/PoolKeyQuery"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiIndexResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/fahrzeugdatenbank/types": {
      "get": {
        "tags": [
          "Vehicle Database"
        ],
        "summary": "Aktive Fahrzeugtypen",
        "description": "Liefert aktive Fahrzeugtypen aus dem aufgeloesten Datenpool, sortiert nach Sortierung und Name.",
        "operationId": "vehicleTypes",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TokenIdHeader"
          },
          {
            "$ref": "#/components/parameters/VehicleDataContextHeader"
          },
          {
            "$ref": "#/components/parameters/VehicleDataPoolHeader"
          },
          {
            "$ref": "#/components/parameters/ContextKeyQuery"
          },
          {
            "$ref": "#/components/parameters/PoolKeyQuery"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleTypesResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/InvalidPool"
          }
        }
      }
    },
    "/api/fahrzeugdatenbank/brands/{typeId}": {
      "get": {
        "tags": [
          "Vehicle Database"
        ],
        "summary": "Aktive Marken je Typ",
        "description": "Liefert aktive Marken fuer einen Fahrzeugtyp aus dem aufgeloesten Datenpool.",
        "operationId": "vehicleBrands",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TokenIdHeader"
          },
          {
            "$ref": "#/components/parameters/VehicleDataContextHeader"
