          "nm": {
            "type": "integer",
            "nullable": true
          },
          "ecu": {
            "type": "string",
            "nullable": true
          },
          "icon": {
            "type": "string",
            "nullable": true
          },
          "images": {
            "type": "array",
            "items": {
