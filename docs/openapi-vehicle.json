          },
          {
            "$ref": "#/components/parameters/SeriesIdPath"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleSimpleListResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/InvalidPool"
          }
        }
      }
    },
    "/api/fahrzeugdatenbank/engines/{modelId}": {
      "get": {
        "tags": [
          "Vehicle Database"
        ],
        "summary": "Aktive Motoren je Modell",
        "description": "Liefert aktive Motoren fuer ein Modell aus dem aufgeloesten Datenpool.",
        "operationId": "vehicleEngines",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
