            "$ref": "#/components/schemas/EngineDetailsData"
          }
        },
        "required": [
          "data"
        ]
      },
      "EngineDetailsData": {
        "type": "object",
        "properties": {
          "engine": {
            "$ref": "#/components/schemas/EngineDetailsEngine"
          },
          "brand": {
            "$ref": "#/components/schemas/EngineDetailsBrand"
          },
          "series": {
            "$ref": "#/components/schemas/VehicleSimpleItemNullable"
          },
          "model": {
            "$ref": "#/components/schemas/VehicleSimpleItemNullable",
            "description": "Modell des Motors."
          },
          "stages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VehicleStage"
            }
          },
          "ecus": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ecu"
            }
          },
          "gearboxes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Gearbox"
            }
          },
          "einbauHinweise": {
            "type": "array",
            "description": "Motor-Einbauhinweise (motorspezifisch, unabhaengig von ECU-Optionen).",
            "items": {
              "$ref": "#/components/schemas/EinbauHinweis"
            }
          },
          "settings": {
            "$ref": "#/components/schemas/FrontendSettings"
          },
          "pool": {
            "$ref": "#/components/schemas/Pool"
          }
        },
        "required": [
          "engine",
          "brand",
          "series",
          "model",
          "stages",
          "ecus",
          "gearboxes",
          "einbauHinweise",
          "settings",
          "pool"
        ]
      },
      "EngineDetailsEngine": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "horsepower": {
            "type": "integer",
            "nullable": true
          },
          "torque": {
            "type": "integer",
            "nullable": true
          },
          "fuel": {
            "type": "string",
