            "type": "integer"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "image": {
            "type": "string",
            "nullable": true
          },
          "icon": {
            "type": "string",
            "nullable": true
          },
          "showInTopMenu": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "image",
          "icon",
          "showInTopMenu"
        ]
      },
      "VehicleSimpleItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "VehicleEngineListItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "horsepower": {
            "type": "integer",
            "nullable": true
          },
          "fuel": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "horsepower",
          "fuel"
        ]
      },
      "VehicleTypesResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VehicleTypeItem"
            }
          }
        },
        "required": [
          "data"
        ]
      },
      "VehicleBrandsResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VehicleBrandItem"
            }
          }
        },
        "required": [
          "data"
        ]
      },
      "VehicleSimpleListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VehicleSimpleItem"
            }
          }
        },
        "required": [
          "data"
        ]
      },
      "VehicleEnginesResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VehicleEngineListItem"
            }
          }
        },
        "required": [
          "data"
        ]
      },
      "EngineDetailsResponse": {
        "type": "object",
        "properties": {
