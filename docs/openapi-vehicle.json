          "name",
          "horsepower",
          "torque",
          "fuel",
          "displacement",
          "image",
          "glbModel",
          "mediaDisplayMode"
        ]
      },
      "EngineDetailsBrand": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "image": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "image"
