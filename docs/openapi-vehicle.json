          },
          {
            "$ref": "#/components/parameters/BrandIdPath"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleSimpleListResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/InvalidPool"
          }
        }
      }
    },
    "/api/fahrzeugdatenbank/models/{seriesId}": {
      "get": {
        "tags": [
          "Vehicle Database"
        ],
        "summary": "Aktive Modelle je Baureihe",
        "description": "Liefert aktive Modelle fuer eine Baureihe aus dem aufgeloesten Datenpool.",
        "operationId": "vehicleModels",
        "security": [
          {
