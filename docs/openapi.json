{
  "openapi": "3.1.0",
  "info": {
    "title": "TFD CRM API",
    "version": "1.0.0",
    "description": "OpenAPI-Beschreibung fuer die aktuellen API-Endpunkte (Auth, Customers, Orders, Fahrzeugdatenbank)."
  },
  "servers": [
    {
      "url": "https://verwaltung.tuningfux.de",
      "description": "Production"
    },
    {
      "url": "http://localhost",
      "description": "Local"
    }
  ],
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Customers"
    },
    {
      "name": "Orders"
    },
    {
      "name": "Vehicle Database"
    }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Kunden-Login",
        "operationId": "authLogin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthLoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login erfolgreich",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Token erneuern",
        "operationId": "authRefresh",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthRefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Neue Token ausgestellt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Aktuellen Kunden ermitteln",
        "operationId": "authMe",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Kunde aus Access-Token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthMeResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Session beenden",
        "operationId": "authLogout",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Logout erfolgreich"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/customers": {
      "get": {
        "tags": [
          "Customers"
        ],
        "summary": "Kundenliste",
        "description": "Erfordert einen gueltigen System-Token im Bearer-Header (ENV API_TOKEN oder Datenbank API Token).",
        "operationId": "customersList",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Liste aller Kunden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomersListResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "Customers"
        ],
        "summary": "Kunde anlegen",
        "operationId": "customersCreate",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerWrite"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Kunde angelegt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        }
      }
    },
    "/api/customers/{id}": {
      "get": {
        "tags": [
          "Customers"
        ],
        "summary": "Kunde laden",
        "operationId": "customersGet",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CustomerIdPath"
          }
        ],
        "responses": {
          "200": {
            "description": "Kunde gefunden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "tags": [
          "Customers"
        ],
        "summary": "Kunde vollstaendig aktualisieren",
        "operationId": "customersPut",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CustomerIdPath"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerWrite"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Kunde aktualisiert",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        }
      },
      "patch": {
        "tags": [
          "Customers"
        ],
        "summary": "Kunde teilweise aktualisieren",
        "operationId": "customersPatch",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CustomerIdPath"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerWrite"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Kunde aktualisiert",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        }
      },
      "delete": {
        "tags": [
          "Customers"
        ],
        "summary": "Kunde loeschen",
        "operationId": "customersDelete",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CustomerIdPath"
          }
        ],
        "responses": {
          "204": {
            "description": "Kunde geloescht oder nicht vorhanden"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/orders": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Auftrag erstellen",
        "description": "Akzeptiert Bearer-Systemtoken oder Customer-Access-Token.",
        "operationId": "ordersCreate",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Auftrag angelegt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderCreatedResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        }
      }
    },
    "/api/fahrzeugdatenbank": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TokenIdHeader"
        }
      ],
      "get": {
        "tags": [
          "Vehicle Database"
        ],
        "summary": "API-Uebersicht",
        "operationId": "vehicleApiIndex",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Info und Endpointliste",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleApiIndexResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/fahrzeugdatenbank/types": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TokenIdHeader"
        }
      ],
      "get": {
        "tags": [
          "Vehicle Database"
        ],
        "summary": "Aktive Fahrzeugtypen",
        "operationId": "vehicleTypes",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Liste aktiver Typen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleTypesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/fahrzeugdatenbank/brands/{typeId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TokenIdHeader"
        }
      ],
      "get": {
        "tags": [
          "Vehicle Database"
        ],
        "summary": "Aktive Marken je Typ",
        "operationId": "vehicleBrands",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TypeIdPath"
          }
        ],
        "responses": {
          "200": {
            "description": "Liste aktiver Marken",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleBrandsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/fahrzeugdatenbank/series/{brandId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TokenIdHeader"
        }
      ],
      "get": {
        "tags": [
          "Vehicle Database"
        ],
        "summary": "Aktive Baureihen je Marke",
        "operationId": "vehicleSeries",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/BrandIdPath"
          }
        ],
        "responses": {
          "200": {
            "description": "Liste aktiver Baureihen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleSeriesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/fahrzeugdatenbank/models/{seriesId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TokenIdHeader"
        }
      ],
      "get": {
        "tags": [
          "Vehicle Database"
        ],
        "summary": "Aktive Modelle je Baureihe",
        "operationId": "vehicleModels",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SeriesIdPath"
          }
        ],
        "responses": {
          "200": {
            "description": "Liste aktiver Modelle",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleModelsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/fahrzeugdatenbank/engines/{modelId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TokenIdHeader"
        }
      ],
      "get": {
        "tags": [
          "Vehicle Database"
        ],
        "summary": "Aktive Motoren je Modell",
        "operationId": "vehicleEngines",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ModelIdPath"
          }
        ],
        "responses": {
          "200": {
            "description": "Liste aktiver Motoren",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleEnginesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/fahrzeugdatenbank/engine-details/{engineId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TokenIdHeader"
        }
      ],
      "get": {
        "tags": [
          "Vehicle Database"
        ],
        "summary": "Details fuer Motor inkl. Stages und ECUs",
        "operationId": "vehicleEngineDetails",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/EngineIdPath"
          },
          {
            "name": "stageId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "templateVariant",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Motor-Detaildaten",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleEngineDetailsResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/fahrzeugdatenbank/track": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TokenIdHeader"
        }
      ],
      "post": {
        "tags": [
          "Vehicle Database"
        ],
        "summary": "Tracking-Event erfassen",
        "operationId": "vehicleTrack",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VehicleTrackRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tracking gespeichert",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Token"
      }
    },
    "parameters": {
      "CustomerIdPath": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "TypeIdPath": {
        "name": "typeId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "BrandIdPath": {
        "name": "brandId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "SeriesIdPath": {
        "name": "seriesId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "ModelIdPath": {
        "name": "modelId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "EngineIdPath": {
        "name": "engineId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "TokenIdHeader": {
        "name": "X-Token-Id",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64
        },
        "description": "Eindeutige Token-ID aus Verwaltung -> API Tokens."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Ungueltige Anfrage",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Nicht autorisiert",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Zugriff verboten",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Nicht gefunden",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "UnprocessableEntity": {
        "description": "Validierungsfehler",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "AuthLoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          },
          "deviceName": {
            "type": "string",
            "maxLength": 120
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthRefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "TokenPair": {
        "type": "object",
        "properties": {
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          },
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "tokenType",
          "accessToken",
          "accessTokenExpiresAt",
          "refreshToken",
          "refreshTokenExpiresAt"
        ]
      },
      "AuthCustomer": {
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "companyName": {
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "format": "email"
          },
          "username": {
            "type": [
              "string",
              "null"
            ]
          },
          "gesperrt": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "companyName",
          "email",
          "username",
          "gesperrt"
        ]
      },
      "LoginResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TokenPair"
          },
          {
            "type": "object",
            "properties": {
              "customer": {
                "$ref": "#/components/schemas/AuthCustomer"
              }
            },
            "required": [
              "customer"
            ]
          }
        ]
      },
      "AuthMeResponse": {
        "type": "object",
        "properties": {
          "customer": {
            "$ref": "#/components/schemas/AuthCustomer"
          }
        },
        "required": [
          "customer"
        ]
      },
      "Customer": {
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "kundennummer": {
            "type": [
              "string",
              "null"
            ]
          },
          "firmenname": {
            "type": [
              "string",
              "null"
            ]
          },
          "vorname": {
            "type": "string"
          },
          "nachname": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "firmaId": {
            "type": [
              "integer",
              "null"
            ]
          },
          "telefon": {
            "type": [
              "string",
              "null"
            ]
          },
          "ustId": {
            "type": [
              "string",
              "null"
            ]
          },
          "steuernummer": {
            "type": [
              "string",
              "null"
            ]
          },
          "strasse": {
            "type": [
              "string",
              "null"
            ]
          },
