    const containsLikelyHtml = (value) => /<\/?[a-z][\s\S]*>/i.test(String(value ?? ''));

    const sanitizeDbHtml = (unsafeHtml) => {
        const raw = String(unsafeHtml ?? '').trim();
        if (!raw) {
            return '';
        }

        if (!window.DOMParser) {
            return escapeHtml(raw);
        }

        const allowedTags = new Set(['A', 'B', 'STRONG', 'I', 'EM', 'U', 'BR', 'P', 'UL', 'OL', 'LI', 'SPAN', 'SMALL']);
        const allowedAttributeMap = {
            A: new Set(['href', 'title', 'target', 'rel']),
        };
        const removedTagNames = new Set(['SCRIPT', 'STYLE', 'IFRAME', 'OBJECT', 'EMBED', 'TEMPLATE']);

        const parser = new window.DOMParser();
        const doc = parser.parseFromString(`<div>${raw}</div>`, 'text/html');
        const container = doc.body.firstElementChild;
        if (!container) {
            return escapeHtml(raw);
        }

        const nodes = Array.from(container.querySelectorAll('*'));
        for (let index = nodes.length - 1; index >= 0; index -= 1) {
            const node = nodes[index];
            if (!node || node.nodeType !== 1) {
                continue;
            }

            const tagName = String(node.tagName || '').toUpperCase();
            if (removedTagNames.has(tagName)) {
                node.remove();
                continue;
            }

            if (!allowedTags.has(tagName)) {
                const parent = node.parentNode;
                if (!parent) {
                    node.remove();
                    continue;
                }

                while (node.firstChild) {
                    parent.insertBefore(node.firstChild, node);
                }

                parent.removeChild(node);
                continue;
            }

            const allowedAttributes = allowedAttributeMap[tagName] || new Set();
            Array.from(node.attributes || []).forEach((attribute) => {
                const name = String(attribute?.name || '').toLowerCase();
                if (!name) {
                    return;
                }

                if (name.startsWith('on') || name === 'style') {
                    node.removeAttribute(attribute.name);
                    return;
                }

                if (!allowedAttributes.has(name)) {
                    node.removeAttribute(attribute.name);
                }
            });

            if ('A' === tagName) {
                const href = String(node.getAttribute('href') || '').trim();
                if (href) {
                    const isSafeHref = href.startsWith('#')
                        || href.startsWith('/')
                        || /^(https?:|mailto:|tel:)/i.test(href);
                    if (!isSafeHref) {
                        node.removeAttribute('href');
                    }
                }

                const target = String(node.getAttribute('target') || '').trim().toLowerCase();
                if ('_blank' === target) {
                    node.setAttribute('rel', 'noopener noreferrer');
                } else if (target) {
                    node.removeAttribute('target');
                }
            }
        }

        return container.innerHTML;
    };

