	    const trackEvent = (eventName, payload = {}) => {
	        const normalizedName = String(eventName || '').trim();
	        if (!normalizedName) {
	            return;
	        }

	        if (apiTesterMode && !hasApiCredentials()) {
	            return;
	        }

	        const body = {
	            event: normalizedName,
	            templateVariant: getTemplateVariant(),
	            ...payload,
	        };

        fetch(endpoints.track(), {
            method: 'POST',
            headers: buildRequestHeaders({ json: true }),
            body: JSON.stringify(body),
            credentials: 'same-origin',
            keepalive: true,
        }).catch(() => {});
    };

	    const loadIntoSelect = async (select, url, placeholder) => {
