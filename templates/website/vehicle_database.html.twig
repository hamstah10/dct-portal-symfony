{% extends 'base.html.twig' %}

{% set apiTesterMode = apiTesterMode|default(false) %}
{% set widgetMode = widgetMode|default(false) %}
{% set websiteWidget = websiteWidget|default({}) %}

{% block title %}{{ apiTesterMode ? 'Fahrzeugdatenbank API Test' : 'Fahrzeugdatenbank' }}{% endblock %}

{% set rawTemplateVariant = frontendSettings.templateVariant|default('performance') %}
{% set templateVariant = rawTemplateVariant == 'layout2' ? 'contrast' : rawTemplateVariant %}
{% set templateClassVariant = templateVariant == 'contrast' ? 'layout2' : (templateVariant == 'widget_premium_dark' ? 'widget-premium-dark' : (templateVariant == 'widget_premium_light' ? 'widget-premium-light' : (templateVariant == 'widget_catalog_light' ? 'widget-catalog-light' : templateVariant))) %}
{% set layoutPartials = {
    'performance': 'website/vehicle_database/partials/_layout_performance.html.twig',
    'widget_premium_dark': 'website/vehicle_database/partials/_layout_widget_premium_dark.html.twig',
    'widget_premium_light': 'website/vehicle_database/partials/_layout_widget_premium_light.html.twig',
    'widget_catalog_light': 'website/vehicle_database/partials/_layout_widget_catalog_light.html.twig',
    'minimal': 'website/vehicle_database/partials/_layout_minimal.html.twig',
    'contrast': 'website/vehicle_database/partials/_layout_contrast.html.twig',
    'layout2': 'website/vehicle_database/partials/_layout_contrast.html.twig',
    'layout3': 'website/vehicle_database/partials/_layout_sidebar.html.twig',
    'layout4': 'website/vehicle_database/partials/_layout_download.html.twig',
    'layout5': 'website/vehicle_database/partials/_layout_table.html.twig',
    'layout6': 'website/vehicle_database/partials/_layout_sidebar_light.html.twig',
} %}
{% set activeLayoutPartial = layoutPartials[templateVariant] is defined ? layoutPartials[templateVariant] : layoutPartials['performance'] %}
{% set activePoolKey = currentDataPoolKey|default('live') %}
{% set activePoolName = 'Live' %}
{% for pool in availableDataPools|default([]) %}
    {% if pool.key == activePoolKey %}
        {% set activePoolName = pool.name %}
    {% endif %}
{% endfor %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@5.15.4/css/all.min.css">
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/odometer.js/0.4.7/themes/odometer-theme-default.min.css"
        integrity="sha512-/k/mL9TQSZHAqtVqXJAiy5bt2w1P7gxdra0UlnFjVHF9a/LC2vxt7otx3BMcn79V/DZsPRwdw8tPlwbElMnIAw=="
        crossorigin="anonymous"
        referrerpolicy="no-referrer"
    >
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/vehicle_database.css') }}?v={{ vehicleDatabaseCssVersion|default('1') }}">
    {% if widgetMode %}
        <style>
            html,
            body {
                min-height: 0 !important;
                background: {{ websiteWidget.backgroundColor|default('#ffffff') }} !important;
            }

            body {
                margin: 0;
                overflow-x: hidden;
            }

            .vdb-page.vdb-widget-mode {
                --vdb-bg: {{ websiteWidget.backgroundColor|default('#ffffff') }};
                --vdb-text: {{ websiteWidget.textColor|default('#1a1a1a') }};
                --vdb-red: {{ websiteWidget.primaryColor|default('#5a2116') }};
                --vdb-primary-contrast: {{ websiteWidget.buttonTextColor|default(websiteWidget.backgroundColor|default('#ffffff')) }};
                --vdb-panel: color-mix(in srgb, {{ websiteWidget.backgroundColor|default('#ffffff') }} 92%, {{ websiteWidget.textColor|default('#1a1a1a') }} 8%);
                --vdb-panel-soft: color-mix(in srgb, {{ websiteWidget.backgroundColor|default('#ffffff') }} 86%, {{ websiteWidget.textColor|default('#1a1a1a') }} 14%);
                --vdb-select-bg: {{ websiteWidget.selectBackgroundColor|default('#ffffff') }};
                --vdb-select-open-bg: {{ websiteWidget.selectOpenBackgroundColor|default('#f3f4f6') }};
                --vdb-line: color-mix(in srgb, {{ websiteWidget.textColor|default('#1a1a1a') }} 22%, transparent);
                --vdb-line2: color-mix(in srgb, {{ websiteWidget.textColor|default('#1a1a1a') }} 14%, transparent);
                background: {{ websiteWidget.backgroundColor|default('#ffffff') }};
                color: {{ websiteWidget.textColor|default('#1a1a1a') }} !important;
                min-height: auto;
            }

            .vdb-widget-mode .btn-tuningfux,
            .vdb-widget-mode .vdb-selects .btn,
            .vdb-widget-mode:not(.vdb-template-widget-catalog-light) .vdb-tab.active {
                background: {{ websiteWidget.primaryColor|default('#5a2116') }} !important;
                border-color: {{ websiteWidget.primaryColor|default('#5a2116') }} !important;
                color: var(--vdb-primary-contrast) !important;
            }

            .vdb-widget-mode .form-select,
            .vdb-widget-mode .form-control,
            .vdb-widget-mode .select2-container .select2-selection--single,
            .vdb-widget-mode .select2-dropdown {
                background: {{ websiteWidget.selectBackgroundColor|default('#ffffff') }} !important;
                background-color: {{ websiteWidget.selectBackgroundColor|default('#ffffff') }} !important;
                color: {{ websiteWidget.textColor|default('#1a1a1a') }} !important;
                border-color: color-mix(in srgb, {{ websiteWidget.textColor|default('#1a1a1a') }} 22%, transparent) !important;
            }

            .vdb-widget-mode .select2-container .select2-selection--single .select2-selection__rendered,
            .vdb-widget-mode .select2-results__option {
                color: {{ websiteWidget.textColor|default('#1a1a1a') }} !important;
            }

            .vdb-widget-mode .select2-container--default .select2-results__option--highlighted.select2-results__option--selectable,
            .vdb-widget-mode .select2-container--default .select2-results__option--selected,
            .vdb-widget-mode .select2-container--default .select2-search--dropdown .select2-search__field {
                background: {{ websiteWidget.selectOpenBackgroundColor|default('#f3f4f6') }} !important;
                background-color: {{ websiteWidget.selectOpenBackgroundColor|default('#f3f4f6') }} !important;
                color: {{ websiteWidget.textColor|default('#1a1a1a') }} !important;
            }

            .vdb-widget-mode .vdb-stage-card-red,
            .vdb-widget-mode .vdb-option-check,
            .vdb-widget-mode .vdb-stage-price,
            .vdb-widget-mode .vdb-option-price {
                color: {{ websiteWidget.primaryColor|default('#5a2116') }} !important;
                border-color: {{ websiteWidget.primaryColor|default('#5a2116') }} !important;
            }

            .vdb-widget-header {
                margin: 0 auto 1.25rem;
                max-width: 1140px;
                padding: 1.25rem 0.75rem 0;
            }

            .vdb-widget-title {
                margin: 0;
                font-size: clamp(1.35rem, 2.4vw, 2rem);
                font-weight: 700;
            }

            .vdb-widget-subtitle {
                margin: 0.35rem 0 0;
                opacity: 0.78;
            }

            .vdb-widget-inquiry {
                margin: 1.5rem auto 2rem;
                max-width: 1140px;
                padding: 0 0.75rem;
            }

            .vdb-widget-inquiry-box {
                border: 1px solid color-mix(in srgb, {{ websiteWidget.textColor|default('#1a1a1a') }} 18%, transparent);
                border-radius: 8px;
                background: color-mix(in srgb, {{ websiteWidget.backgroundColor|default('#ffffff') }} 88%, {{ websiteWidget.textColor|default('#1a1a1a') }} 12%);
                color: {{ websiteWidget.textColor|default('#1a1a1a') }};
                padding: 1rem;
            }

            .vdb-widget-inquiry-form {
                margin-top: 1rem;
            }

            .vdb-widget-inquiry-status {
                min-height: 1.4rem;
                margin-top: 0.75rem;
                font-weight: 600;
            }

            {% if websiteWidget.typeIconColor|default('white') == 'black' %}
            .vdb-widget-mode .vdb-type-option-icon--muted img { filter: brightness(0) !important; }
            {% else %}
            .vdb-widget-mode .vdb-type-option-icon--muted img { filter: brightness(0) invert(1) !important; }
            {% endif %}

            {{ websiteWidget.customCss|default('')|raw }}
        </style>
    {% endif %}
    {% if apiTesterMode %}
        <style>
            .vdb-api-auth-box {
                margin-bottom: 1rem;
                padding: 1rem;
                background: rgba(255, 255, 255, 0.06);
                border: 1px solid rgba(255, 255, 255, 0.18);
                border-radius: 0.5rem;
                backdrop-filter: blur(4px);
            }

            .vdb-api-auth-label {
                color: #f4f4f4;
                font-size: 0.85rem;
                margin-bottom: 0.35rem;
                display: block;
            }

            .vdb-api-auth-status {
                font-size: 0.85rem;
                margin-top: 0.5rem;
                min-height: 1.2rem;
            }

            .vdb-api-auth-status.text-danger {
                color: #ffb4b4 !important;
            }

            .vdb-api-auth-status.text-success {
                color: #8fe6ae !important;
            }
        </style>
    {% endif %}
{% endblock %}

{% block body %}
<div class="vdb-page vdb-template-{{ templateClassVariant }}{{ widgetMode ? ' vdb-widget-mode' : '' }}">
    <div class="vdb-shell">
        {% if widgetMode and (websiteWidget.title|default('') or websiteWidget.subtitle|default('')) %}
            <div class="vdb-widget-header">
                {% if websiteWidget.title|default('') %}
                    <h1 class="vdb-widget-title">{{ websiteWidget.title }}</h1>
                {% endif %}
                {% if websiteWidget.subtitle|default('') %}
                    <p class="vdb-widget-subtitle">{{ websiteWidget.subtitle }}</p>
                {% endif %}
            </div>
        {% endif %}
        {% if not widgetMode %}
            <div class="vdb-head">
                <div class="vdb-head-logo-wrap" id="vdbHeadLogoWrap" data-logo-src="{{ asset('images/tuningfux-gelb.svg') }}">
                    <img
                        class="vdb-head-logo"
                        src="{{ asset('images/tuningfux-gelb.svg') }}"
                        alt="Tuningfux Logo"
                        width="250"
                    >
                </div>
                <div class="vdb-pool-badge-wrap">
                    <span class="vdb-pool-badge">
                        <span class="vdb-pool-badge-label">Aktiver Datenbestand</span>
                        <span class="vdb-pool-badge-value">{{ activePoolName }}</span>
                    </span>
                </div>
            </div>
        {% endif %}

        {% if apiTesterMode %}
            <div class="container">
                <div class="vdb-api-auth-box">
                    <div class="row g-2 align-items-end">
                        <div class="col-12 col-lg-3">
                            <label for="apiTokenIdInput" class="vdb-api-auth-label">Token-ID (X-Token-Id)</label>
                            <input id="apiTokenIdInput" type="text" class="form-control" placeholder="z. B. tok_abc123">
                        </div>
                        <div class="col-12 col-lg-5">
                            <label for="apiTokenInput" class="vdb-api-auth-label">Bearer-Token</label>
                            <input id="apiTokenInput" type="text" class="form-control" placeholder="Bearer-Token">
                        </div>
                        <div class="col-12 col-lg-4 d-grid d-lg-flex gap-2 justify-content-lg-end">
                            <button type="button" id="apiAuthSaveBtn" class="btn btn-primary">Zugang speichern</button>
                            <button type="button" id="apiAuthLoadBtn" class="btn btn-outline-light">Daten laden</button>
                        </div>
                    </div>
                    <div id="apiAuthStatus" class="vdb-api-auth-status text-light">
                        API-Testmodus aktiv: Bitte Token-ID und Bearer-Token eingeben.
                    </div>
                </div>
            </div>
        {% endif %}

        {{ include('website/vehicle_database/partials/_selects.html.twig') }}

	        <div id="vdbFloatingControls" class="vdb-floating-controls d-none">
	            {% if frontendSettings.layoutSwitcherEnabled|default(false) %}
	                <div class="vdb-layout-switcher">
	                    <label class="visually-hidden" for="layoutSwitcherSelect">Layout</label>
	                    <select id="layoutSwitcherSelect" class="form-select form-select-sm vdb-layout-switcher-select" aria-label="Layout wählen">
	                        <option value="performance" {{ templateVariant == 'performance' ? 'selected' : '' }}>Performance</option>
	                        <option value="minimal" {{ templateVariant == 'minimal' ? 'selected' : '' }}>Minimal</option>
	                        <option value="contrast" {{ templateVariant == 'contrast' ? 'selected' : '' }}>Contrast</option>
	                        <option value="layout3" {{ templateVariant == 'layout3' ? 'selected' : '' }}>V3 Sidebar</option>
	                        <option value="layout4" {{ templateVariant == 'layout4' ? 'selected' : '' }}>V4 Download</option>
	                        <option value="layout5" {{ templateVariant == 'layout5' ? 'selected' : '' }}>V5 Tabelle</option>
	                        <option value="layout6" {{ templateVariant == 'layout6' ? 'selected' : '' }}>V6 Sidebar Hell</option>
	                        <option value="widget_catalog_light" {{ templateVariant == 'widget_catalog_light' ? 'selected' : '' }}>Widget Katalog Hell</option>
	                    </select>
	                </div>
                    <button type="button" id="apiRawJsonBtn" class="btn vdb-api-raw-btn">
                        API JSON
                    </button>
	            {% endif %}

            <button type="button" id="resetSelectionFloatingBtn" class="btn btn-tuningfux vdb-reset-floating d-none">
                Reset Auswahl
            </button>
        </div>

        <div id="apiRawJsonModal" class="vdb-api-raw-modal d-none" role="dialog" aria-modal="true" aria-labelledby="apiRawJsonTitle">
            <div class="vdb-api-raw-modal__backdrop" data-api-raw-close></div>
            <div class="vdb-api-raw-modal__panel" tabindex="-1">
                <div class="vdb-api-raw-modal__head">
                    <div>
                        <div class="vdb-api-raw-modal__eyebrow">API Vergleich</div>
                        <h2 id="apiRawJsonTitle" class="vdb-api-raw-modal__title">Raw JSON Daten</h2>
                    </div>
                    <button type="button" class="btn vdb-api-raw-modal__close" data-api-raw-close aria-label="Schliessen">
                        &times;
                    </button>
                </div>
                <pre id="apiRawJsonOutput" class="vdb-api-raw-output">Noch keine API-Daten geladen.</pre>
            </div>
        </div>

        <div id="resultArea" class="d-none">
            {{ include(activeLayoutPartial) }}
        </div>

        {% if widgetMode %}
            <div id="vdbWidgetInquiry" class="vdb-widget-inquiry d-none">
                <div class="vdb-widget-inquiry-box">
                    <a href="{{ vehicleWidgetInquiryPath|default('#') }}" id="vdbWidgetInquiryLink" class="btn btn-tuningfux">
                        {{ websiteWidget.buttonText|default('Anfrage senden') }}
                    </a>
                </div>
            </div>
        {% endif %}

        {% if frontendSettings.layoutSwitcherEnabled|default(false) %}
            <template id="vdbLayoutTpl-performance">
                {{ include('website/vehicle_database/partials/_layout_performance.html.twig') }}
            </template>
            <template id="vdbLayoutTpl-widget-premium-dark">
                {{ include('website/vehicle_database/partials/_layout_widget_premium_dark.html.twig') }}
            </template>
            <template id="vdbLayoutTpl-widget-premium-light">
                {{ include('website/vehicle_database/partials/_layout_widget_premium_light.html.twig') }}
            </template>
            <template id="vdbLayoutTpl-widget-catalog-light">
                {{ include('website/vehicle_database/partials/_layout_widget_catalog_light.html.twig') }}
            </template>
            <template id="vdbLayoutTpl-minimal">
                {{ include('website/vehicle_database/partials/_layout_minimal.html.twig') }}
            </template>
            <template id="vdbLayoutTpl-contrast">
                {{ include('website/vehicle_database/partials/_layout_contrast.html.twig') }}
            </template>
            <template id="vdbLayoutTpl-layout3">
                {{ include('website/vehicle_database/partials/_layout_sidebar.html.twig') }}
            </template>
            <template id="vdbLayoutTpl-layout4">
                {{ include('website/vehicle_database/partials/_layout_download.html.twig') }}
            </template>
            <template id="vdbLayoutTpl-layout5">
                {{ include('website/vehicle_database/partials/_layout_table.html.twig') }}
            </template>
            <template id="vdbLayoutTpl-layout6">
                {{ include('website/vehicle_database/partials/_layout_sidebar_light.html.twig') }}
            </template>
        {% endif %}
    </div>
</div>

<script>
(() => {
    const logoWrap = document.getElementById('vdbHeadLogoWrap');
    if (!logoWrap) {
        return;
    }

    const logoSrc = logoWrap.dataset.logoSrc || '';
    if (!logoSrc) {
        return;
    }

    window.fetch(logoSrc)
        .then((response) => {
            if (!response.ok) {
                throw new Error('Logo SVG konnte nicht geladen werden.');
            }

            return response.text();
        })
        .then((svgMarkup) => {
            const parser = new window.DOMParser();
            const documentSvg = parser.parseFromString(svgMarkup, 'image/svg+xml');
            const svg = documentSvg.querySelector('svg');
            if (!svg) {
                return;
            }

            svg.classList.add('vdb-head-logo', 'vdb-head-logo-svg');
            svg.setAttribute('role', 'img');
            svg.setAttribute('aria-label', 'Tuningfux Logo');
            svg.removeAttribute('id');

            const paths = svg.querySelectorAll('path');
            paths.forEach((path, index) => {
                path.style.setProperty('--i', String(index));
            });

            logoWrap.innerHTML = '';
            logoWrap.appendChild(svg);
        })
        .catch(() => {
            // Fallback bleibt das normale <img>.
        });
})();
</script>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/odometer.js/0.4.7/odometer.min.js"></script>
<script type="module" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
<script nomodule src="https://unpkg.com/@google/model-viewer/dist/model-viewer-legacy.js"></script>
<script src="https://unpkg.com/three@0.165.0/build/three.min.js"></script>
<script src="https://unpkg.com/three@0.165.0/examples/js/loaders/GLTFLoader.js"></script>
<script>
(() => {
    const frontendSettings = {{ frontendSettings|json_encode|raw }};
    const availableDataPools = {{ availableDataPools|default([])|json_encode|raw }};
    const defaultDataPoolKey = '{{ currentDataPoolKey|default('live')|e('js') }}' || 'live';
    const layoutSwitcherEnabled = Boolean(frontendSettings.layoutSwitcherEnabled);

    const safeStorage = {
        get(key) {
            try {
                return window.localStorage?.getItem(key) || '';
            } catch (error) {
                return '';
            }
        },
        set(key, value) {
            try {
                window.localStorage?.setItem(key, value);
            } catch (error) {
                // Ignore.
            }
        },
    };

    const rawDefaultTemplateVariant = String(frontendSettings.templateVariant || '').trim().toLowerCase();
    const allowedTemplateVariants = rawDefaultTemplateVariant === 'widget_premium_dark'
        ? ['performance', 'minimal', 'contrast', 'layout3', 'layout4', 'layout5', 'layout6', 'widget_premium_dark']
        : (rawDefaultTemplateVariant === 'widget_premium_light'
            ? ['performance', 'minimal', 'contrast', 'layout3', 'layout4', 'layout5', 'layout6', 'widget_premium_light']
            : (rawDefaultTemplateVariant === 'widget_catalog_light'
                ? ['performance', 'minimal', 'contrast', 'layout3', 'layout4', 'layout5', 'layout6', 'widget_catalog_light']
                : ['performance', 'minimal', 'contrast', 'layout3', 'layout4', 'layout5', 'layout6']));

    const normalizeTemplateVariant = (variant, fallback) => {
        const raw = String(variant || '').trim().toLowerCase();
        const resolved = raw === 'layout2' ? 'contrast' : raw;

        if (allowedTemplateVariants.includes(resolved)) {
            return resolved;
        }

        return fallback;
    };

    const defaultTemplateVariant = normalizeTemplateVariant(frontendSettings.templateVariant || 'performance', 'performance');
    let activeTemplateVariant = defaultTemplateVariant;

    if (layoutSwitcherEnabled) {
        activeTemplateVariant = normalizeTemplateVariant(safeStorage.get('vdb_layout_variant'), defaultTemplateVariant);
    }

    frontendSettings.templateVariant = activeTemplateVariant;

    const getTemplateVariant = () => activeTemplateVariant;
    const getTemplateClassVariant = () => {
        if (getTemplateVariant() === 'contrast') {
            return 'layout2';
        }

        if (getTemplateVariant() === 'widget_premium_dark') {
            return 'widget-premium-dark';
        }

        if (getTemplateVariant() === 'widget_premium_light') {
            return 'widget-premium-light';
        }

        if (getTemplateVariant() === 'widget_catalog_light') {
            return 'widget-catalog-light';
        }

        return getTemplateVariant();
    };
    const isLayout2 = () => getTemplateVariant() === 'contrast';
    const isLayout3 = () => getTemplateVariant() === 'layout3';
    const isLayout4 = () => getTemplateVariant() === 'layout4';
    const isLayout5 = () => getTemplateVariant() === 'layout5';
    const isLayout6 = () => getTemplateVariant() === 'layout6';
    const isCatalogLight = () => getTemplateVariant() === 'widget_catalog_light';
    const isFullscreenLayout = () => isLayout2() || isLayout3() || isLayout4() || isLayout5() || isCatalogLight();

    const defaultLayoutSettings = {
        glbAutorotate: false,
        showPrices: true,
        showLogo: true,
        showOnlyStage1: false,
    };

    const layoutSettingsByVariant = frontendSettings.layoutSettings && typeof frontendSettings.layoutSettings === 'object'
        ? frontendSettings.layoutSettings
        : {};

    const resolveLayoutSettings = (variant) => {
        const resolvedVariant = normalizeTemplateVariant(variant, defaultTemplateVariant);
        const raw = layoutSettingsByVariant[resolvedVariant] && typeof layoutSettingsByVariant[resolvedVariant] === 'object'
            ? layoutSettingsByVariant[resolvedVariant]
            : {};

        return {
            glbAutorotate: Boolean(raw.glbAutorotate ?? defaultLayoutSettings.glbAutorotate),
            showPrices: Boolean(raw.showPrices ?? defaultLayoutSettings.showPrices),
            showLogo: Boolean(raw.showLogo ?? defaultLayoutSettings.showLogo),
            showOnlyStage1: Boolean(raw.showOnlyStage1 ?? defaultLayoutSettings.showOnlyStage1),
        };
    };

    const head = document.querySelector('.vdb-head');

    const syncLogoVisibility = () => {
        if (!head) {
            return;
        }

        if (!frontendSettings.showLogo) {
            head.style.display = 'none';
            return;
        }

        head.style.display = isFullscreenLayout() ? 'block' : '';
    };

    const syncActiveLayoutSettings = () => {
        const flags = resolveLayoutSettings(getTemplateVariant());
        frontendSettings.glbAutorotate = flags.glbAutorotate;
        frontendSettings.showPrices = flags.showPrices;
        frontendSettings.showLogo = flags.showLogo;
        frontendSettings.showOnlyStage1 = flags.showOnlyStage1;
        syncLogoVisibility();
    };

    syncActiveLayoutSettings();

    const apiTesterMode = {{ apiTesterMode ? 'true' : 'false' }};
    const vehicleWidgetMode = {{ widgetMode ? 'true' : 'false' }};
    const vehicleWidgetInquiryBaseUrl = '{{ vehicleWidgetInquiryPath|default('')|e('js') }}';
    const configuredWidgetVehicleTypeId = Number('{{ websiteWidget.vehicleTypeId|default(0)|e('js') }}') || 0;
    const widgetPerformanceChartEnabled = !vehicleWidgetMode || {{ websiteWidget.showPerformanceChart|default(true) ? 'true' : 'false' }};
    let activeDataPoolKey = String(defaultDataPoolKey || 'live').trim() || 'live';
    const configuredApiBasePrefix = '{{ vehicleDatabaseApiBasePath|default('')|e('js') }}';
    const apiBasePrefix = configuredApiBasePrefix || (apiTesterMode
        ? '{{ path('api_vehicle_database_types')|replace({"/types": ""}) }}'
        : '{{ path('app_vehicle_database_types')|replace({"/types": ""}) }}');

    const appendPoolKey = (path) => {
        if (vehicleWidgetMode) {
            return path;
        }

        const separator = path.includes('?') ? '&' : '?';
        return `${path}${separator}poolKey=${encodeURIComponent(activeDataPoolKey)}`;
    };

    const endpoints = {
        types: () => appendPoolKey(`${apiBasePrefix}/types`),
        brands: (typeId) => appendPoolKey(`${apiBasePrefix}/brands/${typeId}`),
        series: (brandId) => appendPoolKey(`${apiBasePrefix}/series/${brandId}`),
        models: (seriesId) => appendPoolKey(`${apiBasePrefix}/models/${seriesId}`),
        engines: (modelId) => appendPoolKey(`${apiBasePrefix}/engines/${modelId}`),
        details: (engineId) => appendPoolKey(`${apiBasePrefix}/engine-details/${engineId}?templateVariant=${encodeURIComponent(getTemplateVariant())}`),
        track: () => appendPoolKey(`${apiBasePrefix}/track`),
    };

    const apiTokenIdInput = document.getElementById('apiTokenIdInput');
    const apiTokenInput = document.getElementById('apiTokenInput');
    const apiAuthSaveBtn = document.getElementById('apiAuthSaveBtn');
    const apiAuthLoadBtn = document.getElementById('apiAuthLoadBtn');
