		        const currentFlags = resolveLayoutSettings(getTemplateVariant());
		        const resolved = normalizeTemplateVariant(nextVariant, getTemplateVariant());
		        if (resolved === getTemplateVariant()) {
		            syncLayoutSwitcherSelectValue();
		            return;
		        }

			        const nextFlags = resolveLayoutSettings(resolved);
			        activeTemplateVariant = resolved;
			        frontendSettings.templateVariant = resolved;
			        if (resolved !== 'performance' && resolved !== 'minimal') {
			            performanceOptionsViewActive = false;
			            performanceChartViewActive = false;
			            performanceGearboxViewActive = false;
