    const getLayout2BarWidth = (stageCount, stageIndex) => {
        if (stageCount <= 0) {
            return 0;
        }

        if (stageCount === 1) {
            return 50;
        }

        const clampedIndex = Math.max(0, Math.min(stageCount - 1, stageIndex));
        const step = 50 / (stageCount - 1);

        return Math.min(100, Math.round(50 + (clampedIndex * step)));
    };

    const stopThreeViewer = () => {
        if (threeViewerState.animationFrameId) {
            window.cancelAnimationFrame(threeViewerState.animationFrameId);
            threeViewerState.animationFrameId = 0;
        }

        if (threeViewerState.resizeHandler) {
            window.removeEventListener('resize', threeViewerState.resizeHandler);
            threeViewerState.resizeHandler = null;
        }

        if (threeViewerState.scene) {
            threeViewerState.scene.traverse((child) => {
                if (child?.geometry && typeof child.geometry.dispose === 'function') {
                    child.geometry.dispose();
                }

                if (!child?.material) {
                    return;
                }

                const materials = Array.isArray(child.material) ? child.material : [child.material];
                materials.forEach((material) => {
                    if (material && typeof material.dispose === 'function') {
                        material.dispose();
                    }
                });
            });
        }

        if (threeViewerState.renderer) {
            threeViewerState.renderer.dispose();
            threeViewerState.renderer = null;
        }

        threeViewerState.scene = null;
        threeViewerState.camera = null;
        threeViewerState.modelRoot = null;
    };

    const startThreeAnimation = () => {
        let lastFrameTimestamp = 0;
        const tick = (timestamp) => {
            if (!threeViewerState.renderer || !threeViewerState.scene || !threeViewerState.camera) {
                return;
            }

            const deltaSeconds = lastFrameTimestamp > 0 ? Math.max(0, (timestamp - lastFrameTimestamp) / 1000) : 0;
            lastFrameTimestamp = timestamp;

            if (frontendSettings.glbAutorotate && threeViewerState.modelRoot && deltaSeconds > 0) {
                threeViewerState.modelRoot.rotation.y += threeRotationRadiansPerSecond * deltaSeconds;
            }

            threeViewerState.renderer.render(threeViewerState.scene, threeViewerState.camera);
            threeViewerState.animationFrameId = window.requestAnimationFrame(tick);
        };

        if (!threeViewerState.animationFrameId) {
            threeViewerState.animationFrameId = window.requestAnimationFrame(tick);
        }
    };

    const renderGlbWithThree = (container, modelUrl) => {
        if (!window.THREE || !window.THREE.GLTFLoader) {
            return false;
        }

        stopThreeViewer();
        container.classList.add('is-model');
        setHtml(
            container,
            '<div class="vdb-media-model"><div class="vdb-three-host"></div><div class="vdb-model-loading">3D Modell wird geladen</div></div>'
        );

        const host = container.querySelector('.vdb-three-host');
        const loadingInfo = container.querySelector('.vdb-model-loading');
        if (!host) {
            return false;
        }

        const scene = new window.THREE.Scene();
        const camera = new window.THREE.PerspectiveCamera(38, 1, 0.1, 1000);
        camera.position.set(0, 0.95, 3.35);

        const renderer = new window.THREE.WebGLRenderer({
            antialias: true,
            alpha: true,
        });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        host.appendChild(renderer.domElement);

        const ambientLight = new window.THREE.AmbientLight(0xffffff, 1.1);
        const keyLight = new window.THREE.DirectionalLight(0xffffff, 1.3);
        keyLight.position.set(2, 3, 3);
        const fillLight = new window.THREE.DirectionalLight(0xffffff, 0.8);
        fillLight.position.set(-2, 2, -2);

        scene.add(ambientLight, keyLight, fillLight);

        const updateSize = () => {
            const width = Math.max(220, host.clientWidth || 0);
            const height = Math.max(220, host.clientHeight || 0);
            camera.aspect = width / height;
            camera.updateProjectionMatrix();
            renderer.setSize(width, height, false);
        };

        updateSize();
        window.addEventListener('resize', updateSize);

        threeViewerState.renderer = renderer;
        threeViewerState.scene = scene;
        threeViewerState.camera = camera;
        threeViewerState.resizeHandler = updateSize;

        const loader = new window.THREE.GLTFLoader();
        loader.load(
            modelUrl,
            (gltf) => {
                const model = gltf.scene;
                const box = new window.THREE.Box3().setFromObject(model);
                const size = box.getSize(new window.THREE.Vector3()).length() || 1;
                const center = box.getCenter(new window.THREE.Vector3());

                model.position.sub(center);
                model.position.y -= 0.1;
                const scaleFactor = 2.7 / size;
                model.scale.setScalar(scaleFactor);

                scene.add(model);
                threeViewerState.modelRoot = model;
                loadingInfo?.remove();
                startThreeAnimation();
            },
            undefined,
            () => {
                setHtml(container, '<div class="vdb-empty-image">GLB konnte nicht geladen werden</div>');
                container.classList.remove('is-model');
                stopThreeViewer();
            }
        );

        return true;
    };

    const renderGlbWithModelViewer = (container, modelUrl) => {
        if (!window.customElements || !window.customElements.get('model-viewer')) {
            return false;
        }

        container.classList.add('is-model');
        setHtml(
            container,
	            `<div class="vdb-media-model">
	                <model-viewer
	                    src="${escapeHtml(modelUrl)}"
	                    camera-controls
	                    ${frontendSettings.glbAutorotate ? 'auto-rotate' : ''}
	                    touch-action="pan-y"
	                    camera-orbit="32.76deg 74.6deg 70%"
	                    min-camera-orbit="auto auto 40%"
	                    max-camera-orbit="auto auto 180%"
