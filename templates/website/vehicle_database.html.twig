                    }

	                    if (isPerformanceFamily) {
	                        return `<li class="${hasIcon ? 'vdb-option-has-icon' : ''}">${optionNameMarkup}<span class="vdb-option-end">${price}<i class="fa fa-check vdb-option-check" aria-hidden="true"></i></span></li>`;
	                    }

		                    return `<li class="${hasIcon ? 'vdb-option-has-icon' : ''} ${isSelected ? 'is-selected' : ''}" data-vdb-option-id="${escapeHtml(optionId)}" data-vdb-option-name="${escapeHtml(optionName)}" role="button" tabindex="0">${optionNameMarkup}<span class="vdb-catalog-option-end">${price}${optionInfoMarkup}</span></li>`;
	                }).join('');

                    if (isCatalogLight()) {
                        element.optionsList.querySelectorAll('[data-vdb-option-id]').forEach((item) => {
                            const toggleOption = () => {
                                const optionId = String(item.dataset.vdbOptionId || '').trim();
                                const optionName = String(item.dataset.vdbOptionName || '').trim();
                                if (!optionId || !optionName) {
                                    return;
                                }

                                if (selectedCatalogOptions.has(optionId)) {
                                    selectedCatalogOptions.delete(optionId);
                                    item.classList.remove('is-selected');
                                } else {
                                    selectedCatalogOptions.set(optionId, { id: optionId, name: optionName });
                                    item.classList.add('is-selected');
                                }

                                syncWidgetInquiryLink();
                            };

                            item.addEventListener('click', (event) => {
                                if (event.target?.closest?.('.vdb-catalog-option-info')) {
                                    return;
                                }
                                toggleOption();
                            });
                            item.addEventListener('keydown', (event) => {
                                if ('Enter' !== event.key && ' ' !== event.key) {
                                    return;
                                }
                                event.preventDefault();
                                toggleOption();
                            });
                        });
                    }
		            }
	        }

	        if (supportsChartView) {
	            renderPerformanceChart(engine, stage);
	        }

        renderEngineMedia(engine, stage);

        if (stageId) {
            const stageTrackKey = `${engineId || 0}:${stageId}:${activeStageIndex}`;
            if (stageTrackKey !== lastTrackedStageKey) {
                lastTrackedStageKey = stageTrackKey;
                trackEvent('select_stage', {
                    typeId: toId(selectType.value),
                    brandId: toId(selectBrand.value),
                    seriesId: toId(selectSeries.value),
                    modelId: toId(selectModel.value),
                    engineId,
                    stageId,
                });
            }
        }

        if (vehicleWidgetMode) {
            syncWidgetInquiryLink();
        }
    };

	    const renderDetails = (payload, { preferStageId = null, preferEcoStage = false } = {}) => {
	        currentPayload = payload;
            currentRawDetailsPayload = currentRawDetailsPayload || payload;
	        const detailEngine = payload?.engine || {};
	        const stages = getDisplayStages(detailEngine, payload?.stages);
	        const explicitStageId = Number(preferStageId || 0);
	        const desiredStageId = Number.isFinite(explicitStageId) && explicitStageId > 0
	            ? explicitStageId
	            : (Number.isFinite(preselectedStageId) && preselectedStageId > 0 ? preselectedStageId : 0);

	        if (preferEcoStage) {
	            const ecoIndex = stages.findIndex((stage) => true === stage?.isEcoStage || String(stage?.name || '').trim().toLowerCase() === 'eco');
	            activeStageIndex = ecoIndex >= 0 ? ecoIndex : 0;
	        } else if (desiredStageId > 0) {
	            const desiredIndex = stages.findIndex((stage) => Number(stage?.id || 0) === desiredStageId);
	            activeStageIndex = desiredIndex >= 0 ? desiredIndex : 0;
		        } else {
		            activeStageIndex = 0;
		        }

		        performanceOptionsViewActive = false;
		        performanceChartViewActive = false;
		        performanceGearboxViewActive = false;
		        syncPerformanceOptionsView();

		        const engine = payload.engine || {};
		        const brand = payload.brand || {};
		        const series = payload.series || {};
		        renderEngineHeader(engine, brand, series);

	        showResult();
	        renderSelectedStage();
	    };

	    let detailsReloadRequestId = 0;

	    const reloadCurrentEngineDetails = async () => {
	        const engineId = Number(currentPayload?.engine?.id || 0);
	        if (!Number.isFinite(engineId) || engineId <= 0) {
	            return;
	        }

	        const stages = getDisplayStages(currentPayload?.engine || {}, currentPayload?.stages);
	        const activeStage = stages[activeStageIndex] || null;
	        const stageId = Number(activeStage?.id || 0);
	        const preferStageId = Number.isFinite(stageId) && stageId > 0 ? stageId : null;
	        const preferEcoStage = true === activeStage?.isEcoStage || String(activeStage?.name || '').trim().toLowerCase() === 'eco';

	        const requestId = (detailsReloadRequestId += 1);
	        try {
	            const detailsResponse = await fetchJson(`${endpoints.details(engineId)}&noTrack=1`);
                currentRawDetailsPayload = detailsResponse;
	            const details = unwrapApiData(detailsResponse);
	            if (requestId !== detailsReloadRequestId) {
	                return;
	            }

	            renderDetails(details, { preferStageId, preferEcoStage });
	        } catch (error) {
	            // Ignorieren: Anzeige bleibt wie sie ist.
	        }
	    };

    const loadBrandsForSelectedType = async (openBrand = true) => {
        const loaded = await loadIntoSelect(selectBrand, endpoints.brands(selectType.value), 'Bitte wählen');
        if (loaded && openBrand) {
            openSelectForChoice(selectBrand);
        }

        return loaded;
    };

    const loadTypes = async () => {
        try {
            const responsePayload = await fetchJson(endpoints.types());
            const types = unwrapApiData(responsePayload);
            if (!Array.isArray(types)) {
                throw new Error('API-Antwort hat kein gueltiges Listenformat.');
            }

            fillSelect(selectType, types, 'Bitte wählen');
            fixedWidgetTypeId = vehicleWidgetMode && configuredWidgetVehicleTypeId > 0 && types.length === 1
                ? String(types[0]?.id || '')
                : null;
            syncSingleTypeWidgetMode(null !== fixedWidgetTypeId && '' !== fixedWidgetTypeId);

            if (fixedWidgetTypeId) {
                selectType.value = fixedWidgetTypeId;
                selectType.disabled = false;
                syncSelect2(selectType);
                resetSelect(selectBrand, 'Marke wählen');
                resetSelect(selectSeries, 'Bitte erst Marke wählen');
                resetSelect(selectModel, 'Bitte erst Baureihe wählen');
                resetSelect(selectEngine, 'Bitte erst Modell wählen');
                await loadBrandsForSelectedType(false);
            }

            if (apiTesterMode) {
                setApiAuthStatus('Typen geladen.', 'success');
            }
        } catch (error) {
            fixedWidgetTypeId = null;
            syncSingleTypeWidgetMode(false);
            resetSelect(selectType, 'Laden fehlgeschlagen');
            if (apiTesterMode) {
                setApiAuthStatus(error.message || 'Laden fehlgeschlagen.', 'danger');
            }
        }
    };

    const resetAll = async () => {
        if (fixedWidgetTypeId) {
            resetSelect(selectBrand, 'Marke wählen');
        } else {
            resetSelect(selectType, 'Typ wählen');
            resetSelect(selectBrand, 'Bitte erst Typ wählen');
        }
        resetSelect(selectSeries, 'Bitte erst Marke wählen');
        resetSelect(selectModel, 'Bitte erst Baureihe wählen');
        resetSelect(selectEngine, 'Bitte erst Modell wählen');
        hideResult();
        await loadTypes();
    };

    bindSelectChange(selectType, async () => {
        resetSelect(selectBrand, 'Bitte erst Typ wählen');
        resetSelect(selectSeries, 'Bitte erst Marke wählen');
        resetSelect(selectModel, 'Bitte erst Baureihe wählen');
        resetSelect(selectEngine, 'Bitte erst Modell wählen');
        hideResult();

        const typeId = toId(selectType.value);
        trackEvent(typeId ? 'select_type' : 'clear_type', {
            typeId,
        });

        if (!selectType.value) {
            return;
        }

        await loadBrandsForSelectedType(true);
    });

    bindSelectChange(selectBrand, async () => {
        resetSelect(selectSeries, 'Bitte erst Marke wählen');
        resetSelect(selectModel, 'Bitte erst Baureihe wählen');
        resetSelect(selectEngine, 'Bitte erst Modell wählen');
        hideResult();

        const brandId = toId(selectBrand.value);
        trackEvent(brandId ? 'select_brand' : 'clear_brand', {
            typeId: toId(selectType.value),
            brandId,
        });

        if (!selectBrand.value) {
            return;
        }

        const loaded = await loadIntoSelect(selectSeries, endpoints.series(selectBrand.value), 'Bitte wählen');
        if (loaded) {
            openSelectForChoice(selectSeries);
        }
    });

    bindSelectChange(selectSeries, async () => {
        resetSelect(selectModel, 'Bitte erst Baureihe wählen');
        resetSelect(selectEngine, 'Bitte erst Modell wählen');
        hideResult();

        const seriesId = toId(selectSeries.value);
        trackEvent(seriesId ? 'select_series' : 'clear_series', {
            typeId: toId(selectType.value),
            brandId: toId(selectBrand.value),
            seriesId,
        });

        if (!selectSeries.value) {
            return;
        }

        const loaded = await loadIntoSelect(selectModel, endpoints.models(selectSeries.value), 'Bitte wählen');
        if (loaded) {
            openSelectForChoice(selectModel);
        }
    });

    bindSelectChange(selectModel, async () => {
        resetSelect(selectEngine, 'Bitte erst Modell wählen');
        hideResult();

        const modelId = toId(selectModel.value);
        trackEvent(modelId ? 'select_model' : 'clear_model', {
            typeId: toId(selectType.value),
            brandId: toId(selectBrand.value),
            seriesId: toId(selectSeries.value),
            modelId,
        });

        if (!selectModel.value) {
            return;
        }

        const loaded = await loadIntoSelect(selectEngine, endpoints.engines(selectModel.value), 'Bitte wählen');
        if (loaded) {
            openSelectForChoice(selectEngine);
        }
    });

    bindSelectChange(selectEngine, async () => {
        hideResult();
        selectedCatalogOptions.clear();

        const engineId = toId(selectEngine.value);
        trackEvent(engineId ? 'select_engine' : 'clear_engine', {
            typeId: toId(selectType.value),
            brandId: toId(selectBrand.value),
            seriesId: toId(selectSeries.value),
            modelId: toId(selectModel.value),
            engineId,
        });

        if (!selectEngine.value) {
            return;
        }

        try {
            const detailsResponse = await fetchJson(endpoints.details(selectEngine.value));
            currentRawDetailsPayload = detailsResponse;
            const details = unwrapApiData(detailsResponse);
            renderDetails(details);
            if (apiTesterMode) {
                setApiAuthStatus('Motor-Details geladen.', 'success');
            }
        } catch (error) {
            hideResult();
            if (apiTesterMode) {
                setApiAuthStatus(error.message || 'Motor-Details konnten nicht geladen werden.', 'danger');
            }
        }
    });

    resetSelectionBtn.addEventListener('click', async () => {
        trackEvent('reset_filters', {
            typeId: toId(selectType.value),
            brandId: toId(selectBrand.value),
            seriesId: toId(selectSeries.value),
            modelId: toId(selectModel.value),
            engineId: toId(selectEngine.value),
        });
        await resetAll();
    });

    resetSelectionFloatingBtn?.addEventListener('click', async () => {
        trackEvent('reset_filters', {
            typeId: toId(selectType.value),
            brandId: toId(selectBrand.value),
            seriesId: toId(selectSeries.value),
            modelId: toId(selectModel.value),
            engineId: toId(selectEngine.value),
        });
        await resetAll();
    });

    apiAuthLoadBtn?.addEventListener('click', async () => {
        safeStorage.set(apiTokenIdStorageKey, getApiTokenId());
        safeStorage.set(apiTokenStorageKey, getApiToken());

        if (!hasApiCredentials()) {
            setApiAuthStatus('Bitte Token-ID und Bearer-Token vollständig eingeben.', 'danger');
            return;
        }

        setApiAuthStatus('Lade API-Daten...', 'light');
        await resetAll();
    });

    const bootstrap = async () => {
        initLayoutSwitcher();
        initializeApiAuth();
        initializeDataPoolSwitcher();
        initSelect2();
        hideResult();
        trackEvent('page_open', {
            engineId: Number.isFinite(preselectedEngineId) && preselectedEngineId > 0 ? preselectedEngineId : null,
            stageId: Number.isFinite(preselectedStageId) && preselectedStageId > 0 ? preselectedStageId : null,
        });

        if (apiTesterMode && !hasApiCredentials()) {
            resetSelect(selectType, 'Bitte API-Token eingeben');
            resetSelect(selectBrand, 'Bitte erst Typ wählen');
            resetSelect(selectSeries, 'Bitte erst Marke wählen');
            resetSelect(selectModel, 'Bitte erst Baureihe wählen');
            resetSelect(selectEngine, 'Bitte erst Modell wählen');
            return;
        }

        await loadTypes();

        if (Number.isFinite(preselectedEngineId) && preselectedEngineId > 0) {
            try {
                const detailsResponse = await fetchJson(endpoints.details(preselectedEngineId));
                currentRawDetailsPayload = detailsResponse;
                const details = unwrapApiData(detailsResponse);
                renderDetails(details);
            } catch (error) {
                hideResult();
            }
        }
    };

void bootstrap();
})();
</script>
{% if widgetMode %}
    <script>
        (() => {
            const sendWidgetHeight = () => {
                const shell = document.querySelector('.vdb-shell');
                const page = document.querySelector('.vdb-page');
                const root = shell || page || document.body;
                if (!root) {
                    return;
                }

                const rect = root.getBoundingClientRect();
                let dropdownBottom = 0;
                document.querySelectorAll('.select2-container--open .select2-dropdown, .select2-dropdown').forEach((dropdown) => {
                    const dropdownRect = dropdown.getBoundingClientRect();
                    const style = window.getComputedStyle(dropdown);
                    if (style.display === 'none' || style.visibility === 'hidden' || dropdownRect.height <= 0) {
                        return;
                    }

                    dropdownBottom = Math.max(dropdownBottom, Math.ceil(dropdownRect.bottom + window.scrollY));
                });

                const hasOpenDropdown = dropdownBottom > 0;
                const height = Math.max(
                    root.scrollHeight || 0,
                    root.offsetHeight || 0,
                    Math.ceil(rect.bottom + window.scrollY || rect.height || 0),
                    dropdownBottom
                );

                window.parent?.postMessage({
                    type: 'tuningfux-widget-height',
                    height: height + (hasOpenDropdown ? 56 : 16),
                }, '*');
            };

            let resizeFrame = 0;
            const scheduleWidgetHeight = () => {
                window.cancelAnimationFrame(resizeFrame);
                resizeFrame = window.requestAnimationFrame(sendWidgetHeight);
            };

            window.addEventListener('load', scheduleWidgetHeight);
            window.addEventListener('resize', scheduleWidgetHeight);
            window.addEventListener('tuningfux-widget-height-refresh', scheduleWidgetHeight);
            window.addEventListener('message', (event) => {
                if (event.data?.type === 'tuningfux-widget-height-request') {
                    scheduleWidgetHeight();
                }
            });

            if ('ResizeObserver' in window) {
                const observer = new ResizeObserver(scheduleWidgetHeight);
                observer.observe(document.documentElement);
                if (document.body) {
                    observer.observe(document.body);
                }
            }

            if ('MutationObserver' in window && document.body) {
                new MutationObserver(scheduleWidgetHeight).observe(document.body, {
                    attributes: true,
                    childList: true,
                    subtree: true,
                });
            }

            [50, 250, 700, 1400, 2400].forEach((delay) => {
                window.setTimeout(scheduleWidgetHeight, delay);
            });
        })();
    </script>
{% endif %}
{% endblock %}
