	    const toNum = (value) => {
	        const parsed = Number(value);
	        return Number.isFinite(parsed) ? parsed : 0;
	    };

    const isDieselEngine = (engine) => String(engine?.fuel || engine?.antriebsart || '')
        .trim()
        .toLowerCase()
        .includes('diesel');

    const isStageOne = (stage, index = 0) => {
        const name = String(stage?.name || '').trim();
        return /\bstage\s*1\b/i.test(name) || /^stage1\b/i.test(name) || index === 0;
    };

    const buildEcoStage = (stageOne) => {
        const stageOnePs = toNum(stageOne?.hp);
        const stageOneNm = toNum(stageOne?.nm);
        if (stageOnePs <= 0 && stageOneNm <= 0) {
            return null;
        }

        return {
            ...stageOne,
            id: `eco-${stageOne?.id || 'stage-1'}`,
            isEcoStage: true,
            name: 'Eco',
            hp: stageOnePs > 0 ? Math.round(stageOnePs * 0.95) : stageOne?.hp,
            nm: stageOneNm > 0 ? Math.round(stageOneNm * 0.95) : stageOne?.nm,
            price: stageOne?.price ?? null,
            description: stageOne?.description || '',
        };
    };

    const getDisplayStages = (engine, stages) => {
        const list = Array.isArray(stages) ? stages.filter(Boolean) : [];
        if (!isDieselEngine(engine) || list.some((stage) => String(stage?.name || '').trim().toLowerCase() === 'eco')) {
            return list;
        }

        const stageOne = list.find((stage, index) => isStageOne(stage, index));
        const ecoStage = stageOne ? buildEcoStage(stageOne) : null;

        return ecoStage ? [...list, ecoStage] : list;
    };

    const stripEdgeQuotes = (value) => String(value || '')
        .trim()
        .replace(/^[\s"'“”„‚‹›«»]+|[\s"'“”„‚‹›«»]+$/g, '');

    const sanitizePath = (path) => stripEdgeQuotes(path).replace(/^\/+/, '');

    const resolveImageUrl = (path) => {
        const value = stripEdgeQuotes(path);
        if (!value) {
            return '';
        }

        if (/^https?:\/\//i.test(value) || value.startsWith('//')) {
            return value;
        }

        return `/${sanitizePath(value)}`;
    };

    const getStageEcus = (stage, ecus) => {
        if (!stage || !Array.isArray(ecus)) {
            return [];
        }

        if (Array.isArray(stage.ecus) && stage.ecus.length > 0) {
            return stage.ecus;
        }

        const stageEcuId = Number(stage.ecu || 0);
        if (!stageEcuId) {
            return ecus;
        }

        const filtered = ecus.filter((ecu) => Number(ecu.id) === stageEcuId);
        return filtered.length > 0 ? filtered : ecus;
    };

    const renderGearboxes = (gearboxes) => {
        const containers = Array.isArray(element?.gearboxContent) ? element.gearboxContent : [];
        if (containers.length === 0) {
            return;
        }

        const list = Array.isArray(gearboxes) ? gearboxes : [];
        if (list.length === 0) {
            containers.forEach((node) => {
                setHtml(node, '<div class="vdb-gearbox-empty-text">Keine Getriebe hinterlegt.</div>');
            });
            return;
        }

        const html = list.map((gearbox) => {
            const title = escapeHtml(gearbox?.title || gearbox?.name || 'Getriebe');
            const descriptionRaw = String(gearbox?.description || '').trim();
            const description = descriptionRaw
                ? (containsLikelyHtml(descriptionRaw) ? sanitizeDbHtml(descriptionRaw) : escapeHtml(descriptionRaw))
                : 'Keine Beschreibung hinterlegt.';
            const images = Array.isArray(gearbox?.images)
                ? gearbox.images
                : (null != gearbox?.images ? [gearbox.images] : []);
            const imagePath = images
                .map((entry) => String(entry || '').trim())
                .find((entry) => entry.length > 0) || '';
            const imageUrl = resolveImageUrl(imagePath);
            const hasImage = Boolean(imageUrl);
            const iconUrl = resolveImageUrl(gearbox?.icon || '');
            const iconMarkup = iconUrl
                ? `<div class="vdb-gearbox-icon"><img src="${escapeHtml(iconUrl)}" alt="${title}"></div>`
                : `<div class="vdb-gearbox-icon vdb-gearbox-icon--placeholder"><i class="fa fa-cogs" aria-hidden="true"></i></div>`;
            const manufacturerName = String(gearbox?.manufacturer || '').trim();
            const manufacturerLogo = resolveImageUrl(gearbox?.manufacturerLogo || '');
            const manufacturerMarkup = manufacturerName || manufacturerLogo
                ? `<div class="vdb-gearbox-meta-item vdb-gearbox-manufacturer">${manufacturerLogo ? `<img src="${escapeHtml(manufacturerLogo)}" alt="">` : ''}<span>${escapeHtml(manufacturerName || 'Hersteller')}</span></div>`
                : '';
            const typeMarkup = gearbox?.type
                ? `<div class="vdb-gearbox-meta-item vdb-gearbox-type">${escapeHtml(gearbox.type)}</div>`
                : '';
            const metaMarkup = manufacturerMarkup || typeMarkup
                ? `<div class="vdb-gearbox-meta">${manufacturerMarkup}${typeMarkup}</div>`
                : '';

            return `
                <div class="${hasImage ? ' vdb-gearbox-card--with-image' : ''}">
                    <div class="vdb-gearbox-head">
                        ${iconMarkup}
                        <div class="vdb-gearbox-title-wrap">
                            <div class="vdb-gearbox-title">${title}</div>
                        </div>
                    </div>
                    <div class="vdb-gearbox-body pt-3">
                        <div class="vdb-gearbox-text">
                            <div class="vdb-gearbox-description">${description}</div>
                            ${metaMarkup}
                        </div>
                        ${hasImage ? `<div class="vdb-gearbox-media"><img src="${escapeHtml(imageUrl)}" alt="${title}"></div>` : ''}
                    </div>
                </div>
            `;
        }).join('');

        containers.forEach((node) => {
            setHtml(node, html);
        });
    };

    const renderEcuManufacturers = (stageEcus) => {
        if (!element?.ecuManufacturers) {
            return;
        }

        const list = Array.isArray(stageEcus) ? stageEcus : [];
        const seen = new Set();
        const manufacturers = [];

        list.forEach((ecu) => {
            const name = String(ecu?.manufacturer || '').trim();
            const logo = String(ecu?.manufacturerLogo || '').trim();
            if (!name && !logo) {
                return;
            }
            const key = `${name}|${logo}`;
            if (seen.has(key)) {
                return;
            }
            seen.add(key);
            manufacturers.push({ name, logo });
        });

        if (manufacturers.length === 0) {
            element.ecuManufacturers.innerHTML = '';
            element.ecuManufacturers.style.display = 'none';
            return;
        }

        const itemsHtml = manufacturers.map((entry) => {
            const logoUrl = resolveImageUrl(entry.logo || '');
            const logoMarkup = logoUrl
                ? `<img src="${escapeHtml(logoUrl)}" alt="${escapeHtml(entry.name || 'ECU Hersteller')}">`
                : '';
            const label = escapeHtml(entry.name || 'ECU Hersteller');
            return `<div class="vdb-ecu-manufacturer">${logoMarkup}<span>${label}</span></div>`;
        }).join('');

        element.ecuManufacturers.style.display = '';
        element.ecuManufacturers.innerHTML = `
