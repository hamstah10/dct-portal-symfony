	            if (!Array.isArray(items)) {
	                throw new Error('API-Antwort hat kein gueltiges Listenformat.');
	            }

	            fillSelect(select, items, placeholder);
	            if (apiTesterMode) {
	                setApiAuthStatus('Daten erfolgreich geladen.', 'success');
	            }
                return !select.disabled && hasSelectableOptions(select);
	        } catch (error) {
	            resetSelect(select, 'Laden fehlgeschlagen');
