{% extends 'base.html.twig' %}

{% block title %}Chiptuningfile.de{% endblock %}

{% block stylesheets %}
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
        crossorigin="anonymous"
    >
    <style>
        :root {
            --cpt-red: {{ portalConfig is defined and portalConfig ? portalConfig.primaryColor : '#ff0000' }};
            --cpt-black: {{ portalConfig is defined and portalConfig ? portalConfig.secondaryColor : '#000000' }};
            --cpt-soft: #f5f5f5;
            --cpt-page-bg: #0a0a0a;
            --cpt-page-bg-secondary: #111111;
            --cpt-surface: rgba(255, 255, 255, 0.9);
            --cpt-surface-strong: #ffffff;
            --cpt-surface-muted: rgba(255, 255, 255, 0.04);
            --cpt-border: rgba(15, 23, 42, 0.08);
            --cpt-text: #111827;
            --cpt-text-muted: #6b7280;
            --cpt-inverse-text: #ffffff;
            --cpt-inverse-muted: rgba(255, 255, 255, 0.8);
            --cpt-header-bg: rgba(0, 0, 0, 0.86);
            --cpt-footer-bg: #050505;
            --cpt-outline-border: rgba(255, 255, 255, 0.24);
            --cpt-outline-hover-bg: rgba(255, 255, 255, 0.06);
            --cpt-shadow: 0 1.2rem 3rem rgba(15, 23, 42, 0.08);
            --cpt-hero-panel-border: rgba(255, 255, 255, 0.08);
            --cpt-hero-panel-bg:
                linear-gradient(135deg, rgba(255, 0, 0, 0.18), rgba(255, 255, 255, 0.02)),
                rgba(255, 255, 255, 0.04);
            --cpt-stage-border: rgba(255, 255, 255, 0.12);
            --cpt-stage-bg: rgba(255, 255, 255, 0.06);
            --cpt-kicker-bg: rgba(255, 255, 255, 0.08);
            --cpt-kicker-border: rgba(255, 255, 255, 0.12);
        }

        body[data-theme="light"] {
            --cpt-page-bg: #f7f5f1;
            --cpt-page-bg-secondary: #fffaf3;
            --cpt-surface: rgba(255, 255, 255, 0.96);
            --cpt-surface-strong: #ffffff;
            --cpt-surface-muted: rgba(255, 255, 255, 0.82);
            --cpt-border: rgba(15, 23, 42, 0.1);
            --cpt-text: #111827;
            --cpt-text-muted: #5b6474;
            --cpt-inverse-text: #111827;
            --cpt-inverse-muted: rgba(17, 24, 39, 0.74);
            --cpt-header-bg: rgba(255, 255, 255, 0.86);
            --cpt-footer-bg: #f1ece3;
            --cpt-outline-border: rgba(17, 24, 39, 0.18);
            --cpt-outline-hover-bg: rgba(17, 24, 39, 0.04);
            --cpt-shadow: 0 1.2rem 3rem rgba(148, 163, 184, 0.16);
            --cpt-hero-panel-border: rgba(17, 24, 39, 0.08);
            --cpt-hero-panel-bg:
                linear-gradient(135deg, rgba(255, 0, 0, 0.12), rgba(255, 255, 255, 0.9)),
                rgba(255, 255, 255, 0.92);
            --cpt-stage-border: rgba(17, 24, 39, 0.1);
            --cpt-stage-bg: rgba(17, 24, 39, 0.04);
            --cpt-kicker-bg: rgba(255, 255, 255, 0.78);
            --cpt-kicker-border: rgba(17, 24, 39, 0.08);
        }

        body {
            font-family: "Chakra Petch", sans-serif;
            background:
                radial-gradient(circle at top left, rgba(255, 0, 0, 0.08), transparent 28rem),
                linear-gradient(180deg, var(--cpt-page-bg) 0, var(--cpt-page-bg-secondary) 36rem, #fff 36rem, #fff 100%);
            color: var(--cpt-text);
            transition: background 180ms ease, color 180ms ease;
        }

        .cpt-site-header {
            backdrop-filter: blur(18px);
            background: var(--cpt-header-bg);
        }

        .cpt-brand-logo {
            max-height: 3rem;
            width: auto;
        }

        .cpt-hero {
            padding: 7rem 0 5rem;
            color: var(--cpt-inverse-text);
        }

        .cpt-kicker {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.45rem 0.8rem;
            border-radius: 999px;
            background: var(--cpt-kicker-bg);
            border: 1px solid var(--cpt-kicker-border);
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .cpt-hero h1 {
            font-size: clamp(2.8rem, 5vw, 5.4rem);
            line-height: 0.95;
            margin: 1.25rem 0;
        }

        .cpt-hero-copy {
            max-width: 42rem;
            color: var(--cpt-inverse-muted);
            font-size: 1.1rem;
        }

        .cpt-primary-btn {
            background: var(--cpt-red);
            border-color: var(--cpt-red);
            color: #fff;
        }

        .cpt-primary-btn:hover,
        .cpt-primary-btn:focus {
            background: #d40000;
            border-color: #d40000;
            color: #fff;
        }

        .cpt-outline-btn {
            border-color: var(--cpt-outline-border);
            color: var(--cpt-inverse-text);
        }

        .cpt-outline-btn:hover,
        .cpt-outline-btn:focus {
            border-color: currentColor;
            color: var(--cpt-inverse-text);
            background: var(--cpt-outline-hover-bg);
        }

        .cpt-stat-card,
        .cpt-section-card {
            border: 1px solid var(--cpt-border);
            border-radius: 1.5rem;
            background: var(--cpt-surface);
            box-shadow: var(--cpt-shadow);
        }

        .cpt-stat-value {
            font-size: 2rem;
            font-weight: 700;
            color: var(--cpt-black);
        }

        .cpt-section {
            padding: 5rem 0;
        }

        .cpt-section-dark {
            background: var(--cpt-black);
            color: var(--cpt-inverse-text);
        }

        .cpt-section-dark .cpt-section-card {
            background: var(--cpt-surface-muted);
            border-color: var(--cpt-hero-panel-border);
            box-shadow: none;
            color: var(--cpt-inverse-text);
        }

        .cpt-feature-icon {
            width: 3rem;
            height: 3rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 1rem;
            background: rgba(255, 0, 0, 0.12);
            color: var(--cpt-red);
            font-size: 1.4rem;
        }

        .cpt-hero-panel {
            border-radius: 1.75rem;
            border: 1px solid var(--cpt-hero-panel-border);
            background: var(--cpt-hero-panel-bg);
            box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.32);
        }

        .cpt-stage-badge {
            border: 1px solid var(--cpt-stage-border);
            background: var(--cpt-stage-bg);
            border-radius: 999px;
            padding: 0.45rem 0.75rem;
            font-size: 0.875rem;
        }

        .cpt-footer {
            background: var(--cpt-footer-bg);
            color: var(--cpt-text-muted);
        }

        .cpt-theme-toggle {
            border: 1px solid var(--cpt-outline-border);
            background: transparent;
            color: var(--cpt-inverse-text);
            border-radius: 999px;
            padding: 0.55rem 0.9rem;
            line-height: 1;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .cpt-theme-toggle-icon {
            width: 1.1rem;
            height: 1.1rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
        }

        .cpt-theme-toggle-label {
            font-size: 0.875rem;
        }

        .cpt-theme-toggle:hover,
        .cpt-theme-toggle:focus {
            background: var(--cpt-outline-hover-bg);
            color: var(--cpt-inverse-text);
        }

        body[data-theme="light"] .navbar-dark,
        body[data-theme="light"] .navbar-dark .navbar-nav .nav-link,
        body[data-theme="light"] .navbar-dark .navbar-brand,
        body[data-theme="light"] .navbar-dark .navbar-toggler {
            color: var(--cpt-text) !important;
        }

        body[data-theme="light"] .navbar-dark .nav-link {
            opacity: 0.88;
        }

        body[data-theme="light"] .navbar-dark .nav-link:hover,
        body[data-theme="light"] .navbar-dark .nav-link:focus {
            color: var(--cpt-red) !important;
            opacity: 1;
        }

        body[data-theme="light"] .navbar-dark .navbar-toggler {
            border-color: rgba(17, 24, 39, 0.16);
        }

        body[data-theme="light"] .navbar-toggler-icon {
            filter: invert(1);
        }

        body[data-theme="light"] .cpt-section-dark {
            background: linear-gradient(180deg, #fff6f6 0, #f4ede6 100%);
            color: var(--cpt-text);
        }

        body[data-theme="light"] .cpt-section-dark .cpt-section-card,
        body[data-theme="light"] .text-white-50,
        body[data-theme="light"] .text-white {
            color: var(--cpt-text) !important;
        }

        body[data-theme="light"] .text-muted {
            color: var(--cpt-text-muted) !important;
        }

        body[data-theme="light"] .border-danger-subtle {
            border-color: rgba(255, 0, 0, 0.08) !important;
        }
    </style>
{% endblock %}

{% block body %}
    {% set cpt_logo = portalConfig is defined and portalConfig and portalConfig.logoPath ? asset(portalConfig.logoPath) : asset('uploads/firmen/2026-03-04-chiptuningfile-bb8106ecf02baa5d224450a6b8f05d870fd10a72.png') %}
    {% set portal_register_url = path('cpt_portal_register') %}

    <header class="cpt-site-header sticky-top border-bottom border-danger-subtle">
        <nav class="navbar navbar-expand-lg navbar-dark py-3">
            <div class="container">
                <a class="navbar-brand" href="{{ path('cpt_website_home') }}">
                    <img src="{{ cpt_logo }}" alt="Chiptuningfile" class="cpt-brand-logo img-fluid">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#cptWebsiteNav" aria-controls="cptWebsiteNav" aria-expanded="false" aria-label="Navigation umschalten">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="cptWebsiteNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-3">
                        <li class="nav-item"><a class="nav-link" href="#leistungen">Leistungen</a></li>
                        <li class="nav-item"><a class="nav-link" href="#ablauf">Ablauf</a></li>
                        <li class="nav-item"><a class="nav-link" href="#fahrzeugdatenbank">Fahrzeugdatenbank</a></li>
                        <li class="nav-item">
                            <button type="button" class="cpt-theme-toggle" data-cpt-theme-toggle aria-label="Theme wechseln">
                                <span class="cpt-theme-toggle-icon" data-cpt-theme-icon aria-hidden="true">☀</span>
                                <span class="cpt-theme-toggle-label" data-cpt-theme-label>Hell</span>
                            </button>
                        </li>
                        {% if portalConfig is not defined or portalConfig.portalEnabled %}
                            <li class="nav-item"><a class="nav-link" href="{{ portal_register_url }}">Registrieren</a></li>
                            <li class="nav-item"><a class="btn cpt-primary-btn px-4" href="{{ portalUrl }}">Kundenlogin</a></li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    {% block website_body %}{% endblock %}

    <footer class="cpt-footer py-4">
        <div class="container d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2">
            <div>{{ portalConfig is defined and portalConfig ? portalConfig.name : 'Chiptuningfile' }} Test-Website</div>
            <div class="small">Oeffentliche Markenwebsite getrennt vom Kundenportal</div>
        </div>
    </footer>

    <script>
        (function () {
            const storageKey = 'cpt-website-theme';
            const body = document.body;
            const toggle = document.querySelector('[data-cpt-theme-toggle]');
            const toggleIcon = document.querySelector('[data-cpt-theme-icon]');
            const toggleLabel = document.querySelector('[data-cpt-theme-label]');
            const applyTheme = function (theme) {
                body.dataset.theme = theme;
                if (toggle) {
                    if (toggleLabel) {
                        toggleLabel.textContent = theme === 'light' ? 'Dunkel' : 'Hell';
                    }
                    if (toggleIcon) {
                        toggleIcon.textContent = theme === 'light' ? '🌙' : '☀';
                    }
                    toggle.setAttribute('aria-label', 'Zu ' + (theme === 'light' ? 'dunklem' : 'hellem') + ' Theme wechseln');
                }
            };

            const storedTheme = localStorage.getItem(storageKey);
            applyTheme(storedTheme === 'light' ? 'light' : 'dark');

            if (toggle) {
                toggle.addEventListener('click', function () {
                    const nextTheme = body.dataset.theme === 'light' ? 'dark' : 'light';
                    localStorage.setItem(storageKey, nextTheme);
                    applyTheme(nextTheme);
                });
            }
        }());
    </script>
{% endblock %}
