                            const payload = await response.json();
                            renderMenuBadge('.tfd-nav-item--orders', Number.parseInt(String(payload?.orders?.count ?? 0), 10));
                            renderMenuBadge('.tfd-nav-item--communication', Number.parseInt(String(payload?.communication?.count ?? 0), 10));
                            renderMenuBadge('.tfd-nav-item--credits', Number.parseInt(String(payload?.credits?.count ?? 0), 10));
                        } catch (_error) {
                        }
                    };

                    const readCustomerBadgeCount = () => {
                        try {
                            const raw = window.localStorage.getItem(customerBadgeStorageKey);
                            const count = Number.parseInt(String(raw ?? '0'), 10);

                            return Number.isFinite(count) ? Math.max(0, count) : 0;
                        } catch (_error) {
                            return 0;
                        }
                    };

                    const writeCustomerBadgeCount = (count) => {
                        const normalizedCount = Number.isFinite(count) ? Math.max(0, count) : 0;

                        try {
                            if (normalizedCount <= 0) {
                                window.localStorage.removeItem(customerBadgeStorageKey);
                            } else {
                                window.localStorage.setItem(customerBadgeStorageKey, String(normalizedCount));
                            }
                        } catch (_error) {
                        }

                        renderMenuBadge('.tfd-nav-item--customers', normalizedCount);
                    };

                    const incrementCustomerBadgeCount = () => {
                        writeCustomerBadgeCount(readCustomerBadgeCount() + 1);
                    };

                    const resetCustomerBadgeCount = () => {
                        writeCustomerBadgeCount(0);
                    };

                    const bindCustomerBadgeReset = () => {
                        const menuItem = document.querySelector('.tfd-nav-item--customers');
                        if (!(menuItem instanceof HTMLElement) || menuItem.dataset.tfdCustomerBadgeBound === '1') {
                            return;
                        }

                        menuItem.dataset.tfdCustomerBadgeBound = '1';
                        const trigger = menuItem.querySelector('a');
                        if (trigger instanceof HTMLElement) {
                            trigger.addEventListener('click', () => {
                                resetCustomerBadgeCount();
                            });
                        }
                    };

                    const readShopOrderBadgeCount = () => {
                        try {
                            const raw = window.localStorage.getItem(shopOrderBadgeStorageKey);
                            const count = Number.parseInt(String(raw ?? '0'), 10);

                            return Number.isFinite(count) ? Math.max(0, count) : 0;
                        } catch (_error) {
                            return 0;
                        }
                    };

                    const writeShopOrderBadgeCount = (count) => {
                        const normalizedCount = Number.isFinite(count) ? Math.max(0, count) : 0;

                        try {
                            if (normalizedCount <= 0) {
                                window.localStorage.removeItem(shopOrderBadgeStorageKey);
                            } else {
                                window.localStorage.setItem(shopOrderBadgeStorageKey, String(normalizedCount));
                            }
                        } catch (_error) {
                        }

                        renderMenuBadge('.tfd-nav-item--shop-orders', normalizedCount);
                    };

                    const incrementShopOrderBadgeCount = () => {
                        writeShopOrderBadgeCount(readShopOrderBadgeCount() + 1);
                    };

                    const resetShopOrderBadgeCount = () => {
                        writeShopOrderBadgeCount(0);
                    };

                    const bindShopOrderBadgeReset = () => {
                        const menuItem = document.querySelector('.tfd-nav-item--shop-orders');
                        if (!(menuItem instanceof HTMLElement) || menuItem.dataset.tfdShopOrderBadgeBound === '1') {
                            return;
                        }

                        menuItem.dataset.tfdShopOrderBadgeBound = '1';
                        const trigger = menuItem.querySelector('a');
                        if (trigger instanceof HTMLElement) {
                            trigger.addEventListener('click', () => {
                                resetShopOrderBadgeCount();
                            });
                        }
                    };

	                const handlePayload = (payload) => {
                    if (!payload || typeof payload !== 'object') {
                        return;
                    }

                    const summary = String(payload.summary || '').trim();
                    const content = payload.content || {};
                    const body = String(content.body || '').trim();
                    const tag = String(content.tag || '').trim();

                    if (summary === '') {
                        return;
                    }

                    if (tag.startsWith('customer-')) {
                        incrementCustomerBadgeCount();
                    }
                    if (tag.startsWith('shop-order-')) {
                        incrementShopOrderBadgeCount();
                    }

                    showToast(summary, body, tag);
                    showBrowserNotification(summary, content);
                };

                const bindTopic = (topic) => {
                    const url = new URL(hubUrl, window.location.origin);
                    url.searchParams.append('topic', topic);

                    const eventSource = new EventSource(url.toString(), { withCredentials: true });
                    eventSource.addEventListener('message', (event) => {
                        try {
                            handlePayload(JSON.parse(event.data || '{}'));
                        } catch (_error) {
                        }
                    });

                    eventSource.addEventListener('error', () => {
                        console.debug('TFD admin notification stream reconnecting', { topic });
                    });

                    eventSources.push(eventSource);
                };

                const pollNotifications = async () => {
                    try {
                        const isBootstrapPoll = latestSequence === 0;
                        const url = new URL(pollUrl, window.location.origin);
                        url.searchParams.set('after', String(latestSequence));
                        topics.forEach((topic) => url.searchParams.append('topic', topic));

                        const response = await window.fetch(url.toString(), {
                            credentials: 'same-origin',
                            headers: {
                                'Accept': 'application/json',
                            },
                        });

                        if (!response.ok) {
                            return;
                        }

                        const data = await response.json();
                        const events = Array.isArray(data.events) ? data.events : [];
                        const latestFromResponse = Number.parseInt(String(data.latestSequence ?? latestSequence), 10);
                        if (Number.isFinite(latestFromResponse) && latestFromResponse > latestSequence) {
                            latestSequence = latestFromResponse;
                        }

                        if (isBootstrapPoll) {
                            return;
                        }

                        events.forEach((event) => {
                            const eventSequence = Number.parseInt(String(event.sequence ?? 0), 10);
                            if (Number.isFinite(eventSequence) && eventSequence > latestSequence) {
                                latestSequence = eventSequence;
                            }

                            handlePayload(event.payload || null);
                        });
                    } catch (_error) {
                    }
                };

	                // Keep PHP-FPM workers free: polling is enough for admin badges/toasts,
	                // while EventSource streams keep one worker occupied per open tab.
	                pollNotifications();
	                pollTimer = window.setInterval(pollNotifications, 5000);
                    updateNavBadges();
                    navBadgeTimer = window.setInterval(updateNavBadges, 5000);
                    writeCustomerBadgeCount(readCustomerBadgeCount());
                    writeShopOrderBadgeCount(readShopOrderBadgeCount());
                    bindCustomerBadgeReset();
                    bindShopOrderBadgeReset();

	                window.addEventListener('beforeunload', () => {
                    eventSources.forEach((eventSource) => {
                        try {
                            eventSource.close();
                        } catch (_error) {
                        }
                    });
	                    if (pollTimer !== null) {
	                        window.clearInterval(pollTimer);
	                    }
                        if (navBadgeTimer !== null) {
                            window.clearInterval(navBadgeTimer);
                        }
	                }, { once: true });
	            })();
	        </script>
    {% endguard %}
{% endblock %}
