                            }, fadeDurationMs);
                        }, delay);
                    });
                };

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', initFlashToasts, { once: true });
                } else {
                    initFlashToasts();
                }
            })();
        </script>
