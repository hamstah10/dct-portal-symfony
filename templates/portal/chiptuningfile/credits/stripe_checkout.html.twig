{% extends 'portal/chiptuningfile/base.html.twig' %}

{% block title %}Credits kaufen | Chiptuningfile Portal{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-xl-8">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4 p-lg-5">
                        <h1 class="h3 mb-2">Credits kaufen</h1>
                        <p class="text-muted mb-4">Du buchst jetzt {{ package.credits }} Credits für dein Portal-Konto.</p>

                        <div class="row gy-4">
                            <div class="col-md-6">
                                <h5 class="fs-6 text-uppercase text-muted mb-3">Paket</h5>
                                <div class="fs-5 fw-semibold">{{ package.title|default('Credit-Paket') }}</div>
                                <div class="text-muted">{{ package.credits }} Credits</div>
                                <ul class="list-group list-group-flush mt-3">
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>Preis netto</span>
                                        <span>{{ pricing.priceNet|number_format(2, ',', '.') }} €</span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>Preis brutto</span>
                                        <span>{{ pricing.priceGross|number_format(2, ',', '.') }} €</span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>Steuersatz</span>
                                        <span>{{ pricing.taxRate|number_format(2, ',', '.') }} %</span>
                                    </li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h5 class="fs-6 text-uppercase text-muted mb-3">Aktive Zahlungsarten</h5>
                                <ul class="list-group">
                                    {% if paymentMethods.stripe %}
                                        <li class="list-group-item d-flex justify-content-between align-items-start">
                                            <div>
                                                <strong>Stripe</strong>
                                                <div class="text-muted small">Karten sowie Apple Pay & Google Pay</div>
                                            </div>
                                            <span class="badge bg-success">Aktiv</span>
                                        </li>
                                    {% endif %}
                                    {% if paymentMethods.paypal %}
                                        <li class="list-group-item d-flex justify-content-between align-items-start">
                                            <div>
                                                <strong>PayPal</strong>
                                                <div class="text-muted small">Schnell via PayPal-Checkout</div>
                                            </div>
                                            <span class="badge bg-success">Aktiv</span>
                                        </li>
                                    {% endif %}
                                    {% if paymentMethods.prepayment %}
                                        <li class="list-group-item d-flex justify-content-between align-items-start">
                                            <div>
                                                <strong>Vorkasse (Rechnung)</strong>
                                                <div class="text-muted small">Rechnung über das Portal erstellen</div>
                                            </div>
                                            <span class="badge bg-secondary">Optional</span>
                                        </li>
                                    {% endif %}
                                </ul>
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="mb-3">
                            <h5 class="fs-6 text-uppercase text-muted mb-2">Stripe-Zahlung</h5>
                            <p class="text-muted small">Fülle das folgenden Feld aus und bestätige die Zahlung über Stripe.</p>
                            <div id="stripe-payment-element"></div>
                            <div id="stripe-payment-message" class="text-danger small mt-2" role="alert" aria-live="polite"></div>
                        </div>

                        <button id="stripe-pay-button" class="btn btn-primary w-100 py-2">Mit Stripe bezahlen</button>

                        <div class="text-center mt-4">
                            <a href="{{ path('cpt_portal_credits') }}" class="btn btn-link">Zurück zu den Credit-Paketen</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://js.stripe.com/v3/"></script>
    <script>
        (() => {
            const stripe = Stripe('{{ stripePublicKey|e('js') }}');
            const elements = stripe.elements({ clientSecret: '{{ paymentIntent.clientSecret|e('js') }}' });
            const paymentElement = elements.create('payment');
            paymentElement.mount('#stripe-payment-element');

            const payButton = document.getElementById('stripe-pay-button');
            const messageEl = document.getElementById('stripe-payment-message');

            payButton.addEventListener('click', async () => {
                if (payButton.disabled) {
                    return;
                }

                payButton.disabled = true;
                messageEl.textContent = '';

                const { error } = await stripe.confirmPayment({
                    elements,
                    confirmParams: {
                        return_url: '{{ stripeReturnUrl|e('js') }}',
                    },
                    redirect: 'if_required',
                });

                if (error) {
                    messageEl.textContent = error.message || 'Die Stripe-Zahlung konnte nicht abgeschlossen werden.';
                    payButton.disabled = false;
                }
            });
        })();
    </script>
{% endblock %}
