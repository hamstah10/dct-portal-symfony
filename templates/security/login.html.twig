{% extends 'base.html.twig' %}

{% block title %}Login | TFD CRM{% endblock %}

{% block body %}
<div class="container-fluid min-vh-100 d-flex align-items-center bg-body-tertiary">
    <div class="row justify-content-center w-100">
        <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-4 p-lg-5">
                    <div class="text-center mb-4">
                        <img src="{{ asset('images/dct_power.png') }}" alt="DCT Logo" class="img-fluid mb-3" style="max-height: 72px;">
                    </div>

                    {% if error %}
                        <div class="alert alert-danger" role="alert">
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        </div>
                    {% endif %}

                    <form method="post">
                        <div class="mb-3 text-start">
                            <label for="inputEmail" class="form-label">E-Mail</label>
                            <input
                                type="email"
                                value="{{ last_username }}"
                                name="email"
                                id="inputEmail"
                                class="form-control"
                                autocomplete="email"
                                required
                                autofocus
                            >
                        </div>
                        <div class="mb-3 text-start">
                            <label for="inputPassword" class="form-label">Passwort</label>
                            <input
                                type="password"
                                name="password"
                                id="inputPassword"
                                class="form-control"
                                autocomplete="current-password"
                                required
                            >
                        </div>
                        <div class="form-check mb-4">
                            <input class="form-check-input" type="checkbox" value="1" id="remember_me" name="_remember_me">
                            <label class="form-check-label" for="remember_me">
                                Eingeloggt bleiben
                            </label>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <button class="btn btn-dark w-100 py-2" type="submit">
                            Anmelden
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
