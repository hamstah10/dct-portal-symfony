{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Scraper Steuerung{% endblock %}

{% block main %}
<div class="container-fluid px-0">
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div>
                    <div class="fw-semibold">OLSX Scraper</div>
                    <div class="text-muted small">Scraper-Ausgaben werden intern getrennt gespeichert.</div>
                </div>
                {% if latestJson %}
                    <div class="text-end">
                        <div class="small text-muted">Letzte JSON</div>
                        <span>{{ latestJson.name }}</span>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div id="scraper-status-card" class="card border-0 shadow-sm">
        <div class="card-header bg-white fw-semibold">Realtime-Status</div>
        <div class="card-body">
            <div>
                <span class="fw-semibold">Queue:</span>
                <span id="queue-count">—</span>
            </div>
            <div class="mt-1">
                <span class="fw-semibold">Letzter Lauf:</span>
                <span id="latest-run-status">—</span>
            </div>
            <div class="text-muted small mt-1" id="latest-run-meta"></div>
        </div>
    </div>

    {% if errors is not empty %}
        <div class="alert alert-danger">
            <ul class="mb-0">
                {% for error in errors %}
                    <li>{{ error }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold">Spider starten</div>
        <div class="card-body">
            <form method="post" id="scraper-form">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_scraper_control') }}">

                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <label class="form-label">Spider</label>
                        <select name="spider" id="spider-select" class="form-select">
                            <option value="olsx_brands_spider" {{ formData.spider == 'olsx_brands_spider' ? 'selected' : '' }}>olsx_brands_spider (OLSX)</option>
                            <option value="truck_chiptuningfiles" {{ formData.spider == 'truck_chiptuningfiles' ? 'selected' : '' }}>truck_chiptuningfiles</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">Type</label>
                        <select name="type" class="form-select">
                            {% for item in ['car', 'truck', 'moto', 'atv', 'agricultural', 'boat', 'jetski'] %}
                                <option value="{{ item }}" {{ formData.type == item ? 'selected' : '' }}>{{ item }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    {# OLSX-spezifische Felder #}
                    <div class="col-12 col-md-4 fields-olsx">
                        <label class="form-label">Limit Brands</label>
                        <input type="number" min="1" name="limit_brands" value="{{ formData.limit_brands }}" class="form-control" placeholder="z. B. 10">
                    </div>
                    <div class="col-12 col-md-4 fields-olsx">
                        <label class="form-label">Brand Slug</label>
                        <input type="text" name="brand_slug" value="{{ formData.brand_slug }}" class="form-control" placeholder="audi">
                    </div>
                    <div class="col-12 col-md-4 fields-olsx">
                        <label class="form-label">Model Prefixes</label>
                        <input type="text" name="model_prefixes" value="{{ formData.model_prefixes }}" class="form-control" placeholder="rs,s">
                    </div>
                    <div class="col-12 col-md-4 fields-olsx">
                        <label class="form-label">Model Suffixes</label>
                        <input type="text" name="model_suffixes" value="{{ formData.model_suffixes }}" class="form-control" placeholder="m">
                    </div>
                    <div class="col-12 fields-olsx">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="1" id="brands_only" name="brands_only" {{ formData.brands_only ? 'checked' : '' }}>
                            <label class="form-check-label" for="brands_only">Nur Brands crawlen</label>
                        </div>
                    </div>

                    {# truck_chiptuningfiles-spezifische Felder #}
                    <div class="col-12 col-md-4 fields-truck" style="display:none;">
                        <label class="form-label">Modus</label>
                        <select name="mode" class="form-select">
                            <option value="brands:fetch" {{ formData.mode == 'brands:fetch' ? 'selected' : '' }}>brands:fetch – Markenliste holen</option>
                            <option value="brands:scrape-one" {{ formData.mode == 'brands:scrape-one' ? 'selected' : '' }}>brands:scrape-one – Einzelne Marke scrapen</option>
                            <option value="brands:scrape-all-types" {{ formData.mode == 'brands:scrape-all-types' ? 'selected' : '' }}>brands:scrape-all-types – Alle Types scrapen</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-4 fields-truck" style="display:none;">
                        <label class="form-label">Marke (brand)</label>
                        <input type="text" name="brand" value="{{ formData.brand }}" class="form-control" placeholder="DAF">
                        <div class="form-text">Nur bei Modus brands:scrape-one erforderlich.</div>
                    </div>
                </div>

                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Spider starten</button>
                </div>
            </form>
        </div>
    </div>

    {% if result %}
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">Scraperlauf gestartet</div>
            <div class="card-body">
                <p class="mb-2">Der Scraperlauf wurde in die Messenger-Warteschlange gestellt und wird im Hintergrund ausgeführt.</p>
                <div class="mb-2">
                    <div><strong>Command:</strong> <code>{{ result.command }}</code></div>
                    <div>
                        <strong>Transport:</strong> {{ result.transport }}
                        {% if result.messageId %}
                            <span class="text-muted small">({{ result.messageId }})</span>
                        {% endif %}
                    </div>
                </div>
                {% if result.arguments is not empty %}
                    <div class="small text-muted">Parameter:
                        {% for key, value in result.arguments %}
                            <span class="badge rounded-pill bg-light text-body-secondary border">{{ key }}={{ value }}</span>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    {% endif %}

    {% if jsonFiles is not empty %}
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-header bg-white fw-semibold">Generierte JSON-Dateien ({{ jsonFiles|length }})</div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Datum</th>
                                <th>Datei</th>
                                <th class="text-end">Größe</th>
                                <th class="text-end">Vorschau</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for file in jsonFiles %}
                                <tr class="{{ loop.first ? 'table-primary' : '' }}">
                                    <td>{{ file.mtime|date('Y-m-d H:i:s') }}</td>
                                    <td>{{ file.name }}</td>
                                    <td class="text-end">{{ file.size|number_format(0, ',', '.') }} Bytes</td>
                                    <td class="text-end"><span class="text-muted">Über Laufhistorie</span></td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% endif %}

    {% if scraperRuns is not empty %}
        <div class="card border-0 shadow-sm mt-4">
                    <div class="card-header bg-white fw-semibold">Scraper Laufhistorie ({{ scraperRuns|length }})</div>
            <div class="table-responsive">
                <table class="table table-striped table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Datum</th>
                            <th>Spider</th>
                            <th>Type</th>
                            <th>Parameter</th>
                            <th>Status</th>
                            <th>JSON</th>
                            <th class="text-end">Aktion</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for run in scraperRuns %}
                            <tr>
                                <td>{{ run.createdAt|date('Y-m-d H:i:s') }}</td>
                                <td>{{ run.spider }}</td>
                                <td>{{ run.type }}</td>
                                <td><code class="small">{{ run.parameters }}</code></td>
                                <td>
                                    {% set statusState = run.success is same as(null) ? 'warning' : (run.success ? 'success' : 'danger') %}
                                    {% set statusLabel = run.success is same as(null) ? 'In Warteschlange' : (run.success ? 'OK' : 'Fehler') %}
                                    <span class="badge text-bg-{{ statusState }}">
                                        {{ statusLabel }}{{ run.exitCode is not null ? ' (' ~ run.exitCode ~ ')' : '' }}
                                    </span>
                                </td>
                                <td>
                                    {% if run.jsonPath %}
                                        <button class="btn btn-sm btn-outline-primary" type="button" data-run-preview="{{ run.id }}">Vorschau</button>
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                    <div class="small mt-1 text-monospace" id="preview-{{ run.id }}" style="display:none;">
                                        <em>Lädt...</em>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <form method="post" action="{{ path('admin_scraper_control_run_delete', { id: run.id }) }}" onsubmit="return confirm('Diesen Scraperlauf aus der Historie löschen?');" class="d-inline">
                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token(deleteRunCsrfTokenId) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Löschen</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const spiderSelect = document.getElementById('spider-select');
            const olsxFields = document.querySelectorAll('.fields-olsx');
            const truckFields = document.querySelectorAll('.fields-truck');

            function updateSpiderFields() {
                const isTruck = spiderSelect.value === 'truck_chiptuningfiles';
                olsxFields.forEach(el => el.style.display = isTruck ? 'none' : '');
                truckFields.forEach(el => el.style.display = isTruck ? '' : 'none');
            }

            spiderSelect.addEventListener('change', updateSpiderFields);
            updateSpiderFields();

            document.querySelectorAll('[data-run-preview]').forEach(button => {
                button.addEventListener('click', async () => {
                    const runId = button.dataset.runPreview;
                    const target = document.getElementById(`preview-${runId}`);
                    if (!target) return;
                    target.style.display = 'block';
                    if (target.dataset.loaded) return;
                    try {
                        const response = await fetch('{{ path('admin_scraper_control_json', {id: 0}) }}'.replace('/0', `/${runId}`), {
                            headers: { 'Accept': 'application/json' },
                        });
                        if (response.ok) {
                            const text = await response.text();
                            target.textContent = text.substring(0, 1000) + (text.length > 1000 ? '\\n...gekürzt' : '');
                        } else {
                            target.textContent = 'Fehler beim Laden.';
                        }
                    } catch (e) {
                        target.textContent = 'Fehler beim Laden.';
                    }
                    target.dataset.loaded = '1';
                });
            });

            const statusEndpoint = '{{ path('admin_scraper_control_status') }}';
            const queueElement = document.getElementById('queue-count');
            const runStatusElement = document.getElementById('latest-run-status');
            const runMetaElement = document.getElementById('latest-run-meta');

            async function refreshStatus() {
                try {
                    const response = await fetch(statusEndpoint);
                    if (!response.ok) {
                        throw new Error('Status nicht erreichbar');
                    }
                    const data = await response.json();
                    queueElement.textContent = data.queueCount;
                    if (data.latestRun) {
                        const run = data.latestRun;
                        const pendingText = data.runningCount > 0 ? 'Läuft' : 'In Warteschlange';
                        const statusText = run.success === null ? pendingText : (run.success ? 'Erfolgreich' : 'Fehler');
                        runStatusElement.textContent = `${statusText} (${run.spider} / ${run.type})`;
                        runMetaElement.textContent = `ID ${run.id}, Exit ${run.exitCode ?? '—'}, ${new Date(run.createdAt).toLocaleString()}`;
                    } else {
                        runStatusElement.textContent = 'Noch kein Lauf';
                        runMetaElement.textContent = '';
                    }
                } catch (error) {
                    queueElement.textContent = 'Fehler';
                    runStatusElement.textContent = 'Status nicht verfügbar';
                    runMetaElement.textContent = '';
                }
            }

            refreshStatus();
            setInterval(refreshStatus, 5000);
        });
    </script>
</div>
{% endblock %}
