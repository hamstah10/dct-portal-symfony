{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}ECU Intelligence Steuerung{% endblock %}

{% block main %}
<div class="container-fluid px-0">
    {% if result %}
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
                <span>Ergebnis</span>
                <span class="badge {{ result.success ? 'text-bg-success' : 'text-bg-danger' }}">
                    {{ result.success ? 'Erfolgreich' : 'Fehlgeschlagen' }}
                </span>
            </div>
            <div class="card-body">
                {% if result.command %}
                    <div class="small text-muted mb-2"><code>{{ result.command }}</code></div>
                {% endif %}
                <pre class="mb-0 small" style="white-space: pre-wrap;">{{ result.output }}</pre>
            </div>
        </div>
    {% endif %}

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold">Scraper starten</div>
        <div class="card-body">
            <p class="text-muted small">Ruft <code>app:tool-news:run</code> auf und scraped die News-Seite des gewaehlten Anbieters.</p>
            <form method="post" class="row g-3 align-items-end">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_tool_news_control') }}">
                <input type="hidden" name="action" value="run">

                <div class="col-12 col-md-4">
                    <label class="form-label">Anbieter</label>
                    <select name="provider" class="form-select" required>
                        {% for provider in providers %}
                            <option value="{{ provider.slug }}">{{ provider.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label">Jahr (optional)</label>
                    <input type="number" name="year" class="form-control" placeholder="z. B. 2026">
                </div>
                <div class="col-12 col-md-3">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa fa-play"></i> Scraper starten
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold">News importieren</div>
        <div class="card-body">
            <p class="text-muted small">Ruft <code>app:tool-news:import</code> auf und importiert die zuletzt gescrapte JSON-Datei des gewaehlten Anbieters nach Anbieter-News.</p>
            <form method="post" class="row g-3 align-items-end">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_tool_news_control') }}">
                <input type="hidden" name="action" value="import">

                <div class="col-12 col-md-4">
                    <label class="form-label">Anbieter</label>
                    <select name="import_spider" class="form-select" required>
                        {% for provider in providers %}
                            <option value="{{ provider.slug }}_news">{{ provider.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa fa-file-import"></i> Importieren
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold">ECUs analysieren</div>
        <div class="card-body">
            <p class="text-muted small">
                Ruft <code>app:tool-news:analyze --only-new</code> auf und erkennt ECUs, MCUs, Methoden, Protokolle und Fahrzeug-Hinweise in noch nicht analysierten Anbieter-News.
                Aktuell {{ analyzableCount }} noch nicht analysierte(n) News.
            </p>
            <form method="post" class="row g-3 align-items-end">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_tool_news_control') }}">
                <input type="hidden" name="action" value="analyze">

                <div class="col-12 col-md-4">
                    <label class="form-label">Anbieter (optional)</label>
                    <select name="analyze_provider" class="form-select">
                        <option value="">Alle Anbieter</option>
                        {% for provider in providers %}
                            <option value="{{ provider.slug }}">{{ provider.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa fa-magnifying-glass-chart"></i> Analysieren
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
