{% extends embedded|default(false) ? 'admin/support/_embed_base.html.twig' : '@EasyAdmin/page/content.html.twig' %}

{% block configured_head_contents %}
    {{ parent() }}
    <style>
        .tfd-support-email .tfd-mail-layout {
            margin: 0;
        }

        .tfd-support-email .card {
            border: 1px solid #d8e0e8 !important;
            box-shadow: none !important;
            border-radius: 6px !important;
        }

        .tfd-support-email .tfd-mail-sidebar-card .list-group-item {
            border: 0;
            border-bottom: 1px solid #e1e7ef;
            background: transparent;
            padding: 0.58rem 0.75rem;
        }

        .tfd-support-email .tfd-mail-sidebar-card .list-group-item:first-child {
            border-top: 1px solid #e1e7ef;
        }

        .tfd-support-email .tfd-mail-sidebar-card .list-group-item.active {
            background: rgba(0, 0, 0, 0.05);
        }

        .tfd-support-email .tfd-folder-badge {
            min-width: 28px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            padding: 0.1rem 0.35rem;
            font-size: 0.68rem;
            font-weight: 700;
            background: #d3dae4;
            color: #4f6078;
        }

        .tfd-support-email .tfd-mail-main {
            display: flex;
            flex-direction: column;
            gap: 12px;
            min-width: 0;
        }

        .tfd-support-email .tfd-mail-toolbar {
            border-bottom: 1px solid #e6eaf0;
            padding-bottom: 0.75rem;
            margin-bottom: 0.75rem;
        }

        .tfd-support-email .tfd-mail-toolbar .input-group-text,
        .tfd-support-email .tfd-mail-toolbar .form-control,
        .tfd-support-email .tfd-mail-toolbar .btn {
            min-height: 40px;
        }

        .tfd-support-email .tfd-compose-btn,
        .tfd-support-email .tfd-search-btn {
            min-height: 42px;
            padding-inline: 1rem;
            border-radius: 4px;
            font-weight: 600;
        }

        .tfd-support-email .tfd-mail-bulk-select {
            min-width: 220px;
        }

        .tfd-support-email .tfd-mail-content {
            display: grid;
            grid-template-columns: minmax(320px, 34%) minmax(0, 1fr);
            gap: 12px;
            min-height: 0;
        }

        .tfd-support-email .tfd-mail-content > .card {
            min-height: 72vh;
        }

        .tfd-support-email .tfd-mail-list-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.9rem;
            padding: 0.8rem 0.95rem;
            border-bottom: 1px solid #dbe2eb;
            font-size: 1.08rem;
            font-weight: 700;
        }

        .tfd-support-email .tfd-mail-list-head-left {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
        }

        .tfd-support-email .tfd-mail-list-head-right {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .tfd-support-email .tfd-mail-list {
            max-height: 68vh;
            overflow: auto;
            border-top: 0;
        }

        .tfd-support-email .tfd-mail-row {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr) auto;
            gap: 12px;
            align-items: center;
            border-bottom: 1px solid #dce3eb;
            padding: 0.85rem 0.75rem;
            transition: background 0.14s ease;
        }

        .tfd-support-email .tfd-mail-row:hover {
            background: rgba(0, 0, 0, 0.03);
        }

        .tfd-support-email .tfd-mail-row.is-active {
            background: rgba(0, 0, 0, 0.05);
        }

        .tfd-support-email .tfd-mail-row-controls {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .tfd-support-email .tfd-mail-select-item {
            margin-right: 0;
        }

        .tfd-support-email .tfd-mail-avatar {
            width: 38px;
            height: 38px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.76rem;
            font-weight: 700;
            color: #5e6e84;
            background: #d2d9e3;
            text-transform: uppercase;
        }

        .tfd-support-email .tfd-mail-row-link {
            color: inherit;
            text-decoration: none;
            min-width: 0;
            display: block;
        }

        .tfd-support-email .tfd-mail-row-link:hover {
            color: inherit;
            text-decoration: none;
        }

        .tfd-support-email .tfd-mail-row-sender {
            font-size: 1rem;
            font-weight: 700;
            line-height: 1.15;
            margin-bottom: 0.15rem;
        }

        .tfd-support-email .tfd-mail-row.is-unread .tfd-mail-row-sender,
        .tfd-support-email .tfd-mail-row.is-unread .tfd-mail-row-subject {
            font-weight: 700;
        }

        .tfd-support-email .tfd-mail-row-subject {
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 0.1rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .tfd-support-email .tfd-mail-row-preview {
            font-size: 0.92rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            opacity: 0.85;
        }

        .tfd-support-email .tfd-mail-row-meta {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            justify-content: center;
            min-width: 134px;
            gap: 0.35rem;
            padding-left: 0.4rem;
        }

        .tfd-support-email .tfd-mail-row-date {
            font-size: 0.8rem;
            white-space: nowrap;
            text-align: right;
            opacity: 0.8;
        }

        .tfd-support-email .tfd-mail-star-btn {
            border: 0;
            background: transparent;
            color: inherit;
            font-size: 0.9rem;
            line-height: 1;
            padding: 0.1rem 0;
            opacity: 0.75;
        }

        .tfd-support-email .tfd-mail-detail-body {
            max-height: 72vh;
            overflow: auto;
        }

        .tfd-support-email .tfd-mail-message-content {
            font-size: 0.92rem;
            line-height: 1.45;
            white-space: pre-wrap;
            border: 1px solid #e6eaf0;
            padding: 0.75rem;
        }

        .tfd-support-email .tfd-mail-message-content--html {
            background: #fff;
            padding: 0;
            white-space: normal;
            overflow: hidden;
        }

        .tfd-support-email .tfd-mail-html-frame {
            width: 100%;
            min-height: 72vh;
            border: 0;
            background: #fff;
            display: block;
        }

        .tfd-support-email .tfd-mail-label-chip {
            display: inline-block;
            padding: 0.1rem 0.45rem;
            border: 1px solid #d4dce6;
            border-radius: 4px;
            font-size: 0.68rem;
            margin-right: 0.3rem;
            margin-top: 0.2rem;
            color: inherit;
            background: transparent;
        }

        .tfd-support-email .tfd-mail-compose-card textarea,
        .tfd-support-email .tfd-mail-detail-body textarea {
            min-height: 125px;
        }

        .tfd-support-email .tfd-mail-online-item {
            display: flex;
            align-items: center;
            gap: 0.55rem;
            padding: 0.32rem 0;
            font-size: 0.86rem;
        }

        .tfd-support-email .tfd-mail-online-dot {
            width: 7px;
            height: 7px;
            border-radius: 999px;
            background: #9aa9bc;
            flex-shrink: 0;
        }

        .tfd-support-email .tfd-mail-settings-link {
            font-size: 0.9rem;
            text-decoration: none;
            color: inherit;
        }

        @media (max-width: 1199.98px) {
            .tfd-support-email .tfd-mail-content {
                grid-template-columns: minmax(0, 1fr);
            }

            .tfd-support-email .tfd-mail-content > .card {
                min-height: 0;
            }

            .tfd-support-email .tfd-mail-list,
            .tfd-support-email .tfd-mail-detail-body {
                max-height: none;
            }
        }

        @media (max-width: 991.98px) {
            .tfd-support-email .tfd-mail-row {
                grid-template-columns: auto minmax(0, 1fr);
            }

            .tfd-support-email .tfd-mail-row-meta {
                grid-column: 2;
                flex-direction: row;
                align-items: center;
                justify-content: space-between;
                min-width: 0;
                padding-left: 0;
            }
        }
    </style>
{% endblock %}

{% block content_title %}Support / E-Mail{% endblock %}

{% block main %}
    {% set composeMode = app.request.query.get('compose') == '1' %}
    {% set accountId = selectedAccount and selectedAccount.id ? selectedAccount.id : 0 %}
    {% set selectedMessageId = selectedMessage and selectedMessage.id ? selectedMessage.id : 0 %}
    {% set baseQuery = {
        'account': accountId,
        'folder': folderFilter,
        'q': searchQuery,
        'unread': unreadOnly ? 1 : 0,
        'starred': starredOnly ? 1 : 0
    } %}
    {% set viewQuery = baseQuery %}
    {% if selectedMessageId > 0 %}
        {% set viewQuery = viewQuery|merge({'message': selectedMessageId}) %}
    {% endif %}

    {% set folderLabels = {
        'all': 'Alle',
        'inbox': 'Posteingang',
        'sent': 'Gesendet',
        'draft': 'Entwurf',
        'spam': 'Spam',
        'trash': 'Papierkorb',
        'archive': 'Archiv'
    } %}
    {% set allFolderCount = 0 %}
    {% for count in folderStats %}
        {% set allFolderCount = allFolderCount + count %}
    {% endfor %}

    <div class="container-fluid px-0 tfd-support-email">
        {% if accounts is empty %}
            <div class="alert alert-warning mb-3">
                Kein aktives E-Mail-Konto gefunden.
                <a href="{{ path('admin_email_konto_index') }}" class="alert-link">E-Mail-Konten verwalten</a>.
            </div>
        {% else %}
            <div class="mb-3">
                {{ component('support_email_search', { accountId: accountId, folder: folderFilter }) }}
            </div>
            <div class="row">
                <div class="col-6">
                    <a href="{{ path('admin_support_email', baseQuery|merge({'compose': 1})) }}"
                               class="btn btn-primary tfd-compose-btn">
                                <i class="fa fa-plus-circle me-1"></i> E-Mail verfassen
                            </a>
                </div>
            </div>
            <div class="row g-3 tfd-mail-layout">
                <datalist id="supportEmailRecipientList">
                    {% for recipient in recipientSuggestions|default([]) %}
                        <option value="{{ recipient.email }}">{{ recipient.label }}</option>
                    {% endfor %}
                </datalist>

                <aside class="col-12 col-xl-2">
                    <div class="card border-0 shadow-sm tfd-mail-sidebar-card">
                        

                        {% if accounts|length > 1 %}
                            <div class="px-3 pb-3">
                                <form method="get" action="{{ path('admin_support_email') }}">
                                    <input type="hidden" name="folder" value="{{ folderFilter }}">
                                    <input type="hidden" name="q" value="{{ searchQuery }}">
                                    <input type="hidden" name="unread" value="{{ unreadOnly ? 1 : 0 }}">
                                    <input type="hidden" name="starred" value="{{ starredOnly ? 1 : 0 }}">
                                    <select name="account" class="form-select form-select-sm" onchange="this.form.submit()">
                                        {% for account in accounts %}
                                            <option value="{{ account.id }}"
                                                    {{ selectedAccount and selectedAccount.id == account.id ? 'selected' : '' }}>
                                                {{ account.name }} ({{ account.emailAddress }})
                                            </option>
                                        {% endfor %}
                                    </select>
                                </form>
                            </div>
                        {% endif %}

                        <div class="px-3 pb-1 small fw-semibold text-uppercase text-muted pt-3 pb-3">Postfächer</div>
                        <div class="list-group list-group-flush">
                            {% set allParams = baseQuery|merge({'folder': 'all'}) %}
                            <a href="{{ path('admin_support_email', allParams) }}"
                               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center {{ folderFilter == 'all' ? 'active' : '' }}">
                                <span><i class="fa fa-inbox me-2"></i>Alle</span>
                                <span class="tfd-folder-badge tfd-folder-badge--all">{{ allFolderCount }}</span>
                            </a>
                            {% for label, value in folderChoices %}
                                {% set folderParams = baseQuery|merge({'folder': value}) %}
                                <a href="{{ path('admin_support_email', folderParams) }}"
                                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center {{ folderFilter == value ? 'active' : '' }}">
                                    <span>
                                        {% if value == 'inbox' %}
                                            <i class="fa fa-envelope-open me-2"></i>
                                        {% elseif value == 'sent' %}
                                            <i class="fa fa-paper-plane me-2"></i>
                                        {% elseif value == 'draft' %}
                                            <i class="fa fa-file-text-o me-2"></i>
                                        {% elseif value == 'spam' %}
                                            <i class="fa fa-exclamation-circle me-2"></i>
                                        {% elseif value == 'trash' %}
                                            <i class="fa fa-trash me-2"></i>
                                        {% else %}
                                            <i class="fa fa-archive me-2"></i>
                                        {% endif %}
                                        {{ folderLabels[value]|default(label) }}
                                    </span>
                                    <span class="tfd-folder-badge tfd-folder-badge--{{ value }}">{{ folderStats[value]|default(0) }}</span>
                                </a>
                            {% endfor %}
                        </div>

                        <div class="px-3 pt-3 pb-1 small fw-semibold text-uppercase text-muted">Labels</div>
                        <div class="px-3 pb-3">
                            {% for label, count in labelStats %}
                                <div class="d-flex justify-content-between align-items-center border-bottom py-1 small">
                                    <span>{{ label }}</span>
                                    <span class="text-muted">{{ count }}</span>
                                </div>
                            {% endfor %}
                        </div>

                       

                        <div class="px-3 pt-2 pb-3 small fw-semibold text-uppercase text-muted">Einstellungen</div>
                        <div class="px-3 pb-3">
                            <a href="{{ path('admin_email_konto_index') }} " class="tfd-mail-settings-link">
                                <i class="fa fa-gear me-1"></i> Einstellungen
                            </a>
                        </div>
                    </div>
                </aside>

                <section class="col-12 col-xl-10 tfd-mail-main">
                    {% if composeMode %}
                        <div class="card border-0 shadow-sm tfd-mail-compose-card">
                            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                                <strong>Neue E-Mail</strong>
                                <a href="{{ path('admin_support_email', viewQuery) }}" class="btn btn-secondary btn-sm">
                                    <i class="fa fa-times me-1"></i> Schließen
                                </a>
                            </div>
                            <div class="card-body">
                                <form method="post" action="{{ path('admin_support_email_compose') }}" class="row g-2">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_support_email_compose') }}">
                                    <input type="hidden" name="accountId" value="{{ accountId }}">

                                    <div class="col-12">
                                        <input type="text"
                                               name="toEmail"
                                               class="form-control"
                                               list="supportEmailRecipientList"
                                               autocomplete="off"
                                               placeholder="An (E-Mail-Adresse)">
                                    </div>
                                    <div class="col-12">
                                        <input type="text" name="subject" class="form-control" placeholder="Betreff">
                                    </div>
                                    <div class="col-12">
                                        <textarea name="body" class="form-control" rows="6" placeholder="Nachricht"></textarea>
                                    </div>
                                    <div class="col-12 d-flex gap-2">
                                        <button type="submit" name="sendNow" value="1" class="btn btn-primary">
                                            <i class="fa fa-paper-plane me-1"></i> Senden
                                        </button>
                                        <button type="submit" name="sendNow" value="0" class="btn btn-secondary">
                                            <i class="fa fa-save me-1"></i> Entwurf speichern
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    {% endif %}

                    <div class="card border-0 shadow-sm">
                        <div class="card-body pb-1">
                            <form method="get" action="{{ path('admin_support_email') }}" class="tfd-mail-toolbar">
                                <input type="hidden" name="account" value="{{ accountId }}">
                                <input type="hidden" name="folder" value="{{ folderFilter }}">

                                <div class="row g-2 align-items-center d-none">
                                    <div class="col-12 col-xl-8">
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="fa fa-search"></i></span>
                                            <input type="search"
                                                   class="form-control"
                                                   name="q"
                                                   value="{{ searchQuery }}"
                                                   placeholder="E-Mail suchen">
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3 col-xl-2">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="mailUnreadOnly" name="unread" value="1" {{ unreadOnly ? 'checked' : '' }}>
                                            <label class="form-check-label small" for="mailUnreadOnly">Nur ungelesen</label>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3 col-xl-1">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="mailStarredOnly" name="starred" value="1" {{ starredOnly ? 'checked' : '' }}>
                                            <label class="form-check-label small" for="mailStarredOnly">Nur markiert</label>
                                        </div>
                                    </div>
                                    <div class="col-12 col-xl-1">
                                        <button type="submit" class="btn btn-tuningfux">Suchen</button>
                                    </div>
                                </div>
                            </form>

                            <form method="post" action="{{ path('admin_support_email_bulk') }}" id="mailBulkActionForm" class="d-none">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin_support_email_bulk') }}">
                                <input type="hidden" name="account" value="{{ accountId }}">
                                <input type="hidden" name="folder" value="{{ folderFilter }}">
                                <input type="hidden" name="q" value="{{ searchQuery }}">
                                <input type="hidden" name="unread" value="{{ unreadOnly ? 1 : 0 }}">
                                <input type="hidden" name="starred" value="{{ starredOnly ? 1 : 0 }}">
                                <input type="hidden" name="selectedMessage" value="{{ selectedMessageId }}">
                            </form>

                            <div class="d-flex justify-content-between align-items-center small text-muted mb-1">
                               
                                <div class="row">
                                        <div class="col-2">
                                            <div class="form-check m-0">
                                                <input class="form-check-input" type="checkbox" id="mailBulkSelectAll">
                                                <label class="form-check-label" for="mailBulkSelectAll">Alle</label>
                                            </div>
                                        </div>
                                        <div class="col-3">
                                            <select class="form-select tfd-mail-bulk-select" name="bulkAction" id="mailBulkActionSelect" form="mailBulkActionForm">
                                                <option value="">Aktion auswählen</option>
                                                <option value="mark_read">Status: Gelesen</option>
                                                <option value="mark_unread">Status: Ungelesen</option>
                                                <option value="star">Status: Markiert</option>
                                                <option value="unstar">Status: Markierung entfernen</option>
                                                <option value="delete">Löschen</option>
                                            </select>
                                        </div>
                                        <div class="col-3">
                                            <button type="submit" class="btn btn-tuningfux" form="mailBulkActionForm" id="mailBulkSubmitBtn">
                                                Ausführen
                                            </button>
                                        </div>
                                        <div class="col-3">
                                            <a href="{{ path('admin_support_email', viewQuery) }}" class="text-decoration-none">
                                                <i class="fa fa-refresh me-1"></i> Zuletzt aktualisiert {{ "now"|date('H:i') }}
                                            </a>
                                        </div>
                                    {% if accounts|length > 1 %}
                                        <form method="post" action="{{ path('admin_support_email_fetch') }}" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('admin_support_email_fetch') }}">
                                            <input type="hidden" name="accountId" value="0">
                                            <input type="hidden" name="folder" value="{{ folderFilter }}">
                                            <input type="hidden" name="q" value="{{ searchQuery }}">
                                            <input type="hidden" name="unread" value="{{ unreadOnly ? 1 : 0 }}">
                                            <input type="hidden" name="starred" value="{{ starredOnly ? 1 : 0 }}">
                                            <input type="hidden" name="selectedMessage" value="{{ selectedMessageId }}">
                                            <input type="hidden" name="limit" value="100">
                                            <button type="submit" class="btn btn-secondary btn-sm">
                                                <i class="fa fa-cloud-download me-1"></i> Alle Konten
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                                
                                <div>
                                    Anzeige {{ messages is empty ? 0 : 1 }} - {{ messages|length }} von {{ messages|length }}
                                </div>
                            </div>
                        </div>

                        <div class="tfd-mail-content px-3 pb-3">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body p-0">
                                    <div class="tfd-mail-list">
                                        <div class="tfd-mail-list-head">
                                            <div class="tfd-mail-list-head-left">
                                                <input class="form-check-input" type="checkbox" id="mailListHeaderSelect">
                                                <span>Alle E-Mails</span>
                                            </div>
                                            <div class="tfd-mail-list-head-right">
                                                <form method="post" action="{{ path('admin_support_email_fetch') }}" class="d-inline">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_support_email_fetch') }}">
                                                    <input type="hidden" name="accountId" value="{{ accountId }}">
                                                    <input type="hidden" name="folder" value="{{ folderFilter }}">
                                                    <input type="hidden" name="q" value="{{ searchQuery }}">
                                                    <input type="hidden" name="unread" value="{{ unreadOnly ? 1 : 0 }}">
                                                    <input type="hidden" name="starred" value="{{ starredOnly ? 1 : 0 }}">
                                                    <input type="hidden" name="selectedMessage" value="{{ selectedMessageId }}">
                                                    <input type="hidden" name="limit" value="100">
                                                    <button type="submit" class="btn btn-tuningfux">
                                                        <i class="fa fa-download me-1"></i> Konto abrufen
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                        {% if messages is empty %}
                                            <div class="p-3 text-muted">Keine E-Mails für diesen Filter gefunden.</div>
                                        {% else %}
                                            {% for message in messages %}
                                                {% set messageDate = message.receivedAt ?: message.sentAt ?: message.createdAt %}
                                                {% set sender = message.fromName ?: message.fromEmail ?: message.toEmail ?: '-' %}
                                                {% set senderInitial = sender|trim|slice(0, 1)|upper %}
                                                {% set previewText = message.bodyText|default('')|striptags|replace({"\n": " ", "\r": " "})|trim %}
                                                {% set rowParams = baseQuery|merge({'message': message.id}) %}
                                                {% set isSelected = selectedMessage and selectedMessage.id == message.id %}

                                                <div class="tfd-mail-row {{ isSelected ? 'is-active' : '' }} {{ not message.isRead ? 'is-unread' : '' }}">
                                                    <div class="tfd-mail-row-controls">
                                                        <input class="form-check-input tfd-mail-select-item"
                                                               type="checkbox"
                                                               name="messageIds[]"
                                                               value="{{ message.id }}"
                                                               form="mailBulkActionForm"
                                                               aria-label="E-Mail auswählen">
                                                        <span class="tfd-mail-avatar">{{ senderInitial is empty ? '?' : senderInitial }}</span>
                                                    </div>

                                                    <a href="{{ path('admin_support_email', rowParams) }}" class="tfd-mail-row-link">
                                                        <div class="tfd-mail-row-sender text-truncate">{{ sender }}</div>
                                                        <div class="tfd-mail-row-subject">{{ message.subject ?: '(Ohne Betreff)' }}</div>
                                                        <div class="tfd-mail-row-preview">
                                                            {{ previewText|length > 170 ? previewText|slice(0, 170) ~ '...' : previewText }}
                                                        </div>
                                                        {% if message.labels %}
                                                            <div class="mt-1">
                                                                {% for label in message.labels %}
                                                                    <span class="tfd-mail-label-chip">{{ label }}</span>
                                                                {% endfor %}
                                                            </div>
                                                        {% endif %}
                                                    </a>

                                                    <div class="tfd-mail-row-meta">
                                                        <div class="tfd-mail-row-date">{{ messageDate ? messageDate|date('d.m.Y, H:i') : '-' }}</div>
                                                        <form method="post" action="{{ path('admin_support_email_toggle_star') }}">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('admin_support_email_toggle_star') }}">
                                                            <input type="hidden" name="messageId" value="{{ message.id }}">
                                                            <input type="hidden" name="account" value="{{ accountId }}">
                                                            <input type="hidden" name="folder" value="{{ folderFilter }}">
                                                            <input type="hidden" name="q" value="{{ searchQuery }}">
                                                            <input type="hidden" name="unread" value="{{ unreadOnly ? 1 : 0 }}">
                                                            <input type="hidden" name="starred" value="{{ starredOnly ? 1 : 0 }}">
                                                            <input type="hidden" name="selectedMessage" value="{{ isSelected ? message.id : selectedMessageId }}">
                                                            <button type="submit" class="tfd-mail-star-btn {{ message.isStarred ? 'is-starred' : '' }}" title="{{ message.isStarred ? 'Stern entfernen' : 'Mit Stern markieren' }}">
                                                                <i class="fa {{ message.isStarred ? 'fa-star' : 'fa-star-o' }}"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        {% endif %}
                                    </div>
                                </div>
                            </div>

                            <div class="card border-0 shadow-sm">
                                {% if selectedMessage %}
                                    {% set selectedDate = selectedMessage.receivedAt ?: selectedMessage.sentAt ?: selectedMessage.createdAt %}
                                    {% set labelsString = selectedMessage.labels ? selectedMessage.labels|join(', ') : '' %}
                                    {% set defaultReplySubject = selectedMessage.subject|lower starts with 're:' ? selectedMessage.subject : 'Re: ' ~ selectedMessage.subject %}
                                    {% set htmlBody = selectedMessage.bodyHtml|default('')|trim %}

                                    <div class="card-header bg-white">
                                        <div class="small text-muted">{{ folderLabels[selectedMessage.folder]|default(selectedMessage.folder) }}</div>
                                        <div class="fw-semibold">{{ selectedMessage.subject ?: '(Ohne Betreff)' }}</div>
                                        <div class="small text-muted">
                                            Von: {{ selectedMessage.fromName ?: '-' }} &lt;{{ selectedMessage.fromEmail ?: '-' }}&gt;
                                            <span class="mx-1">|</span>
                                            Am: {{ selectedDate ? selectedDate|date('d.m.Y H:i') : '-' }}
                                        </div>
                                    </div>

                                    <div class="card-body tfd-mail-detail-body">
                                        <div class="row g-2 mb-2 small">
                                            <div class="col-12"><strong>An:</strong> {{ selectedMessage.toEmail ?: '-' }}</div>
                                        </div>

                                        {% if htmlBody is not empty %}
                                            <div class="tfd-mail-message-content tfd-mail-message-content--html mb-3">
                                                <iframe
                                                    class="tfd-mail-html-frame"
                                                    sandbox="allow-popups allow-popups-to-escape-sandbox allow-forms"
                                                    referrerpolicy="no-referrer"
                                                    srcdoc="{{ htmlBody|e('html_attr') }}"
                                                ></iframe>
                                            </div>
                                        {% else %}
                                            <div class="tfd-mail-message-content mb-3">{{ selectedMessage.bodyText|default('') }}</div>
                                        {% endif %}

                                        <div class="accordion" id="supportEmailActions">
                                            <div class="accordion-item">
                                                <h2 class="accordion-header" id="supportEmailReplyHeading">
                                                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#supportEmailReplyPane" aria-expanded="true" aria-controls="supportEmailReplyPane">
                                                        Antworten
                                                    </button>
                                                </h2>
                                                <div id="supportEmailReplyPane" class="accordion-collapse collapse show" aria-labelledby="supportEmailReplyHeading" data-bs-parent="#supportEmailActions">
                                                    <div class="accordion-body">
                                                        <form method="post" action="{{ path('admin_support_email_reply') }}" class="row g-2">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('admin_support_email_reply') }}">
                                                            <input type="hidden" name="messageId" value="{{ selectedMessage.id }}">
                                                            <input type="hidden" name="accountId" value="{{ accountId }}">
                                                            <input type="hidden" name="account" value="{{ accountId }}">
                                                            <input type="hidden" name="folder" value="{{ folderFilter }}">
                                                            <input type="hidden" name="q" value="{{ searchQuery }}">
                                                            <input type="hidden" name="unread" value="{{ unreadOnly ? 1 : 0 }}">
                                                            <input type="hidden" name="starred" value="{{ starredOnly ? 1 : 0 }}">

                                                            <div class="col-12">
                                                                <input type="text"
                                                                       name="toEmail"
                                                                       class="form-control"
                                                                       list="supportEmailRecipientList"
                                                                       autocomplete="off"
                                                                       value="{{ selectedMessage.fromEmail ?: '' }}"
                                                                       placeholder="Empfänger">
                                                            </div>
                                                            <div class="col-12">
                                                                <input type="text" name="subject" class="form-control" value="{{ defaultReplySubject }}">
                                                            </div>
                                                            <div class="col-12">
                                                                <textarea name="replyBody" class="form-control" rows="6" placeholder="Antwort">{{ "\n\n--- Ursprüngliche Nachricht ---\n" ~ selectedMessage.bodyText }}</textarea>
                                                            </div>
                                                            <div class="col-12">
                                                                <button type="submit" class="btn btn-primary">
                                                                    <i class="fa fa-paper-plane me-1"></i> Antwort speichern
                                                                </button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="accordion-item">
                                                <h2 class="accordion-header" id="supportEmailEditHeading">
                                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#supportEmailEditPane" aria-expanded="false" aria-controls="supportEmailEditPane">
                                                        E-Mail bearbeiten
                                                    </button>
                                                </h2>
                                                <div id="supportEmailEditPane" class="accordion-collapse collapse" aria-labelledby="supportEmailEditHeading" data-bs-parent="#supportEmailActions">
                                                    <div class="accordion-body">
                                                        <form method="post" action="{{ path('admin_support_email_update') }}" class="row g-2">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('admin_support_email_update') }}">
                                                            <input type="hidden" name="messageId" value="{{ selectedMessage.id }}">
                                                            <input type="hidden" name="account" value="{{ accountId }}">
                                                            <input type="hidden" name="folder" value="{{ folderFilter }}">
                                                            <input type="hidden" name="q" value="{{ searchQuery }}">
                                                            <input type="hidden" name="unread" value="{{ unreadOnly ? 1 : 0 }}">
                                                            <input type="hidden" name="starred" value="{{ starredOnly ? 1 : 0 }}">

                                                            <div class="col-12">
                                                                <input type="text" name="subject" class="form-control" value="{{ selectedMessage.subject }}">
                                                            </div>
                                                            <div class="col-md-6">
                                                                <select name="targetFolder" class="form-select">
                                                                    {% for label, value in folderChoices %}
                                                                        <option value="{{ value }}" {{ selectedMessage.folder == value ? 'selected' : '' }}>{{ label }}</option>
                                                                    {% endfor %}
                                                                </select>
                                                            </div>
                                                            <div class="col-md-6">
                                                                <input type="text" name="labels" class="form-control" value="{{ labelsString }}" placeholder="Labels (Komma-getrennt)">
                                                            </div>
                                                            <div class="col-12">
                                                                <input type="text"
                                                                       name="toEmail"
                                                                       class="form-control"
                                                                       list="supportEmailRecipientList"
                                                                       autocomplete="off"
                                                                       value="{{ selectedMessage.toEmail ?: '' }}"
                                                                       placeholder="An">
                                                            </div>
                                                            <div class="col-12">
                                                                <textarea name="body" class="form-control" rows="6">{{ selectedMessage.bodyText }}</textarea>
                                                            </div>
                                                            <div class="col-12 d-flex flex-wrap gap-3">
                                                                <div class="form-check">
                                                                    <input class="form-check-input" type="checkbox" id="mailEditRead" name="isRead" value="1" {{ selectedMessage.isRead ? 'checked' : '' }}>
                                                                    <label class="form-check-label" for="mailEditRead">Gelesen</label>
                                                                </div>
                                                                <div class="form-check">
                                                                    <input class="form-check-input" type="checkbox" id="mailEditStarred" name="isStarred" value="1" {{ selectedMessage.isStarred ? 'checked' : '' }}>
                                                                    <label class="form-check-label" for="mailEditStarred">Markiert</label>
                                                                </div>
                                                            </div>
                                                            <div class="col-12">
                                                                <button type="submit" class="btn btn-primary">
                                                                    <i class="fa fa-save me-1"></i> Änderungen speichern
                                                                </button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% else %}
                                    <div class="card-body text-muted">
                                        Keine E-Mail ausgewählt.
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        {% endif %}
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const selectAll = document.getElementById('mailBulkSelectAll');
            const actionSelect = document.getElementById('mailBulkActionSelect');
            const bulkForm = document.getElementById('mailBulkActionForm');
            const itemSelector = '.tfd-mail-select-item';

            if (!bulkForm) {
                return;
            }

            const getItemCheckboxes = function () {
                return Array.from(document.querySelectorAll(itemSelector));
            };

            const syncSelectAllState = function () {
                if (!selectAll) {
                    return;
                }

                const itemCheckboxes = getItemCheckboxes();
                if (itemCheckboxes.length === 0) {
                    selectAll.checked = false;
                    selectAll.indeterminate = false;
                    return;
                }

                const checkedCount = itemCheckboxes.filter((checkbox) => checkbox.checked).length;
                selectAll.checked = checkedCount === itemCheckboxes.length;
                selectAll.indeterminate = checkedCount > 0 && checkedCount < itemCheckboxes.length;
            };

            if (selectAll) {
                selectAll.addEventListener('change', function () {
                    const checked = selectAll.checked;
                    getItemCheckboxes().forEach((checkbox) => {
                        checkbox.checked = checked;
                    });
                    syncSelectAllState();
                });
            }

            getItemCheckboxes().forEach((checkbox) => {
                checkbox.addEventListener('change', syncSelectAllState);
            });
            syncSelectAllState();

            bulkForm.addEventListener('submit', function (event) {
                const selectedCount = getItemCheckboxes().filter((checkbox) => checkbox.checked).length;
                const action = actionSelect ? actionSelect.value : '';

                if (selectedCount < 1) {
                    event.preventDefault();
                    window.alert('Bitte mindestens eine E-Mail auswählen.');
                    return;
                }

                if (!action) {
                    event.preventDefault();
                    window.alert('Bitte eine Aktion auswählen.');
                    return;
                }

                if ('delete' === action) {
                    const confirmed = window.confirm('Ausgewählte E-Mails wirklich löschen?');
                    if (!confirmed) {
                        event.preventDefault();
                    }
                }
            });
        });
    </script>
{% endblock %}
