{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Suche{% endblock %}

{% block configured_stylesheets %}
    {{ parent() }}
    <style>
        .sa-search-page {
            --sa-bg: #020617;
            --sa-surface: rgba(15, 23, 42, 0.82);
            --sa-surface-soft: rgba(255, 255, 255, 0.04);
            --sa-border: rgba(255, 255, 255, 0.1);
            --sa-text: #e2e8f0;
            --sa-muted: #94a3b8;
            --sa-accent: #67e8f9;
            --sa-accent-strong: #22d3ee;
            --sa-panel-w: min(92vw, 28rem);
            min-height: calc(100vh - 80px);
            margin-top: 1rem;
            border-radius: 1.5rem;
            background: radial-gradient(1200px circle at 82% -5%, rgba(6, 182, 212, 0.16), transparent 42%), var(--sa-bg);
            color: var(--sa-text);
            border: 1px solid var(--sa-border);
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.35);
            overflow: hidden;
        }

        .sa-search-shell {
            width: 100%;
            max-width: 80rem;
            margin: 0 auto;
            padding: 1.25rem;
        }

        .sa-header {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .sa-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            border-radius: 999px;
            border: 1px solid rgba(34, 211, 238, 0.35);
            background: rgba(34, 211, 238, 0.12);
            color: #cffafe;
            font-size: 0.72rem;
            padding: 0.25rem 0.7rem;
            margin-bottom: 0.6rem;
        }

        .sa-title {
            margin: 0;
            font-size: clamp(1.5rem, 3vw, 2.25rem);
            letter-spacing: -0.02em;
        }

        .sa-subtitle {
            margin-top: 0.4rem;
            color: var(--sa-muted);
            max-width: 42rem;
            font-size: 0.92rem;
        }

        .sa-admin-card {
            border: 1px solid var(--sa-border);
            border-radius: 1rem;
            background: var(--sa-surface-soft);
            padding: 0.75rem 1rem;
            min-width: 220px;
            align-self: center;
        }

        .sa-admin-role {
            color: var(--sa-muted);
            font-size: 0.75rem;
        }

        .sa-stats {
            display: grid;
            gap: 0.75rem;
            grid-template-columns: repeat(auto-fit, minmax(145px, 1fr));
            margin-bottom: 1rem;
        }

        .sa-stat {
            border: 1px solid var(--sa-border);
            border-radius: 1rem;
            background: var(--sa-surface-soft);
            padding: 0.75rem;
        }

        .sa-stat-label {
            font-size: 0.68rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--sa-muted);
        }

        .sa-stat-value {
            font-size: 1.25rem;
            font-weight: 650;
            margin-top: 0.3rem;
        }

        .sa-main-card {
            border: 1px solid var(--sa-border);
            border-radius: 1.5rem;
            overflow: hidden;
            background: var(--sa-surface);
        }

        .sa-search-bar-wrap {
            border-bottom: 1px solid var(--sa-border);
            background: linear-gradient(100deg, rgba(15, 23, 42, 0.95), rgba(8, 47, 73, 0.35));
            padding: 1rem;
        }

        .sa-search-row {
            display: flex;
            flex-wrap: wrap;
            gap: 0.7rem;
        }

        .sa-search-input-wrap {
            position: relative;
            flex: 1;
            min-width: 260px;
        }

        .sa-search-icon {
            position: absolute;
            left: 0.9rem;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            pointer-events: none;
        }

        .sa-search-input {
            width: 100%;
            border-radius: 1rem;
            border: 1px solid var(--sa-border);
            background: rgba(2, 6, 23, 0.7);
            color: var(--sa-text);
            height: 3.1rem;
            padding: 0 2.55rem 0 2.5rem;
            outline: none;
        }

        .sa-search-input:focus {
            border-color: rgba(34, 211, 238, 0.65);
        }

        .sa-search-clear {
            position: absolute;
            right: 0.65rem;
            top: 50%;
            transform: translateY(-50%);
            border: 0;
            border-radius: 999px;
            width: 1.6rem;
            height: 1.6rem;
            background: rgba(148, 163, 184, 0.18);
            color: #cbd5e1;
            cursor: pointer;
            display: none;
        }

        .sa-btn {
            border-radius: 1rem;
            border: 1px solid var(--sa-border);
            height: 3.1rem;
            padding: 0 1rem;
            background: #ffffff;
            color: #0f172a;
            font-weight: 600;
            cursor: pointer;
            white-space: nowrap;
        }

        .sa-grid {
            display: grid;
            grid-template-columns: 270px minmax(0, 1fr);
        }

        .sa-sidebar {
            border-right: 1px solid var(--sa-border);
            padding: 1rem;
            background: rgba(2, 6, 23, 0.35);
        }

        .sa-sidebar-title {
            color: var(--sa-muted);
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 0.7rem;
        }

        .sa-facet-btn {
            width: 100%;
            border: 1px solid transparent;
            border-radius: 0.8rem;
            background: var(--sa-surface-soft);
            color: #cbd5e1;
            padding: 0.58rem 0.7rem;
            margin-bottom: 0.45rem;
            text-align: left;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            gap: 0.5rem;
            font-size: 0.84rem;
        }

        .sa-facet-btn.active {
            background: var(--sa-accent);
            color: #082f49;
            font-weight: 650;
        }

        .sa-result-area {
            padding: 1rem;
        }

        .sa-result-head {
            display: flex;
            justify-content: space-between;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        .sa-result-title {
            margin: 0;
            font-size: 1.05rem;
        }

        .sa-result-sub {
            font-size: 0.74rem;
            color: var(--sa-muted);
            margin-top: 0.35rem;
        }

        .sa-table {
            margin-top: 0.9rem;
            border: 1px solid var(--sa-border);
            border-radius: 1rem;
            overflow: hidden;
        }

        .sa-table-head {
            display: grid;
            grid-template-columns: 90px minmax(0, 1fr) 130px 90px 46px;
            gap: 0.5rem;
            padding: 0.65rem 0.9rem;
            border-bottom: 1px solid var(--sa-border);
            background: var(--sa-surface-soft);
            font-size: 0.7rem;
            color: var(--sa-muted);
            text-transform: uppercase;
            letter-spacing: 0.07em;
        }

        .sa-hit {
            display: grid;
            grid-template-columns: 90px minmax(0, 1fr) 130px 90px 46px;
            gap: 0.5rem;
            padding: 0.85rem 0.9rem;
            border-bottom: 1px solid var(--sa-border);
            align-items: start;
        }

        .sa-hit:last-child {
            border-bottom: 0;
        }

        .sa-id {
            color: #94a3b8;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New, monospace;
            font-size: 0.78rem;
            word-break: break-word;
        }

        .sa-hit-top {
            display: flex;
            gap: 0.45rem;
            flex-wrap: wrap;
            margin-bottom: 0.4rem;
        }

        .sa-entity-badge {
            border-radius: 0.4rem;
            padding: 0.12rem 0.42rem;
            font-size: 0.7rem;
            background: rgba(34, 211, 238, 0.14);
            color: #a5f3fc;
            border: 1px solid rgba(34, 211, 238, 0.28);
        }

        .sa-updated {
            font-size: 0.7rem;
            color: #94a3b8;
        }

        .sa-hit-line {
            display: flex;
            gap: 0.7rem;
            align-items: flex-start;
        }

        .sa-brand {
            width: 2.65rem;
            height: 2.65rem;
            border-radius: 0.85rem;
            border: 1px solid rgba(34, 211, 238, 0.34);
            background: rgba(34, 211, 238, 0.15);
            display: grid;
            place-items: center;
            color: #a5f3fc;
            font-size: 0.67rem;
            font-weight: 700;
            overflow: hidden;
            flex-shrink: 0;
        }

        .sa-brand img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .sa-hit-title {
            margin: 0;
            font-size: 0.92rem;
            color: #f8fafc;
        }

        .sa-hit-sub,
        .sa-hit-snippet {
            color: #94a3b8;
            font-size: 0.77rem;
            margin-top: 0.18rem;
            line-height: 1.38;
        }

        .sa-hit-snippet mark {
            background: rgba(34, 211, 238, 0.22);
            color: #cffafe;
            border-radius: 0.25rem;
            padding: 0 0.16rem;
        }

        .sa-tags {
            margin-top: 0.45rem;
            display: flex;
            gap: 0.3rem;
            flex-wrap: wrap;
        }

        .sa-tag {
            border-radius: 0.4rem;
            padding: 0.14rem 0.4rem;
            border: 1px solid var(--sa-border);
            color: #94a3b8;
            font-size: 0.68rem;
        }

        .sa-route {
            margin-top: 0.35rem;
            font-size: 0.68rem;
            color: #64748b;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New, monospace;
            word-break: break-all;
        }

        .sa-status {
            border-radius: 999px;
            padding: 0.18rem 0.5rem;
            font-size: 0.7rem;
            border: 1px solid transparent;
            display: inline-block;
            white-space: nowrap;
        }

        .sa-score {
            font-size: 0.84rem;
            color: #cbd5e1;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New, monospace;
        }

        .sa-action {
            border: 1px solid var(--sa-border);
            border-radius: 0.5rem;
            width: 2rem;
            height: 2rem;
            display: inline-grid;
            place-items: center;
            color: #cbd5e1;
            text-decoration: none;
            background: rgba(255, 255, 255, 0.04);
        }

        .sa-empty,
        .sa-spinner {
            text-align: center;
            color: #94a3b8;
            padding: 1.5rem 0;
        }

        .sa-footer {
            margin-top: 0.7rem;
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 0.5rem;
            font-size: 0.73rem;
            color: #94a3b8;
        }

        .sa-drawer {
            position: fixed;
            inset: 0;
            z-index: 1055;
            display: none;
        }

        .sa-drawer.open {
            display: block;
        }

        .sa-drawer-backdrop {
            position: absolute;
            inset: 0;
            background: rgba(2, 6, 23, 0.78);
            backdrop-filter: blur(2px);
            border: 0;
            width: 100%;
            height: 100%;
            cursor: pointer;
        }

        .sa-drawer-panel {
            position: absolute;
            right: 0;
            top: 0;
            width: var(--sa-panel-w);
            max-width: 100%;
            height: 100%;
            border-left: 1px solid var(--sa-border);
            background: #020617;
            color: #e2e8f0;
            padding: 1rem;
            overflow-y: auto;
            transform: translateX(100%);
            transition: transform 0.22s ease;
        }

        .sa-drawer.open .sa-drawer-panel {
            transform: translateX(0);
        }

        .sa-close {
            border: 1px solid var(--sa-border);
            border-radius: 0.55rem;
            background: rgba(255, 255, 255, 0.04);
            color: #cbd5e1;
            width: 2rem;
            height: 2rem;
            cursor: pointer;
        }

        .sa-group-label {
            margin: 1rem 0 0.45rem;
            display: block;
            color: #94a3b8;
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.07em;
        }

        .sa-chip-grid {
            display: grid;
            gap: 0.45rem;
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .sa-chip {
            border: 1px solid var(--sa-border);
            border-radius: 0.65rem;
            background: rgba(255, 255, 255, 0.04);
            color: #cbd5e1;
            padding: 0.4rem 0.5rem;
            font-size: 0.8rem;
            text-align: left;
            cursor: pointer;
        }

        .sa-chip.active {
            background: var(--sa-accent);
            border-color: var(--sa-accent);
            color: #082f49;
            font-weight: 650;
        }

        .sa-drawer-footer {
            position: sticky;
            bottom: 0;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.55rem;
            background: rgba(2, 6, 23, 0.92);
            border-top: 1px solid var(--sa-border);
            padding-top: 0.75rem;
            margin-top: 1.1rem;
        }

        .sa-reset {
            border: 1px solid var(--sa-border);
            background: transparent;
            color: #cbd5e1;
            border-radius: 0.8rem;
            padding: 0.62rem 0.8rem;
        }

        .sa-apply {
            border: 1px solid var(--sa-accent);
            background: var(--sa-accent);
            color: #082f49;
            border-radius: 0.8rem;
            padding: 0.62rem 0.8rem;
            font-weight: 650;
        }

        @media (max-width: 1024px) {
            .sa-grid {
                grid-template-columns: 1fr;
            }

            .sa-sidebar {
                border-right: 0;
                border-bottom: 1px solid var(--sa-border);
            }
        }

        @media (max-width: 860px) {
            .sa-table-head {
                display: none;
            }

            .sa-hit {
                grid-template-columns: 1fr;
            }

            .sa-search-shell {
                padding: 0.9rem;
            }

            .sa-btn {
                width: 100%;
            }
        }
    </style>
{% endblock %}

{% block main %}
    <section class="sa-search-page">
        <div class="sa-search-shell">
            <header class="sa-header">
                <div>
                    <div class="sa-badge">EasyAdmin Superadmin Search</div>
                    <h1 class="sa-title">Globale Admin-Suche</h1>
                    <p class="sa-subtitle">Zentrale Meilisearch-Ausgabe fuer User, Orders, CMS, Fahrzeugdatenbank, Audit-Daten und interne Admin-Aktionen.</p>
                </div>
                <div class="sa-admin-card">
                    <div><strong>Superadmin</strong></div>
                    <div class="sa-admin-role">ROLE_SUPER_ADMIN · Vollzugriff</div>
                </div>
            </header>

            <div class="sa-stats" id="sa-stats"></div>

            <div class="sa-main-card">
                <div class="sa-search-bar-wrap">
                    <form id="search-hub-form" onsubmit="return false" class="sa-search-row">
                        <div class="sa-search-input-wrap">
                            <span class="sa-search-icon">{{ ux_icon('material-symbols:search') }}</span>
                            <input
                                id="search-hub-q"
                                class="sa-search-input"
                                type="text"
                                placeholder="Suche global: Fahrzeug, VIN, Kennzeichen, User, Order, SKU, Slug, AuditLog, E-Mail ..."
                                value="{{ query|e }}"
                                autofocus
                                spellcheck="false"
                            >
                            <button type="button" class="sa-search-clear" id="search-hub-clear" aria-label="Suche leeren">X</button>
                        </div>
                        <button class="sa-btn" type="submit" id="search-hub-submit">Erweiterte Filter</button>
                    </form>
                </div>

                <div class="sa-grid">
                    <aside class="sa-sidebar">
                        <div class="sa-sidebar-title">Entitaeten</div>
                        <div id="sa-facets"></div>
                    </aside>

                    <section class="sa-result-area">
                        <div class="sa-result-head">
                            <div>
                                <h2 class="sa-result-title">Meilisearch Response</h2>
                                <div class="sa-result-sub" id="sa-query-meta">Query: *</div>
                            </div>
                        </div>

                        <div id="search-hub-spinner" class="sa-spinner">Suche laeuft...</div>
                        <div id="search-hub-results"></div>
                    </section>
                </div>
            </div>
        </div>
    </section>

    <div class="sa-drawer" id="sa-drawer" aria-hidden="true">
        <button class="sa-drawer-backdrop" id="sa-drawer-backdrop" aria-label="Filter schliessen"></button>
        <aside class="sa-drawer-panel" role="dialog" aria-label="Erweiterte Filter">
            <div style="display:flex;align-items:start;justify-content:space-between;gap:.5rem;">
                <div>
                    <div class="sa-badge" style="margin-bottom:.45rem;">Erweiterte Suche</div>
                    <h3 style="margin:0;font-size:1.35rem;">Filter</h3>
                    <p style="margin:.35rem 0 0;color:#94a3b8;font-size:.85rem;">Grenze Meilisearch-Treffer fuer EasyAdmin gezielt ein.</p>
                </div>
                <button type="button" id="sa-drawer-close" class="sa-close" aria-label="Filter schliessen">X</button>
            </div>

            <label class="sa-group-label">Entity</label>
            <div class="sa-chip-grid" id="sa-entity-chips"></div>

            <label class="sa-group-label">Fahrzeugdatenbank</label>
            <div>
                <div style="margin-bottom:.5rem; color:#94a3b8; font-size:.75rem;">Fahrzeugtyp</div>
                <div class="sa-chip-grid" id="filter-vehicle-type">
                    <button type="button" class="sa-chip filter-btn-type active" data-value="">Alle Typen</button>
                    {% for vt in vehicleTypes %}
                        <button type="button" class="sa-chip filter-btn-type" data-value="{{ vt.name|e }}">{{ vt.name }}</button>
                    {% endfor %}
                </div>

                <div style="margin:.8rem 0 .5rem; color:#94a3b8; font-size:.75rem;">Data Pool</div>
                <div class="sa-chip-grid" id="filter-data-pool">
                    <button type="button" class="sa-chip filter-btn-pool active" data-value="">Alle Pools</button>
                    {% for dp in dataPools %}
                        <button type="button" class="sa-chip filter-btn-pool" data-value="{{ dp.poolKey|e }}" title="{{ dp.name|e }}">{{ dp.name }}</button>
                    {% endfor %}
                </div>
            </div>

            <label class="sa-group-label">Status</label>
            <div id="sa-status-preview" style="display:flex;gap:.4rem;flex-wrap:wrap;"></div>

            <label class="sa-group-label">Preis / Bestand</label>
            <div style="color:#64748b;font-size:.78rem;">Wird aus vorhandenen Trefferdaten gelesen, falls Felder vorhanden sind.</div>

            <div class="sa-drawer-footer">
                <button type="button" id="sa-reset-filters" class="sa-reset">Zuruecksetzen</button>
                <button type="button" id="sa-apply-filters" class="sa-apply">Filter anwenden</button>
            </div>
        </aside>
    </div>

    <script>
    (function () {
        const input = document.getElementById('search-hub-q');
        const searchClearBtn = document.getElementById('search-hub-clear');
        const submitBtn = document.getElementById('search-hub-submit');
        const resultsEl = document.getElementById('search-hub-results');
        const spinner = document.getElementById('search-hub-spinner');
        const queryMetaEl = document.getElementById('sa-query-meta');
        const facetsEl = document.getElementById('sa-facets');
        const statsEl = document.getElementById('sa-stats');
        const entityChipsEl = document.getElementById('sa-entity-chips');

        const drawer = document.getElementById('sa-drawer');
        const drawerBackdrop = document.getElementById('sa-drawer-backdrop');
        const drawerClose = document.getElementById('sa-drawer-close');
        const applyFiltersBtn = document.getElementById('sa-apply-filters');
        const resetFiltersBtn = document.getElementById('sa-reset-filters');

        const apiUrl = {{ path('admin_search_api')|json_encode|raw }};
        let timer = null;
        let lastQuery = '';
        let activeVehicleType = {{ filterVehicleType|default('')|json_encode|raw }};
        let activeDataPool = {{ filterDataPool|default('')|json_encode|raw }};
        let activeEntity = 'Alle';
        let lastData = null;

        const statusClassMap = {
            'online': 'background:rgba(74,222,128,.15);color:#bbf7d0;border-color:rgba(74,222,128,.35);',
            'aktiv': 'background:rgba(52,211,153,.15);color:#a7f3d0;border-color:rgba(52,211,153,.35);',
            'pruefung': 'background:rgba(251,191,36,.15);color:#fde68a;border-color:rgba(251,191,36,.35);',
            'prüfung': 'background:rgba(251,191,36,.15);color:#fde68a;border-color:rgba(251,191,36,.35);',
            'review': 'background:rgba(251,146,60,.15);color:#fed7aa;border-color:rgba(251,146,60,.35);',
            'draft': 'background:rgba(96,165,250,.15);color:#bfdbfe;border-color:rgba(96,165,250,.35);',
            'archiviert': 'background:rgba(251,113,133,.15);color:#fecdd3;border-color:rgba(251,113,133,.35);'
        };

        const indexEntityLabelMap = {
            kunden: 'User',
            auftraege: 'Order',
            vehicle_types: 'Vehicle',
            vehicle_brands: 'Vehicle',
            vehicle_series: 'Vehicle',
            vehicle_models: 'Vehicle',
            vehicle_engines: 'Vehicle',
            ecu_masters: 'Product',
            ecu_manufacturer_masters: 'Product',
            dtc_codes: 'AuditLog'
        };

        function normStatus(value) {
            return String(value || '').trim().toLowerCase();
        }

        function statusStyle(status) {
            return statusClassMap[normStatus(status)] || 'background:rgba(148,163,184,.1);color:#cbd5e1;border-color:rgba(148,163,184,.3);';
        }

        function pickFormatted(hit, key) {
            if (!hit || typeof hit !== 'object' || !hit._formatted || typeof hit._formatted !== 'object') {
                return hit?.[key] ?? '';
            }
            return hit._formatted[key] ?? hit?.[key] ?? '';
        }

        function esc(str) {
            return String(str ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        function safeHtml(str) {
            return esc(str)
                .replace(/&lt;mark&gt;/g, '<mark>')
                .replace(/&lt;\/mark&gt;/g, '</mark>');
        }

        function stripTags(value) {
            return String(value ?? '').replace(/<[^>]*>/g, '').trim();
        }

        function rawValue(hit, key) {
            if (!hit || typeof hit !== 'object') return '';
            return stripTags(hit[key] ?? '');
        }

        function extractSnippet(hit) {
            if (!hit || typeof hit !== 'object' || !hit._formatted || typeof hit._formatted !== 'object') return '';
            const priorityKeys = ['description', 'beschreibung', 'name', 'title', 'fileName', 'customerEmail', 'vehicleDisplay', 'modelName'];
            for (const key of priorityKeys) {
                const value = hit._formatted[key];
                if (typeof value === 'string' && value.includes('<mark>')) {
                    return value;
                }
            }
            for (const key in hit._formatted) {
                const value = hit._formatted[key];
                if (typeof value === 'string' && value.includes('<mark>')) {
                    return value;
                }
            }
            return '';
        }

        function joinTruthy(parts, sep) {
            return parts.filter(v => typeof v === 'string' && v.trim() !== '').join(sep);
        }

        function hitLabel(sectionKey, hit) {
            switch (sectionKey) {
                case 'kunden': {
                    return {
                        title: joinTruthy([rawValue(hit, 'vorname'), rawValue(hit, 'nachname')], ' ') || rawValue(hit, 'email') || 'User',
                        sub: joinTruthy([rawValue(hit, 'firmenname'), rawValue(hit, 'email')], ' · ')
                    };
                }
                case 'auftraege': {
                    return {
                        title: rawValue(hit, 'fileName') || rawValue(hit, 'customerEmail') || 'Order',
                        sub: joinTruthy([
                            rawValue(hit, 'vehicleDisplay') || joinTruthy([rawValue(hit, 'manufacturer'), rawValue(hit, 'model'), rawValue(hit, 'engine')], ' '),
                            rawValue(hit, 'customerEmail')
                        ], ' · ')
                    };
                }
                case 'vehicle_engines': {
                    return {
                        title: rawValue(hit, 'name') || 'Vehicle',
                        sub: joinTruthy([
                            rawValue(hit, 'brandName'),
                            rawValue(hit, 'seriesName'),
                            rawValue(hit, 'modelName'),
                            rawValue(hit, 'fuel'),
                            hit.horsepower ? `${hit.horsepower} PS` : ''
                        ], ' · ')
                    };
                }
                default:
                    return {
                        title: rawValue(hit, 'name') || rawValue(hit, 'title') || rawValue(hit, 'email') || 'Treffer',
                        sub: joinTruthy([
                            rawValue(hit, 'slug'),
                            rawValue(hit, 'vehicleTypeName'),
                            rawValue(hit, 'dataPoolKey')
                        ], ' · ')
                    };
            }
        }

        function isVehicleHit(sectionKey, hit) {
            if (sectionKey.startsWith('vehicle_')) return true;
            const entity = String(hit.entity || hit.type || '').toLowerCase();
            return entity === 'vehicle' || entity === 'fahrzeug';
        }

        function vehicleBrand(hit) {
            return rawValue(hit, 'brandName') || rawValue(hit, 'manufacturer') || rawValue(hit, 'marke') || rawValue(hit, 'brand') || '';
        }

        function brandLogo(hit) {
            return hit.brandLogo || hit.brandLogoUrl || hit.logo || hit.logoUrl || '';
        }

        function brandInitials(brand) {
            const cleaned = String(brand || '').trim();
            if (!cleaned) return 'AUTO';
            return cleaned.split(/\s+/).map(p => p.charAt(0)).join('').slice(0, 3).toUpperCase();
        }

        function buildVehicleFields(hit) {
            const lines = [];
            const brand = vehicleBrand(hit);
            if (brand) lines.push(`Marke: ${brand}`);
            if (hit.modelName || hit.model) lines.push(`Modell: ${hit.modelName || hit.model}`);
            if (hit.vin || hit.fin) lines.push(`VIN/FIN: ${hit.vin || hit.fin}`);
            if (hit.licensePlate || hit.kennzeichen) lines.push(`Kennzeichen: ${hit.licensePlate || hit.kennzeichen}`);
            if (hit.fuel || hit.antrieb) lines.push(`Antrieb: ${hit.fuel || hit.antrieb}`);
            if (hit.price || hit.preis) lines.push(`Preis: ${hit.price || hit.preis}`);
            return lines;
        }

        function extractTags(hit) {
            const tags = [];
            const fields = ['dataPoolKey', 'vehicleTypeName', 'fuel', 'slug', 'categoryLetter'];
            for (const field of fields) {
                const value = rawValue(hit, field);
                if (value) tags.push(value);
            }
            return tags.slice(0, 6);
        }

        function entityFromSection(section) {
            return indexEntityLabelMap[section.key] || section.label || 'Entity';
        }

        function flattenHits(data) {
            const rows = [];
            if (!data || !Array.isArray(data.results)) return rows;
            for (const section of data.results) {
                for (const hit of (section.hits || [])) {
                    rows.push({ section, hit });
                }
            }
            return rows;
        }

        function collectFacetCounts(data) {
            const counts = new Map();
            counts.set('Alle', 0);
            const rows = flattenHits(data);
            counts.set('Alle', rows.length);

            const preferred = ['User', 'Order', 'Vehicle', 'Product', 'Page', 'AuditLog'];
            preferred.forEach(label => counts.set(label, counts.get(label) || 0));

            for (const row of rows) {
                const label = entityFromSection(row.section);
                counts.set(label, (counts.get(label) || 0) + 1);
            }
            return counts;
        }

        function renderFacets(data) {
            const counts = collectFacetCounts(data);
            if (activeEntity !== 'Alle' && !counts.has(activeEntity)) {
                activeEntity = 'Alle';
            }

            let html = '';
            for (const [label, count] of counts.entries()) {
                html += `<button type="button" class="sa-facet-btn ${activeEntity === label ? 'active' : ''}" data-facet="${esc(label)}"><span>${esc(label)}</span><span>${Number(count || 0).toLocaleString('de-DE')}</span></button>`;
            }
            facetsEl.innerHTML = html;

            facetsEl.querySelectorAll('[data-facet]').forEach(btn => {
                btn.addEventListener('click', function () {
                    activeEntity = this.dataset.facet || 'Alle';
                    renderResults(lastData);
                });
            });

            renderEntityChips(Array.from(counts.keys()));
        }

        function renderEntityChips(labels) {
            const usable = labels.filter(l => l !== 'Alle');
            let html = '';
            for (const label of usable) {
                html += `<button type="button" class="sa-chip ${activeEntity === label ? 'active' : ''}" data-entity="${esc(label)}">${esc(label)}</button>`;
            }
            entityChipsEl.innerHTML = html;
            entityChipsEl.querySelectorAll('[data-entity]').forEach(btn => {
                btn.addEventListener('click', function () {
                    activeEntity = this.dataset.entity || 'Alle';
                    closeDrawer();
                    renderResults(lastData);
                });
            });
        }

        function renderStats(data) {
            const sections = Array.isArray(data?.results) ? data.results : [];
            const hitCount = sections.reduce((sum, section) => sum + (section.hits?.length || 0), 0);
            const vehicleCount = sections
                .filter(section => section.key && String(section.key).startsWith('vehicle_'))
                .reduce((sum, section) => sum + (section.hits?.length || 0), 0);

            const cards = [];
            if (sections.length > 0) cards.push({ label: 'Indexe', value: String(sections.length) });
            if (hitCount > 0) cards.push({ label: 'Treffer', value: hitCount.toLocaleString('de-DE') });
            cards.push({ label: 'Admin-Modus', value: 'Root' });
            if (vehicleCount > 0) cards.push({ label: 'Fahrzeuge', value: vehicleCount.toLocaleString('de-DE') });

            let html = '';
            for (const card of cards) {
                html += `<div class="sa-stat"><div class="sa-stat-label">${esc(card.label)}</div><div class="sa-stat-value">${esc(card.value)}</div></div>`;
            }
            statsEl.innerHTML = html;
        }

        function filteredRows(data) {
            const rows = flattenHits(data);
            if (activeEntity === 'Alle') return rows;
            return rows.filter(row => entityFromSection(row.section) === activeEntity);
        }

        function renderResults(data) {
            lastData = data;
            renderFacets(data || { results: [] });
            renderStats(data || { results: [] });

            const rows = filteredRows(data || { results: [] });
            const total = flattenHits(data || { results: [] }).length;

            if (!rows.length) {
                resultsEl.innerHTML = '<p class="sa-empty">Keine Treffer gefunden.</p>';
                queryMetaEl.textContent = `Query: ${input.value.trim() || '*'} · Treffer: ${total}`;
                return;
            }

            let html = '';
            html += '<div class="sa-table">';
            html += '<div class="sa-table-head"><div>ID</div><div>Treffer / Fahrzeugdaten</div><div>Status</div><div>Score</div><div>Aktionen</div></div>';

            for (const row of rows) {
                const { section, hit } = row;
                const labels = hitLabel(section.key, hit);
                const snippet = extractSnippet(hit);
                const entity = entityFromSection(section);
                const status = hit.status || hit.state || 'Unbekannt';
                const score = typeof hit._rankingScore === 'number' ? `${Math.round(hit._rankingScore * 100)}%` : (hit.score || '-');
                const updated = hit.updatedAt || hit.updated || hit.modifiedAt || '';
                const tags = extractTags(hit);
                const adminUrl = hit._adminUrl || '';
                const id = hit.id ?? '-';

                const vehicle = isVehicleHit(section.key, hit);
                const brand = vehicleBrand(hit);
                const brandLogoUrl = brandLogo(hit);
                const vehicleLines = vehicle ? buildVehicleFields(hit) : [];

                html += '<article class="sa-hit">';
                html += `<div class="sa-id">#${esc(id)}</div>`;
                html += '<div>';
                html += `<div class="sa-hit-top"><span class="sa-entity-badge">${esc(entity)}</span>${updated ? `<span class="sa-updated">Updated: ${esc(updated)}</span>` : ''}</div>`;
                html += '<div class="sa-hit-line">';
                if (vehicle && (brand || brandLogoUrl)) {
                    if (brandLogoUrl) {
                        html += `<div class="sa-brand"><img src="${esc(brandLogoUrl)}" alt="${esc(brand || 'Marke')}"></div>`;
                    } else {
                        html += `<div class="sa-brand">${esc(brandInitials(brand))}</div>`;
                    }
                }
                html += '<div style="min-width:0;">';
                html += `<h3 class="sa-hit-title">${safeHtml(labels.title)}</h3>`;
                if (labels.sub) html += `<div class="sa-hit-sub">${safeHtml(labels.sub)}</div>`;
                if (vehicleLines.length) html += `<div class="sa-hit-sub">${esc(vehicleLines.join(' · '))}</div>`;
                if (snippet) html += `<div class="sa-hit-snippet">${safeHtml(snippet)}</div>`;
                if (tags.length) {
                    html += '<div class="sa-tags">';
                    for (const tag of tags) html += `<span class="sa-tag">${esc(tag)}</span>`;
                    html += '</div>';
                }
                if (adminUrl) html += `<div class="sa-route">${esc(adminUrl)}</div>`;
                html += '</div></div></div>';

                html += `<div><span class="sa-status" style="${statusStyle(status)}">${esc(status)}</span></div>`;
                html += `<div class="sa-score">${esc(score)}</div>`;
                html += `<div>${adminUrl ? `<a class="sa-action" href="${esc(adminUrl)}" title="Oeffnen" aria-label="Oeffnen">-></a>` : '<span class="sa-action" style="opacity:.45;">-</span>'}</div>`;
                html += '</article>';
            }
            html += '</div>';
            html += `<div class="sa-footer"><span>${rows.length.toLocaleString('de-DE')} von ${total.toLocaleString('de-DE')} Treffern</span><span>Filter: ${activeVehicleType || 'Alle Typen'} · ${activeDataPool || 'Alle Pools'}</span></div>`;

            resultsEl.innerHTML = html;
            queryMetaEl.textContent = `Query: ${input.value.trim() || '*'} · Treffer: ${total.toLocaleString('de-DE')}`;
        }

        function buildApiUrl(q) {
            const params = new URLSearchParams({ q });
            if (activeVehicleType) params.set('vehicleType', activeVehicleType);
            if (activeDataPool) params.set('dataPool', activeDataPool);
            return apiUrl + '?' + params.toString();
        }

        function doSearch(q) {
            spinner.style.display = 'block';
            resultsEl.innerHTML = '';
            fetch(buildApiUrl(q))
                .then(r => r.json())
                .then(data => {
                    spinner.style.display = 'none';
                    renderResults(data);
                })
                .catch(() => {
                    spinner.style.display = 'none';
                    resultsEl.innerHTML = '<p class="sa-empty" style="color:#fda4af;">Fehler bei der Suche.</p>';
                });
        }

        function triggerSearch() {
            const q = input.value.trim();
            if (q.length < 2) return;
            clearTimeout(timer);
            lastQuery = q;
            doSearch(q);
        }

        function syncFilterButtonStates() {
            document.querySelectorAll('.filter-btn-type').forEach(btn => {
                btn.classList.toggle('active', (btn.dataset.value || '') === activeVehicleType);
            });
            document.querySelectorAll('.filter-btn-pool').forEach(btn => {
                btn.classList.toggle('active', (btn.dataset.value || '') === activeDataPool);
            });
        }

        function openDrawer() {
            drawer.classList.add('open');
            drawer.setAttribute('aria-hidden', 'false');
        }

        function closeDrawer() {
            drawer.classList.remove('open');
            drawer.setAttribute('aria-hidden', 'true');
        }

        function renderStatusPreview() {
            const statuses = ['Aktiv', 'Online', 'Pruefung', 'Review', 'Draft', 'Archiviert'];
            const target = document.getElementById('sa-status-preview');
            target.innerHTML = statuses.map(label => `<span class="sa-status" style="${statusStyle(label)}">${esc(label)}</span>`).join('');
        }

        searchClearBtn.addEventListener('click', function () {
            input.value = '';
            searchClearBtn.style.display = 'none';
            resultsEl.innerHTML = '';
            queryMetaEl.textContent = 'Query: *';
            input.focus();
        });

        input.addEventListener('input', function () {
            searchClearBtn.style.display = this.value.trim() ? 'inline-grid' : 'none';
            clearTimeout(timer);
            const q = this.value.trim();
            if (q === lastQuery && activeVehicleType === '' && activeDataPool === '') return;
            lastQuery = q;
            if (q.length < 2) {
                resultsEl.innerHTML = '';
                spinner.style.display = 'none';
                return;
            }
            timer = setTimeout(() => doSearch(q), 280);
        });

        submitBtn.addEventListener('click', openDrawer);
        drawerBackdrop.addEventListener('click', closeDrawer);
        drawerClose.addEventListener('click', closeDrawer);

        applyFiltersBtn.addEventListener('click', function () {
            closeDrawer();
            triggerSearch();
        });

        resetFiltersBtn.addEventListener('click', function () {
            activeVehicleType = '';
            activeDataPool = '';
            activeEntity = 'Alle';
            syncFilterButtonStates();
            closeDrawer();
            triggerSearch();
        });

        document.querySelectorAll('.filter-btn-type').forEach(btn => {
            btn.addEventListener('click', function () {
                activeVehicleType = this.dataset.value || '';
                syncFilterButtonStates();
            });
        });

        document.querySelectorAll('.filter-btn-pool').forEach(btn => {
            btn.addEventListener('click', function () {
                activeDataPool = this.dataset.value || '';
                syncFilterButtonStates();
            });
        });

        syncFilterButtonStates();
        renderStatusPreview();
        searchClearBtn.style.display = input.value.trim() ? 'inline-grid' : 'none';
        spinner.style.display = 'none';

        if (input.value.trim().length >= 2) {
            lastQuery = input.value.trim();
            doSearch(lastQuery);
        } else {
            renderFacets({ results: [] });
            renderStats({ results: [] });
        }
    })();
    </script>
{% endblock %}
