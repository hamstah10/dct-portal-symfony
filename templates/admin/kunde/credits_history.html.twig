{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Credit-Historie{% endblock %}

{% block page_actions %}
    <a href="{{ topupUrl }}" class="btn btn-primary">
        Credits aufladen
    </a>
    <a href="{{ detailUrl }}" class="btn btn-secondary">
        Kunde anzeigen
    </a>
    <a href="{{ indexUrl }}" class="btn btn-secondary">
        Zurück zur Liste
    </a>
{% endblock %}

{% block main %}
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="small text-muted">Kunde</div>
                <div class="h5 mb-0">{{ kunde }}</div>
            </div>
            <div>
                <div class="small text-muted">Aktueller Saldo</div>
                <div class="h4 mb-0">{{ kunde.credits }} Credits</div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                    <tr>
                        <th>Datum</th>
                        <th>Typ</th>
                        <th>Zahlart</th>
                        <th class="text-end">Betrag</th>
                        <th class="text-end">Preis netto</th>
                        <th class="text-end">Preis brutto</th>
                        <th class="text-end">MwSt</th>
                        <th class="text-end">Gebuehren</th>
                        <th class="text-end">Saldo vorher</th>
                        <th class="text-end">Saldo nachher</th>
                        <th>Notiz</th>
                        <th>Erstellt von</th>
                        <th class="text-end">Aktion</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% if transactions is empty %}
                        <tr>
                            <td colspan="13" class="text-muted">Keine Credit-Buchungen vorhanden.</td>
                        </tr>
                    {% else %}
                        {% for transaction in transactions %}
                            {% set amount = transaction.amount %}
                            {% set isReversal = transaction.reversalOf is not null or transaction.transactionType == 'reversal' %}
                            {% set isReversed = reversedTransactionIds[transaction.id]|default(false) %}
                            {% set priceNet = transaction.priceNet is not null ? (transaction.priceNet + 0) : null %}
                            {% set priceGross = transaction.priceGross is not null ? (transaction.priceGross + 0) : null %}
                            {% set taxRate = transaction.taxRate is not null ? (transaction.taxRate + 0) : null %}
                            {% set feeRate = 2.49 %}
                            {% set feeFixed = 0.35 %}
                            {% set isPaypal = (transaction.paymentMethod|default('')|lower) == 'paypal' %}
                            {% set feeValue = transaction.paymentFee is not null ? (transaction.paymentFee + 0) : (priceGross is not null and isPaypal ? (priceGross * (feeRate / 100) + feeFixed) : null) %}
                            <tr>
                                <td>{{ transaction.createdAt ? transaction.createdAt|date('d.m.Y H:i') : '-' }}</td>
                                <td>
                                    {% if transaction.transactionType == 'admin_topup' %}
                                        Admin Aufladung
                                    {% elseif transaction.transactionType == 'customer_topup' %}
                                        Kunde Aufladung
                                    {% elseif transaction.transactionType == 'usage' %}
                                        Verbrauch
                                    {% elseif transaction.transactionType == 'manual_adjustment' %}
                                        Manuelle Anpassung
                                    {% elseif transaction.transactionType == 'reversal' %}
                                        Storno
                                    {% else %}
                                        {{ transaction.transactionType }}
                                    {% endif %}
                                </td>
                                <td>
                                    {% if isPaypal %}
                                        PayPal
                                    {% elseif transaction.paymentMethod %}
                                        {{ transaction.paymentMethod }}
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                                <td class="text-end {{ amount >= 0 ? 'text-success' : 'text-danger' }}">
                                    {{ amount >= 0 ? '+' : '' }}{{ amount }}
                                </td>
                                <td class="text-end">
                                    {% if priceNet is not null %}
                                        {{ priceNet|number_format(2, ',', '.') }} €
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                                <td class="text-end">
                                    {% if priceGross is not null %}
                                        {{ priceGross|number_format(2, ',', '.') }} €
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                                <td class="text-end">
                                    {% if taxRate is not null %}
                                        {{ taxRate|number_format(2, ',', '.') }} %
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                                <td class="text-end">
                                    {% if feeValue is not null %}
                                        {{ feeValue|number_format(2, ',', '.') }} €
                                        <div class="small text-muted">2,49% + 0,35 €</div>
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                                <td class="text-end">{{ transaction.balanceBefore }}</td>
                                <td class="text-end fw-semibold">{{ transaction.balanceAfter }}</td>
                                <td>{{ transaction.description ?: '-' }}</td>
                                <td>{{ transaction.createdBy ? transaction.createdBy.email : '-' }}</td>
                                <td class="text-end">
                                    {% if isReversal %}
                                        <span class="badge bg-light text-muted">Storno</span>
                                    {% elseif isReversed %}
                                        <span class="badge bg-light text-muted">Storniert</span>
                                    {% else %}
                                        <form method="post" action="{{ path('admin_kunde_credits_cancel', { entityId: kunde.id, transactionId: transaction.id }) }}" onsubmit="return confirm('Buchung wirklich stornieren?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('kunde_credits_cancel_' ~ transaction.id) }}">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Stornieren</button>
                                        </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
