{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}AI Agent (Test){% endblock %}

{% block main %}
    <div class="container-fluid px-0 tfd-ai-agent">
        {% if error %}
            <div class="alert alert-danger">{{ error }}</div>
        {% endif %}

        <div class="row g-3">
            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header">
                        <strong>Einstellungen</strong>
                        <div class="text-muted small">System‑Prompt und Chat-Verwaltung</div>
                    </div>
                    <div class="card-body">
                        <form method="post" class="mb-3">
                            <input type="hidden" name="_token" value="{{ csrf_token('admin_ai_agent') }}">
                            <input type="hidden" name="new_chat" value="1">
                            <div class="mb-3">
                                <label class="form-label">System‑Prompt (optional)</label>
                                <textarea name="systemPrompt" class="form-control" rows="5" placeholder="z. B. Du bist ein hilfreicher Assistent.">{{ systemPrompt }}</textarea>
                            </div>
                            <button type="submit" class="btn btn-outline-secondary">Neuen Chat starten</button>
                        </form>

                        {% if metadata %}
                            <hr>
                            <div class="small text-muted mb-2">Metadata (letzte Anfrage)</div>
                            <pre class="tfd-ai-agent-metadata mb-0">{{ metadata|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-8">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Chat</strong>
                        <span class="text-muted small">{{ messages|length }} Nachrichten</span>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <div class="tfd-ai-chat-log mb-3" style="min-height: 320px; max-height: 56vh; overflow-y: auto;">
                            {% if messages is empty %}
                                <div class="text-muted">Noch keine Nachrichten. Stelle rechts unten deine erste Frage.</div>
                            {% else %}
                                {% for message in messages %}
                                    <div class="d-flex mb-3 {{ message.role == 'user' ? 'justify-content-end' : 'justify-content-start' }}">
                                        <div class="tfd-ai-chat-bubble {{ message.role == 'user' ? 'tfd-ai-chat-bubble--user' : 'tfd-ai-chat-bubble--assistant' }}">
                                            {{ message.content|e|nl2br }}
                                        </div>
                                    </div>
                                {% endfor %}
                            {% endif %}
                        </div>

                        <form method="post" class="mt-auto">
                            <input type="hidden" name="_token" value="{{ csrf_token('admin_ai_agent') }}">
                            <div class="mb-2">
                                <label class="form-label">System‑Prompt (optional)</label>
                                <textarea name="systemPrompt" class="form-control" rows="2" placeholder="Optional: Systemvorgabe fuer diesen Chat">{{ systemPrompt }}</textarea>
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Nachricht</label>
                                <textarea name="prompt" class="form-control" rows="4" placeholder="Schreibe deine Nachricht ...">{{ prompt }}</textarea>
                            </div>
                            <button type="submit" class="btn btn-tuningfux">Senden</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
