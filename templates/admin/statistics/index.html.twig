{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Statistiken{% endblock %}

{% block main %}
    <div class="container-fluid px-0 mt-3">
        <ul class="nav nav-tabs mb-3 tab-style-6" id="admin-stats-tabs" role="tablist">
         <li class="nav-item" role="presentation">
                <button class="nav-link active rounded-0" id="tab-credits" data-bs-toggle="tab" data-bs-target="#panel-credits" type="button" role="tab" aria-controls="panel-credits" aria-selected="true">
                    {{ ux_icon('streamline-freehand:money-bag') }} Umsatz
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-0" id="tab-ecommerce" data-bs-toggle="tab" data-bs-target="#panel-ecommerce" type="button" role="tab" aria-controls="panel-ecommerce" aria-selected="false">
                    {{ ux_icon('material-symbols:shopping-cart') }} eCommerce
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-0" id="tab-abo" data-bs-toggle="tab" data-bs-target="#panel-abo" type="button" role="tab" aria-controls="panel-abo" aria-selected="false">
                    {{ ux_icon('stash:subscription-list-solid') }} Abos
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-0" id="tab-vehicle" data-bs-toggle="tab" data-bs-target="#panel-vehicle" type="button" role="tab" aria-controls="panel-vehicle" aria-selected="false">
                    {{ ux_icon('tdesign:vehicle-filled') }} Fahrzeuge
                </button>
            </li>
           
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-0" id="tab-dyno" data-bs-toggle="tab" data-bs-target="#panel-dyno" type="button" role="tab" aria-controls="panel-dyno" aria-selected="false">
                    {{ ux_icon('line-md:speedometer') }} Dyno
                </button>
            </li>
        </ul>

        <div class="tab-content">
        <div class="tab-pane fade show active" id="panel-credits" role="tabpanel" aria-labelledby="tab-credits">
                {{ render(path('admin_revenue_statistics', { embed: 1, period: app.request.query.get('period') })) }}
            </div>
            <div class="tab-pane fade" id="panel-ecommerce" role="tabpanel" aria-labelledby="tab-ecommerce">
                {{ render(path('admin_shop_statistics', { embed: 1 })) }}
            </div>
            <div class="tab-pane fade" id="panel-abo" role="tabpanel" aria-labelledby="tab-abo">
                {{ render(path('admin_abo_statistics', { embed: 1 })) }}
            </div>
            <div class="tab-pane fade  " id="panel-vehicle" role="tabpanel" aria-labelledby="tab-vehicle">
                {{ render(path('admin_vehicle_usage_statistics', { embed: 1 })) }}
            </div>
            
            <div class="tab-pane fade" id="panel-dyno" role="tabpanel" aria-labelledby="tab-dyno">
                {{ render(controller('App\\Controller\\Admin\\DynoStatsController::index', { embed: 1 })) }}
            </div>
        </div>
    </div>
{% endblock %}

{% block body_javascript %}
    {{ parent() }}

    {% guard function csp_nonce %}
        <script nonce="{{ csp_nonce('script') }}">
            (() => {
                const tabs = document.querySelectorAll('#admin-stats-tabs [data-bs-toggle="tab"]');
                if (!tabs.length) {
                    return;
                }

                tabs.forEach((tab) => {
                    tab.addEventListener('shown.bs.tab', () => {
                        window.dispatchEvent(new Event('resize'));
                    });
                });
            })();
        </script>
    {% else %}
        <script>
            (() => {
                const tabs = document.querySelectorAll('#admin-stats-tabs [data-bs-toggle="tab"]');
                if (!tabs.length) {
                    return;
                }

                tabs.forEach((tab) => {
                    tab.addEventListener('shown.bs.tab', () => {
                        window.dispatchEvent(new Event('resize'));
                    });
                });
            })();
        </script>
    {% endguard %}
{% endblock %}
