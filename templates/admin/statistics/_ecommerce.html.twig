<div class="container-fluid px-0">
    <div class="row g-3 mb-3">
        {% for item in kpis %}
            <div class="col-12 col-md-6 col-xl-2">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted small">{{ item.label }}</div>
                        {% if item.format == 'money' %}
                            <div class="h4 mb-0">{{ item.value|number_format(2, ',', '.') }} €</div>
                        {% else %}
                            <div class="h4 mb-0">{{ item.value|number_format(0, ',', '.') }}</div>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12 col-xl-8">
            <div class="card border-0 shadow-sm h-100 chart-card">
                <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
                    <span>Bestellungen pro Monat</span>
                    <span class="small text-muted">letzte 12 Monate</span>
                </div>
                <div class="card-body" style="height: 320px;">
                    {{ render_chart(ordersChart) }}
                </div>
            </div>
        </div>
        <div class="col-12 col-xl-4">
            <div class="card border-0 shadow-sm h-100 chart-card">
                <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
                    <span>Zahlungsarten</span>
                    <span class="small text-muted">letzte 12 Monate</span>
                </div>
                <div class="card-body" style="height: 320px;">
                    {{ render_chart(methodChart) }}
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12">
            <div class="card border-0 shadow-sm h-100 chart-card">
                <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
                    <span>Umsatz pro Monat</span>
                    <span class="small text-muted">letzte 12 Monate</span>
                </div>
                <div class="card-body" style="height: 320px;">
                    {{ render_chart(revenueChart) }}
                </div>
            </div>
        </div>
    </div>
</div>
