{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}AI Chat (Test){% endblock %}

{% block main %}
    <div class="container-fluid px-0 tfd-ai-chat">
        {% if error %}
            <div class="alert alert-danger">{{ error }}</div>
        {% endif %}

        <div class="row g-3">
            <div class="col-12 col-lg-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <strong>Chats</strong>
                        <form method="post" class="m-0">
                            <input type="hidden" name="_token" value="{{ csrf_token('admin_ai_chat') }}">
                            <input type="hidden" name="new_chat" value="1">
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Neu</button>
                        </form>
                    </div>
                    <div class="list-group list-group-flush tfd-ai-chat-list">
                        {% for session in sessions %}
                            <a href="{{ path('admin_ai_chat', { chat: session.id }) }}"
                               class="list-group-item list-group-item-action {{ session.id == activeChatId ? 'active' : '' }}">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div class="fw-semibold text-truncate">
                                        {{ session.title ?: ('Chat #' ~ session.id) }}
                                    </div>
                                    <small class="text-muted text-nowrap">{{ session.updatedAt|date('d.m.Y H:i') }}</small>
                                </div>
                                <div class="small text-muted text-truncate">
                                    {{ session.preview ?: 'Noch keine Nachrichten' }}
                                </div>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-9">
                <div class="card border-0 shadow-sm">
                    <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <div>
                            <strong>Symfony AI Chat</strong>
                            <div class="text-muted small">Platform Component Test</div>
                        </div>
                        <form method="post" class="m-0">
                            <input type="hidden" name="_token" value="{{ csrf_token('admin_ai_chat') }}">
                            <input type="hidden" name="chatId" value="{{ activeChatId }}">
                            <input type="hidden" name="clear" value="1">
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Verlauf löschen</button>
                        </form>
                    </div>
                    <div class="card-body">
                        <div class="tfd-ai-chat-log mb-3">
                            {% if messages is empty %}
                                <div class="text-muted">Noch keine Nachrichten. Stelle eine Frage…</div>
                            {% else %}
                                {% for message in messages %}
                                    <div class="d-flex mb-3 {{ message.role == 'user' ? 'justify-content-end' : 'justify-content-start' }}">
                                        <div class="tfd-ai-chat-bubble {{ message.role == 'user' ? 'tfd-ai-chat-bubble--user' : 'tfd-ai-chat-bubble--assistant' }}">
                                            {{ message.content|e|nl2br }}
                                        </div>
                                    </div>
                                {% endfor %}
                            {% endif %}
                        </div>

                        <form method="post" class="tfd-ai-chat-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('admin_ai_chat') }}">
                            <input type="hidden" name="chatId" value="{{ activeChatId }}">
                            <div class="input-group">
                                <input type="text" name="message" class="form-control" placeholder="Nachricht eingeben…">
                                <button type="submit" class="btn btn-tuningfux">Senden</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
