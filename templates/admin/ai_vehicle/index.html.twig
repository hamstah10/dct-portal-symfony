{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}AI Fahrzeugdatenbank{% endblock %}

{% block main %}
    <div class="container-fluid px-0 tfd-ai-vehicle">
        {% if error %}
            <div class="alert alert-danger">{{ error }}</div>
        {% endif %}

        <div class="row g-3">
            <div class="col-12 col-xl-4">
                <div class="d-flex flex-column gap-3">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header">
                            <strong>Verlauf</strong>
                        </div>
                        <div class="list-group list-group-flush tfd-ai-vehicle-list">
                            {% if runs is empty %}
                                <div class="p-3 text-muted">Noch keine Runs.</div>
                            {% else %}
                                {% for run in runs %}
                                    <a href="{{ path('admin_ai_vehicle', { run: run.id }) }}"
                                       class="list-group-item list-group-item-action {{ run.id == activeRunId ? 'active' : '' }}">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <span class="badge bg-secondary text-uppercase">{{ run.sourceType }}</span>
                                            <small class="text-muted text-nowrap">{{ run.updatedAt|date('d.m.Y H:i') }}</small>
                                        </div>
                                        <div class="fw-semibold text-truncate">{{ run.preview ?: 'Ohne Daten' }}</div>
                                        <div class="small text-muted text-truncate">
                                            {{ run.originalName ?? '' }}
                                        </div>
                                        {% if run.previewCount > 1 %}
                                            <div class="small text-muted">Seiten: {{ run.previewCount }}</div>
                                        {% endif %}
                                        {% if run.error %}
                                            <div class="small text-danger text-truncate">Fehler gespeichert</div>
                                        {% endif %}
                                    </a>
                                {% endfor %}
                            {% endif %}
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm">
                        <div class="card-header">
                            <strong>Fahrzeugschein OCR</strong>
                            <div class="text-muted small">Bild oder PDF hochladen und Daten auslesen</div>
                        </div>
                        <div class="card-body">
                            <form method="post" enctype="multipart/form-data">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin_ai_vehicle') }}">
                                <div class="mb-3">
                                    <label class="form-label">Fahrzeugschein (Bild/PDF)</label>
                                    <input type="file" name="document" class="form-control" accept="image/*,application/pdf">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">AI Modell</label>
                                    <input type="text" name="modelName" class="form-control" value="{{ modelName }}">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Treffer-Limit</label>
                                    <input type="number" name="limit" class="form-control" min="1" max="50" value="{{ limit }}">
                                </div>

                                <hr>
                                <div class="text-muted small mb-2">Manuelle Kriterien (ueberschreiben OCR)</div>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <input type="text" name="brand" class="form-control" placeholder="Hersteller" value="{{ manual.brand ?? '' }}">
                                    </div>
                                    <div class="col-6">
                                        <input type="text" name="series" class="form-control" placeholder="Baureihe" value="{{ manual.series ?? '' }}">
                                    </div>
                                    <div class="col-6">
                                        <input type="text" name="model" class="form-control" placeholder="Modell" value="{{ manual.model ?? '' }}">
                                    </div>
                                    <div class="col-6">
                                        <input type="text" name="engineCode" class="form-control" placeholder="Motorcode" value="{{ manual.engineCode ?? '' }}">
                                    </div>
                                    <div class="col-6">
                                        <input type="text" name="engineName" class="form-control" placeholder="Motorname" value="{{ manual.engineName ?? '' }}">
                                    </div>
                                    <div class="col-6">
                                        <input type="text" name="fuel" class="form-control" placeholder="Kraftstoff" value="{{ manual.fuel ?? '' }}">
                                    </div>
                                    <div class="col-6">
                                        <input type="text" name="displacement" class="form-control" placeholder="Hubraum (cm3)" value="{{ manual.displacement ?? '' }}">
                                    </div>
                                    <div class="col-6">
                                        <input type="number" name="powerKw" class="form-control" placeholder="Leistung (kW)" value="{{ manual.powerKw ?? '' }}">
                                    </div>
                                    <div class="col-6">
                                        <input type="number" name="powerHp" class="form-control" placeholder="Leistung (PS)" value="{{ manual.powerHp ?? '' }}">
                                    </div>
                                </div>

                                <div class="mt-3">
                                    <button type="submit" class="btn btn-tuningfux">Suchen</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center gap-2">
                            <strong>Erkannte Daten</strong>
                            {% if activeRunId > 0 %}
                                <form method="post">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_ai_vehicle') }}">
                                    <input type="hidden" name="delete_run" value="1">
                                    <input type="hidden" name="runId" value="{{ activeRunId }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Scan loeschen</button>
                                </form>
                            {% endif %}
                        </div>
                    </div>
                    <div class="card-body">
                        {% if previewPaths is not empty %}
                            <div class="tfd-ai-vehicle-preview-grid mb-3">
                                {% for path in previewPaths %}
                                    <a href="{{ asset(path) }}" target="_blank" rel="noopener">
                                        <img src="{{ asset(path) }}" alt="" class="tfd-ai-vehicle-preview img-fluid">
                                    </a>
                                {% endfor %}
                            </div>
                        {% elseif previewPath %}
                            <div class="mb-3">
                                <img src="{{ asset(previewPath) }}" alt="" class="tfd-ai-vehicle-preview">
                            </div>
                        {% endif %}

                        {% if documentPath %}
                            <div class="small mb-2">
                                <a href="{{ asset(documentPath) }}" target="_blank" rel="noopener">Dokument oeffnen</a>
                            </div>
                        {% endif %}

                        {% if extracted %}
                            <table class="table table-sm align-middle mb-3">
                                <tbody>
                                <tr>
                                    <th class="text-nowrap">Hersteller</th>
                                    <td>{{ extracted.brand ?? '-' }}</td>
                                </tr>
                                <tr>
                                    <th class="text-nowrap">Baureihe</th>
                                    <td>{{ extracted.series ?? '-' }}</td>
                                </tr>
                                <tr>
                                    <th class="text-nowrap">Modell</th>
                                    <td>{{ extracted.model ?? '-' }}</td>
                                </tr>
                                <tr>
                                    <th class="text-nowrap">Motorcode</th>
                                    <td>{{ extracted.engineCode ?? '-' }}</td>
                                </tr>
                                <tr>
                                    <th class="text-nowrap">Motorname</th>
                                    <td>{{ extracted.engineName ?? '-' }}</td>
                                </tr>
                                <tr>
                                    <th class="text-nowrap">Leistung</th>
                                    <td>{{ extracted.powerKw ?? '-' }} kW / {{ extracted.powerHp ?? '-' }} PS</td>
                                </tr>
                                <tr>
                                    <th class="text-nowrap">Kraftstoff</th>
                                    <td>{{ extracted.fuel ?? '-' }}</td>
                                </tr>
                                <tr>
                                    <th class="text-nowrap">Hubraum</th>
                                    <td>{{ extracted.displacement ?? '-' }}</td>
                                </tr>
                                <tr>
                                    <th class="text-nowrap">FIN</th>
                                    <td>{{ extracted.vin ?? '-' }}</td>
                                </tr>
                                <tr>
                                    <th class="text-nowrap">Erstzulassung</th>
                                    <td>{{ extracted.firstRegistration ?? '-' }}</td>
                                </tr>
                                </tbody>
                            </table>
                        {% else %}
                            <div class="text-muted">Noch keine OCR-Daten.</div>
                        {% endif %}

                        {% if criteriaUsed is not empty %}
                            <div class="small text-muted mb-2">Suchkriterien</div>
                            <table class="table table-sm align-middle mb-3">
                                <tbody>
                                {% set labels = {
                                    'brand': 'Hersteller',
                                    'series': 'Baureihe',
                                    'model': 'Modell',
                                    'engineCode': 'Motorcode',
                                    'engineName': 'Motorname',
                                    'fuel': 'Kraftstoff',
                                    'displacement': 'Hubraum',
                                    'powerKw': 'Leistung (kW)',
                                    'powerHp': 'Leistung (PS)'
                                } %}
                                {% for key, value in criteriaUsed %}
                                    <tr>
                                        <th class="text-nowrap">{{ labels[key] ?? key }}</th>
                                        <td>{{ value }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        {% endif %}

                        {% if rawText %}
                            <div class="small text-muted mb-2">Transkription</div>
                            <pre class="tfd-ai-vehicle-text">{{ rawText }}</pre>
                        {% endif %}

                        {% if rawResponse %}
                            <details class="mt-2">
                                <summary class="small text-muted">Antwort (JSON)</summary>
                                <pre class="tfd-ai-vehicle-text">{{ rawResponse }}</pre>
                            </details>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header">
                        <strong>Treffer &amp; Stages</strong>
                    </div>
                    <div class="card-body">
                        {% if criteriaUsed is empty %}
                            <div class="text-muted">Bitte Fahrzeugschein hochladen oder Kriterien eingeben.</div>
                        {% elseif results is empty %}
                            <div class="alert alert-warning mb-0">Keine passenden Fahrzeuge gefunden.</div>
                        {% else %}
                            <div class="d-flex flex-column gap-3">
                                {% for engine in results %}
                                    <div class="tfd-ai-vehicle-result">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <div>
                                                <div class="fw-semibold">
                                                    <a href="{{ engine.detailUrl }}">{{ engine.name }}</a>
                                                </div>
                                                <div class="text-muted small">
                                                    {{ engine.brand ?? '-' }} / {{ engine.series ?? '-' }} / {{ engine.model ?? '-' }}
                                                </div>
                                                <div class="small text-muted">
                                                    Motorcode: {{ engine.engineCode ?? '-' }}
                                                    / {{ engine.fuel ?? '-' }}
                                                    / {{ engine.displacement ?? '-' }}
                                                    / {{ engine.horsepower ?? '-' }} PS
                                                </div>
                                            </div>
                                            <span class="badge bg-secondary">{{ engine.score|number_format(2, '.', ',') }}</span>
                                        </div>

                                        <div class="mt-2">
                                            {% if engine.stages is empty %}
                                                <div class="text-muted small">Keine Stages vorhanden.</div>
                                            {% else %}
                                                <div class="list-group list-group-flush tfd-ai-vehicle-stage-list">
                                                    {% for stage in engine.stages %}
                                                        <a href="{{ stage.detailUrl }}" class="list-group-item list-group-item-action d-flex align-items-center gap-2">
                                                            {% if stage.icon %}
                                                                <img src="{{ asset(stage.icon) }}" alt="" class="img-fluid tfd-ai-vehicle-stage-icon" width="50">
                                                            {% endif %}
                                                            <div class="flex-grow-1">
                                                                <div class="fw-semibold">{{ stage.name }}</div>
                                                                <div class="small text-muted">
                                                                    PS: {{ stage.hp ?? '-' }} / NM: {{ stage.nm ?? '-' }}{% if stage.price %} / {{ stage.price }}{% endif %}
                                                                </div>
                                                            </div>
                                                            <span class="badge {{ stage.active ? 'bg-success' : 'bg-secondary' }}">
                                                                {{ stage.active ? 'Aktiv' : 'Inaktiv' }}
                                                            </span>
                                                        </a>
                                                    {% endfor %}
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
