{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Master-ECU zuordnen{% endblock %}

{% block main %}
    <div style="max-width:600px;">
        <p class="text-muted mb-4">
            <strong>{{ ids|length }} ECU(s)</strong> ausgewählt. Wähle eine Master-ECU aus — sie wird allen markierten ECUs zugeordnet.
        </p>

        <form method="post">
            <input type="hidden" name="ids" value="{{ idsParam }}">
            <input type="hidden" name="_token" value="{{ csrf_token('ecu_assign_master') }}">

            <div class="mb-4">
                <label for="masterEcuId" class="form-label fw-semibold">Master-ECU</label>
                <select id="masterEcuId" name="masterEcuId" class="form-select" required>
                    <option value="">— Master-ECU auswählen —</option>
                    {% for master in masterOptions %}
                        <option value="{{ master.id }}">
                            {{ master.name }}{% if master.type %} · {{ master.type }}{% endif %}{% if master.manufacturerMaster %} ({{ master.manufacturerMaster.name }}){% endif %}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Zuordnen</button>
                <a href="{{ referrer }}" class="btn btn-secondary">Abbrechen</a>
            </div>
        </form>
    </div>

    <script>
    (function () {
        const sel = document.getElementById('masterEcuId');
        if (typeof bootstrap !== 'undefined' || !sel) return;

        sel.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                sel.closest('form').submit();
            }
        });
    })();
    </script>
{% endblock %}
