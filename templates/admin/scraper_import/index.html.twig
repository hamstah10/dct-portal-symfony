{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{{ pageTitle|default('Scraper Import') }}{% endblock %}

{% block main %}
<div class="container-fluid px-0">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white fw-semibold">JSON importieren</div>
        <div class="card-body">
            {% if errors is not empty %}
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        {% for error in errors %}
                            <li>{{ error }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            <form method="post">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token(formCsrfTokenId|default('admin_scraper_import')) }}">
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label">JSON-Datei</label>
                        <select name="json_file" class="form-select">
                            <option value="">Bitte wählen</option>
                            {% for file in jsonFiles %}
                                <option value="{{ file.path }}" {{ selectedJson == file.path ? 'selected' : '' }}>
                                    {{ file.name }} — {{ file.mtime|date('Y-m-d H:i:s') }}
                                </option>
                            {% endfor %}
                        </select>
                        {% if selectedJson %}
                            <small class="text-muted">aktuell gewählt: {{ selectedJson }}</small>
                        {% endif %}
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Datenpool</label>
                        <select name="pool_id" class="form-select">
                            <option value="">Bitte wählen</option>
                            {% for pool in pools %}
                                <option value="{{ pool.id }}" {{ selectedPoolId == pool.id ? 'selected' : '' }}>
                                    {{ pool.name }} ({{ pool.poolKey }})
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Vorschau</button>
                    <button type="submit" name="confirm" value="1" class="btn btn-success" {% if preview is empty %}disabled{% endif %}>Importieren</button>
                </div>
            </form>
        </div>
    </div>

    {% if preview %}
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-header bg-white fw-semibold">Vorschau</div>
            <div class="card-body">
                    <p class="mb-3">
                        <strong>Datei:</strong> {{ preview.file.name }}<br>
                        <strong>Typ:</strong> {{ preview.analysis.type|default('unbekannt') }}<br>
                        <strong>Marken:</strong> {{ preview.analysis.brandCount }} (Pool: {{ preview.pool ? preview.pool.name : '–' }})
                    </p>

                <div class="table-responsive">
                    <table class="table table-striped table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Marke</th>
                                <th class="text-end">Modelle</th>
                                <th class="text-end">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for brand in preview.brands %}
                                {% set badgeState = brand.inPool ? 'success' : (brand.exists ? 'info' : 'warning') %}
                                {% set badgeLabel = brand.inPool ? 'Bereits im Pool' : (brand.exists ? 'Im System (noch nicht im Pool)' : 'Neu (im System nicht gefunden)') %}
                                <tr>
                                    <td>{{ brand.name ?: brand.slug ?: '–' }}</td>
                                    <td class="text-end">{{ brand.model_count }}</td>
                                    <td class="text-end">
                                        <span class="badge text-bg-{{ badgeState }}">{{ badgeLabel }}</span>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% endif %}

    {% if logs is not empty %}
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-header bg-white fw-semibold">Import Historie ({{ logs|length }})</div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Datum</th>
                            <th>Datei</th>
                            <th>Quelle</th>
                            <th>Pool</th>
                            <th>Status</th>
                            <th>Marken</th>
                            <th class="text-end">Aktion</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for log in logs %}
                            <tr>
                                <td>{{ log.createdAt|date('Y-m-d H:i:s') }}</td>
                                <td>{{ log.fileName }}</td>
                                <td>{{ log.source|title }}</td>
                                <td>{{ log.vehicleDataPool ?: '–' }}</td>
                                <td>
                                    <span class="badge text-bg-{{ log.status == 'imported' ? 'success' : 'secondary' }}">{{ log.status|title }}</span>
                                </td>
                                <td>{{ log.brandCount }}</td>
                                <td class="text-end">
                                    <form method="post" action="{{ path(deleteLogRoute|default('admin_scraper_import_log_delete'), { id: log.id }) }}" onsubmit="return confirm('Diesen Historie-Eintrag wirklich löschen?');" class="d-inline">
                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token(deleteLogCsrfTokenId) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Löschen</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
