{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{{ pageTitle|default('Scraper Import Output') }}{% endblock %}

{% block main %}
<div class="container-fluid px-0">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white fw-semibold">JSON aus Output importieren</div>
        <div class="card-body">
            {% if errors is not empty %}
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        {% for error in errors %}
                            <li>{{ error }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            {% if importResult %}
                <div class="alert alert-success">
                    {{ importResult.files }} Datei(en) importiert.
                    Modelle: {{ importResult.models }},
                    Motoren: {{ importResult.engines }},
                    neu: {{ importResult.created }},
                    aktualisiert: {{ importResult.updated }},
                    unverändert: {{ importResult.unchanged }}.
                </div>
            {% endif %}

            <form method="post">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token(formCsrfTokenId|default('admin_scraper_output_import')) }}">
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label">Datenpool</label>
                        <select name="pool_id" class="form-select">
                            <option value="">Bitte wählen</option>
                            {% for pool in pools %}
                                <option value="{{ pool.id }}" {{ selectedPoolId == pool.id ? 'selected' : '' }}>
                                    {{ pool.name }} ({{ pool.poolKey }})
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="text-muted small pt-md-4">
                            Wähle einen oder mehrere Ordner/Dateien aus und starte danach Vorschau oder Import.
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    {% if groupedJsonFiles is empty %}
                        <div class="alert alert-warning mb-0">Im Output-Verzeichnis wurden keine JSON-Dateien gefunden.</div>
                    {% else %}
                        {% for folder, files in groupedJsonFiles %}
                            {% set tableId = 'output-import-' ~ loop.index %}
                            <div class="card border mb-3">
                                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                    <span class="fw-semibold text-uppercase">{{ folder }}</span>
                                    <span class="text-muted small">{{ files|length }} Datei(en)</span>
                                </div>
                                <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                                    <table class="table table-sm table-hover mb-0">
                                        <thead style="position: sticky; top: 0; z-index: 1;">
                                            <tr>
                                                <th style="width: 56px;">
                                                    <input
                                                        class="form-check-input js-select-all"
                                                        type="checkbox"
                                                        data-table-id="{{ tableId }}"
                                                    >
                                                </th>
                                                <th>Datei</th>
                                                <th>Status</th>
                                                <th class="text-end">Geändert</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for file in files %}
                                                {% set importedMeta = importedFiles[file.path] ?? null %}
                                                <tr>
                                                    <td>
                                                        <input
                                                            class="form-check-input js-file-checkbox"
                                                            type="checkbox"
                                                            name="json_files[]"
                                                            value="{{ file.selectionKey }}"
                                                            data-table-id="{{ tableId }}"
                                                            {{ file.selectionKey in selectedFileKeys ? 'checked' : '' }}
                                                        >
                                                    </td>
                                                    <td>{{ file.displayName }}</td>
                                                    <td>
                                                        {% if importedMeta %}
                                                            <span class="badge text-bg-success">Importiert</span>
                                                            <div class="text-muted small">
                                                                {{ importedMeta.createdAt }}{% if importedMeta.poolName %} · {{ importedMeta.poolName }}{% endif %}
                                                            </div>
                                                        {% else %}
                                                            <span class="badge text-bg-secondary">Neu</span>
                                                        {% endif %}
                                                    </td>
                                                    <td class="text-end">{{ file.mtime|date('Y-m-d H:i:s') }}</td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>

                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Vorschau</button>
                    <button type="submit" name="confirm" value="1" class="btn btn-success" {% if selectedFileKeys is empty %}disabled{% endif %}>Importieren</button>
                </div>
            </form>
        </div>
    </div>

    {% if preview %}
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-header bg-white fw-semibold">Vorschau</div>
            <div class="card-body">
                <p class="mb-3">
                    <strong>Dateien:</strong> {{ preview.files|length }}<br>
                    <strong>Typ:</strong> {{ preview.analysis.type|default('unbekannt') }}<br>
                    <strong>Marken:</strong> {{ preview.analysis.brandCount }} (Pool: {{ preview.pool ? preview.pool.name : '–' }})<br>
                    <strong>Gesamt:</strong>
                    Modelle {{ preview.analysis.totals.model_count }} ·
                    Versionen {{ preview.analysis.totals.version_count }} ·
                    Motoren {{ preview.analysis.totals.engine_count }} ·
                    Steuergeräte {{ preview.analysis.totals.controller_count }} ·
                    Optionen {{ preview.analysis.totals.option_count }} ·
                    Stages {{ preview.analysis.totals.stage_count }}
                </p>

                <div class="table-responsive">
                    <table class="table table-striped table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Marke</th>
                                <th class="text-end">Modelle</th>
                                <th class="text-end">Versionen</th>
                                <th class="text-end">Motoren</th>
                                <th class="text-end">Steuergeräte</th>
                                <th class="text-end">Optionen</th>
                                <th class="text-end">Stages</th>
                                <th class="text-end">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for brand in preview.brands %}
                                {% set badgeState = brand.inPool ? 'success' : (brand.exists ? 'info' : 'warning') %}
                                {% set badgeLabel = brand.inPool ? 'Bereits im Pool' : (brand.exists ? 'Im System (noch nicht im Pool)' : 'Neu (im System nicht gefunden)') %}
                                <tr>
                                    <td>{{ brand.name ?: brand.slug ?: '–' }}</td>
                                    <td class="text-end">{{ brand.model_count }}</td>
                                    <td class="text-end">{{ brand.version_count }}</td>
                                    <td class="text-end">{{ brand.engine_count }}</td>
                                    <td class="text-end">{{ brand.controller_count }}</td>
                                    <td class="text-end">{{ brand.option_count }}</td>
                                    <td class="text-end">{{ brand.stage_count }}</td>
                                    <td class="text-end">
                                        <span class="badge text-bg-{{ badgeState }}">{{ badgeLabel }}</span>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% endif %}

    {% if logs is not empty %}
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-header bg-white fw-semibold">Import Historie ({{ logs|length }})</div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Datum</th>
                            <th>Datei</th>
                            <th>Pool</th>
                            <th>Status</th>
                            <th>Marken</th>
                            <th class="text-end">Aktion</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for log in logs %}
                            <tr>
                                <td>{{ log.createdAt|date('Y-m-d H:i:s') }}</td>
                                <td>{{ log.fileName }}</td>
                                <td>{{ log.vehicleDataPool ?: '–' }}</td>
                                <td>
                                    <span class="badge text-bg-{{ log.status == 'imported' ? 'success' : 'secondary' }}">{{ log.status|title }}</span>
                                </td>
                                <td>{{ log.brandCount }}</td>
                                <td class="text-end">
                                    <form method="post" action="{{ path(deleteLogRoute, { id: log.id }) }}" onsubmit="return confirm('Diesen Historie-Eintrag wirklich löschen?');" class="d-inline">
                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token(deleteLogCsrfTokenId) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Löschen</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}

{% block body_javascript %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const syncSelectAllState = function (tableId) {
                const rowCheckboxes = Array.from(document.querySelectorAll('.js-file-checkbox[data-table-id="' + tableId + '"]'));
                const selectAll = document.querySelector('.js-select-all[data-table-id="' + tableId + '"]');
                if (!selectAll || rowCheckboxes.length === 0) {
                    return;
                }

                const checkedCount = rowCheckboxes.filter((checkbox) => checkbox.checked).length;
                selectAll.checked = checkedCount === rowCheckboxes.length;
                selectAll.indeterminate = checkedCount > 0 && checkedCount < rowCheckboxes.length;
            };

            document.querySelectorAll('.js-select-all').forEach(function (selectAll) {
                const tableId = selectAll.dataset.tableId;
                syncSelectAllState(tableId);

                selectAll.addEventListener('change', function () {
                    document.querySelectorAll('.js-file-checkbox[data-table-id="' + tableId + '"]').forEach(function (checkbox) {
                        checkbox.checked = selectAll.checked;
                    });
                    syncSelectAllState(tableId);
                });
            });

            document.querySelectorAll('.js-file-checkbox').forEach(function (checkbox) {
                checkbox.addEventListener('change', function () {
                    syncSelectAllState(checkbox.dataset.tableId);
                });
            });
        });
    </script>
{% endblock %}
