{% block head_stylesheets %}
    {{ parent() }}

    <style>
        .tfd-project-board-shell {
            background: linear-gradient(180deg, #111931 0%, #16203d 100%);
        }

        .tfd-project-board-topbar {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
        }

        .tfd-project-board-actions {
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        .tfd-project-board-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 1rem 1.1rem;
            background: #16203d;
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .tfd-project-board-toolbar__search {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            flex: 1 1 26rem;
        }

        .tfd-project-board-toolbar__search .form-control {
            max-width: 24rem;
        }

        .tfd-project-board-toolbar__meta {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .tfd-project-toolbar-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 0.8rem;
            background: #1b2748;
            border: 1px solid rgba(255, 255, 255, 0.08);
            font-size: 0.82rem;
            color: #eaf0ff;
        }

        .tfd-project-toolbar-pill strong {
            display: inline-flex;
            min-width: 1.5rem;
            justify-content: center;
            padding: 0.12rem 0.3rem;
            background: #0f172a;
            color: #fff;
            font-size: 0.72rem;
        }

        .tfd-project-create-card {
            background: #16203d;
        }

        .tfd-project-board {
            display: grid;
            grid-template-columns: repeat(4, minmax(220px, 1fr));
            gap: 1rem;
        }

        .tfd-project-column {
            min-height: 24rem;
            
            
        }

        .tfd-project-column.is-drag-over {
            border-color: #1d4ed8;
            box-shadow: inset 0 0 0 2px rgba(29, 78, 216, 0.2);
        }

        .tfd-project-column__header {
            padding: 0.8rem 1rem;
            color: #fff;
        }

        .tfd-project-column--tone-1 .tfd-project-column__header {
            background: linear-gradient(90deg, #2359a8, #4b8ee8);
        }

        .tfd-project-column--tone-2 .tfd-project-column__header {
            background: linear-gradient(90deg, #9b3f9d, #d95dd7);
        }

        .tfd-project-column--tone-3 .tfd-project-column__header {
            background: linear-gradient(90deg, #d14b7d, #ff7d67);
        }

        .tfd-project-column--tone-4 .tfd-project-column__header {
            background: linear-gradient(90deg, #6647d6, #9f67f2);
        }

        .tfd-project-column__headline {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
        }

        .tfd-project-column__headline h3 {
            color: #ffffff !important;
        }

        .tfd-project-column__counter {
            display: inline-flex;
            min-width: 1.5rem;
            justify-content: center;
            padding: 0.12rem 0.38rem;
            background: rgba(15, 23, 42, 0.22);
            font-size: 0.72rem;
            font-weight: 700;
        }

        .tfd-project-column__cards {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            padding-top: 1rem;
        }

        .tfd-project-column__empty {
            padding: 1rem;
            border: 1px dashed rgba(255, 255, 255, 0.16);
            color: #aeb8d4;
            background: #16203d;
            text-align: center;
        }

        .tfd-project-card {
            cursor: grab;
            border: 1px solid rgba(255, 255, 255, 0.08);
            background: #16203d;
            color: #eaf0ff;
        }

        .tfd-project-card.is-dragging {
            opacity: 0.65;
            transform: rotate(1deg);
        }

        .tfd-project-card__eyebrow {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            margin-bottom: 0.85rem;
            font-size: 0.72rem;
            text-transform: uppercase;
            color: #aeb8d4;
        }

        .tfd-project-card__menu {
            border: 0;
            background: #243152;
            width: 2rem;
            height: 2rem;
            color: #ffffff;
            font-weight: 700;
        }

        .tfd-project-card__tags {
            display: flex;
            gap: 0.4rem;
            flex-wrap: wrap;
            margin-bottom: 1rem;
        }

        .tfd-project-card__tag {
            display: inline-flex;
            align-items: center;
            padding: 0.22rem 0.5rem;
            background: #243152;
            color: #ffffff;
            font-size: 0.7rem;
            font-weight: 600;
        }

        .tfd-project-card__tag--soft {
            background: rgba(189, 30, 33, 0.16);
            color: #ffb4b6;
        }

        .tfd-project-card__images {
            display: flex;
            gap: 0.45rem;
            margin-bottom: 1rem;
        }

        .tfd-project-card__images img {
            width: 3rem;
            height: 3rem;
            object-fit: cover;
            border: 1px solid rgba(255, 255, 255, 0.12);
        }

        .tfd-project-card__footer {
            padding-top: 0.9rem;
            border-top: 1px dashed rgba(255, 255, 255, 0.12);
        }

        .tfd-project-upload-dropzone {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 7rem;
            padding: 1.25rem;
            border: 2px dashed rgba(255, 255, 255, 0.12);
            background: #1b2748;
            color: #eaf0ff;
            text-align: center;
            cursor: pointer;
        }

        .tfd-project-upload-dropzone.is-dragover {
            border-color: #dc2626;
            background: #2a1620;
        }

        .tfd-project-board-shell .text-muted,
        .tfd-project-board-shell .small,
        .tfd-project-board-shell .small.text-uppercase {
            color: #aeb8d4 !important;
        }

        .tfd-project-board-shell h3,
        .tfd-project-board-shell h4,
        .tfd-project-board-shell p,
        .tfd-project-board-shell label,
        .tfd-project-board-shell summary {
            color: #ffffff !important;
        }

        .tfd-project-board-shell .form-control,
        .tfd-project-board-shell .form-select,
        .tfd-project-board-shell textarea {
            background: #16203d !important;
            border: 1px solid rgba(255, 255, 255, 0.12) !important;
            color: #ffffff !important;
        }

        .tfd-project-board-shell .form-control::placeholder,
        .tfd-project-board-shell textarea::placeholder {
            color: #aeb8d4 !important;
        }

        .tfd-project-board-shell .modal-content,
        .tfd-project-board-shell .modal-header,
        .tfd-project-board-shell .modal-body {
            background: #16203d !important;
            color: #ffffff !important;
        }

        .tfd-project-board-shell .btn-close {
            filter: invert(1);
        }

        .tfd-project-upload-dropzone input {
            display: none;
        }

        .tfd-project-modal-form .form-label {
            margin-bottom: 0.55rem;
            font-size: 0.95rem;
        }

        .tfd-project-modal-field {
            display: flex;
            flex-direction: column;
        }

        .tfd-project-modal-field .form-control,
        .tfd-project-modal-field .form-select {
            min-height: 3.25rem;
        }

        .tfd-project-modal-field textarea.form-control {
            min-height: 7rem;
        }

        .tfd-project-modal-field--spacer {
            min-height: 1px;
        }

        .tfd-project-card summary {
            cursor: pointer;
            list-style: none;
        }

        .tfd-project-card summary::-webkit-details-marker {
            display: none;
        }

        @media (max-width: 1399px) {
            .tfd-project-board {
                grid-template-columns: repeat(2, minmax(260px, 1fr));
            }
        }

        @media (max-width: 991px) {
            .tfd-project-board-topbar,
            .tfd-project-board-toolbar,
            .tfd-project-board-toolbar__search {
                flex-direction: column;
                align-items: stretch;
            }

            .tfd-project-board-toolbar__search .form-control {
                max-width: none;
            }
        }

        @media (max-width: 767px) {
            .tfd-project-board {
                grid-template-columns: 1fr;
            }

            .tfd-project-modal-field--spacer {
                display: none;
            }
        }
    </style>
{% endblock %}
