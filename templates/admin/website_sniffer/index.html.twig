{% extends 'bundles/EasyAdminBundle/crud/index.html.twig' %}

{% block main %}
    {% if snifferProgressEnabled|default(false) %}
        <div class="card border-0 shadow-sm rounded-0 mb-3" data-sniffer-inline-progress
             data-status-url="{{ snifferProgressStatusUrl|default('') }}"
             data-run-detail-url="{{ snifferProgressRunDetailUrl|default('') }}"
             data-pages-url="{{ snifferProgressPagesUrl|default('') }}">
            <div class="card-body py-3">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                    <div>
                        <h3 class="h6 mb-1">Sniffer-Lauf: {{ snifferProgressRunName|default('Sniffer') }} (#{{ snifferProgressRunId|default(0) }})</h3>
                        <div class="small text-muted">Live-Fortschritt</div>
                    </div>
                    {% set status = snifferProgressStatus|default('running') %}
                    <span class="badge rounded-0 {% if status == 'success' %}text-bg-success{% elseif status == 'failed' %}text-bg-danger{% else %}text-bg-warning{% endif %}" data-sniffer-inline-status-badge>
                        {% if status == 'success' %}Erfolgreich{% elseif status == 'failed' %}Fehlgeschlagen{% else %}Laufend{% endif %}
                    </span>
                </div>

                <div class="progress rounded-0" role="progressbar" aria-label="Sniffer Fortschritt" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ snifferProgressPercent|default(0) }}" style="height: 18px;">
                    {% set percent = snifferProgressPercent|default(0) %}
                    {% set progressClass = status == 'success' ? 'bg-success' : (status == 'failed' ? 'bg-danger' : 'progress-bar-striped progress-bar-animated') %}
                    <div class="progress-bar {{ progressClass }}" data-sniffer-inline-progress-bar style="width: {{ percent }}%;">{{ percent }}%</div>
                </div>

                <div class="mt-2 d-flex flex-wrap gap-3 small">
                    <div><strong>Bearbeitet:</strong> <span data-sniffer-inline-pages>{{ snifferProgressProcessedPages|default(0) }} / {{ snifferProgressTotalPages|default(0) }}</span></div>
                    <div><strong>Gefundene Seiten:</strong> <span data-sniffer-inline-found>{{ snifferProgressPagesCount|default(0) }}</span></div>
                    <div class="d-flex gap-2">
                        <a href="{{ snifferProgressRunDetailUrl|default('#') }}" class="btn btn-primary btn-sm rounded-0" data-sniffer-inline-run-btn>Zum Lauf</a>
                        <a href="{{ snifferProgressPagesUrl|default('#') }}" class="btn btn-primary btn-sm rounded-0{% if (snifferProgressPagesCount|default(0)) <= 0 %} d-none{% endif %}" data-sniffer-inline-pages-btn>Geparste Seiten</a>
                    </div>
                </div>

                <div class="mt-2 small text-danger {% if not snifferProgressError|default('') %}d-none{% endif %}" data-sniffer-inline-error>{{ snifferProgressError|default('') }}</div>
            </div>
        </div>

        <script>
            (function () {
                const root = document.querySelector('[data-sniffer-inline-progress]');
                if (!root) {
                    return;
                }

                const statusUrl = root.dataset.statusUrl || '';
                const progressBar = root.querySelector('[data-sniffer-inline-progress-bar]');
                const statusBadge = root.querySelector('[data-sniffer-inline-status-badge]');
                const pagesInfo = root.querySelector('[data-sniffer-inline-pages]');
                const foundInfo = root.querySelector('[data-sniffer-inline-found]');
                const errorBox = root.querySelector('[data-sniffer-inline-error]');
                const runButton = root.querySelector('[data-sniffer-inline-run-btn]');
                const pagesButton = root.querySelector('[data-sniffer-inline-pages-btn]');

                if (!statusUrl || !progressBar || !statusBadge || !pagesInfo || !foundInfo) {
                    return;
                }

                let pollTimer = null;

                const applyPayload = (payload) => {
                    const status = String(payload.status || 'running');
                    const percent = Math.max(0, Math.min(100, Number(payload.progressPercent || 0)));
                    const processed = Number(payload.processedPages || 0);
                    const total = Number(payload.totalPages || 0);
                    const found = Number(payload.pagesCount || 0);

                    progressBar.style.width = percent + '%';
                    progressBar.textContent = percent + '%';
                    progressBar.setAttribute('aria-valuenow', String(percent));
                    pagesInfo.textContent = processed + ' / ' + total;
                    foundInfo.textContent = String(found);

                    if (runButton && payload.runDetailUrl) {
                        runButton.href = String(payload.runDetailUrl);
                    }

                    if (pagesButton) {
                        if (payload.pagesUrl && found > 0) {
                            pagesButton.href = String(payload.pagesUrl);
                            pagesButton.classList.remove('d-none');
                        } else {
                            pagesButton.classList.add('d-none');
                        }
                    }

                    progressBar.classList.remove('bg-success', 'bg-danger', 'progress-bar-striped', 'progress-bar-animated');

                    if (status === 'success') {
                        statusBadge.className = 'badge rounded-0 text-bg-success';
                        statusBadge.textContent = 'Erfolgreich';
                        progressBar.classList.add('bg-success');
                        if (percent < 100) {
                            progressBar.style.width = '100%';
                            progressBar.textContent = '100%';
                        }
                        if (pollTimer) {
                            window.clearInterval(pollTimer);
                            pollTimer = null;
                        }
                    } else if (status === 'failed') {
                        statusBadge.className = 'badge rounded-0 text-bg-danger';
                        statusBadge.textContent = 'Fehlgeschlagen';
                        progressBar.classList.add('bg-danger');
                        if (errorBox) {
                            const message = String(payload.errorMessage || '').trim();
                            if (message) {
                                errorBox.classList.remove('d-none');
                                errorBox.textContent = message;
                            }
                        }
                        if (pollTimer) {
                            window.clearInterval(pollTimer);
                            pollTimer = null;
                        }
                    } else {
                        statusBadge.className = 'badge rounded-0 text-bg-warning';
                        statusBadge.textContent = 'Laufend';
                        progressBar.classList.add('progress-bar-striped', 'progress-bar-animated');
                    }
                };

                const refresh = async () => {
                    try {
                        const response = await fetch(statusUrl, {
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            cache: 'no-store'
                        });

                        if (!response.ok) {
                            throw new Error('Statusabfrage fehlgeschlagen');
                        }

                        const payload = await response.json();
                        applyPayload(payload);
                    } catch (_error) {
                        if (errorBox) {
                            errorBox.classList.remove('d-none');
                            errorBox.textContent = 'Ladebalken konnte nicht aktualisiert werden.';
                        }
                    }
                };

                refresh();
                pollTimer = window.setInterval(refresh, 1200);
            })();
        </script>
    {% endif %}

    {{ parent() }}
{% endblock %}
