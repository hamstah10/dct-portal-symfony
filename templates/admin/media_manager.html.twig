{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Media Manager{% endblock %}

{% block main %}
<div class="container-fluid px-0">
    <div class="d-flex flex-wrap gap-2 mb-3">
        <a href="{{ path('admin_media_folder_new') }}" class="btn btn-primary"><i class="fa fa-folder-plus"></i> Neuer Ordner</a>
        <a href="{{ path('admin_media_asset_new') }}" class="btn btn-primary"><i class="fa fa-upload"></i> Neue Datei</a>
        <a href="{{ path('admin_media_manager_upload') }}" class="btn btn-success"><i class="fa fa-cloud-upload-alt"></i> Upload</a>
        <a href="{{ path('admin_media_folder_index') }}" class="btn btn-light border">Ordner-Verwaltung</a>
        <a href="{{ path('admin_media_asset_index') }}" class="btn btn-light border">Datei-Verwaltung</a>
    </div>

    <div class="row g-3">
        <div class="col-12 col-xl-3 col-xxl-2">
            <div class="card border-0 shadow-sm h-100" data-media-tree-scope>
                <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
                    <span>Ordnerbaum</span>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Ordnerbaum Aktionen">
                        <button type="button" class="btn btn-light border" data-tree-expand>Alle aufklappen</button>
                        <button type="button" class="btn btn-light border" data-tree-collapse>Alle zuklappen</button>
                    </div>
                </div>
                <div class="card-body">
                    <ul class="tfd-media-tree tfd-media-tree--meta mb-3">
                        <li class="tfd-media-tree__item {{ currentScope == 'all' and selectedFolderId == 0 ? 'is-selected' : '' }}">
                            <div class="tfd-media-tree__row">
                                <span class="tfd-media-tree__spacer"></span>
                                <a href="{{ path('admin_media_manager', { scope: 'all' }) }}" class="tfd-media-tree__link text-decoration-none">
                                    <i class="fa fa-layer-group tfd-media-tree__folder-icon"></i>
                                    <span>Alle Dateien</span>
                                </a>
                                <span class="badge text-bg-light tfd-media-tree__count">{{ totalAssets }}</span>
                            </div>
                        </li>
                        <li class="tfd-media-tree__item {{ currentScope == 'unassigned' ? 'is-selected' : '' }}">
                            <div class="tfd-media-tree__row">
                                <span class="tfd-media-tree__spacer"></span>
                                <a href="{{ path('admin_media_manager', { scope: 'unassigned' }) }}" class="tfd-media-tree__link text-decoration-none">
                                    <i class="fa fa-folder-open tfd-media-tree__folder-icon"></i>
                                    <span>Ohne Ordner</span>
                                </a>
                                <span class="badge text-bg-light tfd-media-tree__count">{{ unassignedAssets }}</span>
                            </div>
                        </li>
                    </ul>

                    {% if folderTree is empty %}
                        <div class="text-muted">Noch keine Ordner vorhanden.</div>
                    {% else %}
                        <ul class="tfd-media-tree tfd-media-tree--folders" data-media-tree>
                            {% for node in folderTree %}
                                {% include 'admin/partials/_media_folder_tree_node.html.twig' with {
                                    node: node,
                                    selectedFolderId: selectedFolderId,
                                    folderCounts: folderCounts
                                } only %}
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-9 col-xxl-10">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white p-0">
                    <ul class="nav nav-tabs tfd-media-tabs" id="media-manager-tabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="media-tab-files" data-bs-toggle="tab" data-bs-target="#media-pane-files" type="button" role="tab" aria-controls="media-pane-files" aria-selected="true">
                                Dateien <span class="badge text-bg-light ms-2">{{ assets|length }}</span>
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="media-tab-icons" data-bs-toggle="tab" data-bs-target="#media-pane-icons" type="button" role="tab" aria-controls="media-pane-icons" aria-selected="false">
                                UX Icons <span class="badge text-bg-light ms-2">{{ uxIconTotal }}</span>
                            </button>
                        </li>
                    </ul>
                </div>
                <div class="card-body p-0">
                    <div class="tab-content">
                        <div class="tab-pane fade show active" id="media-pane-files" role="tabpanel" aria-labelledby="media-tab-files">
                            <div class="px-3 pt-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="fw-semibold">
                                        {% if selectedFolder %}
                                            Dateien in <strong>{{ selectedFolder.fullPath }}</strong>
                                        {% else %}
                                            Dateien (alle)
                                        {% endif %}
                                    </div>
                                    <span class="badge text-bg-light">{{ filteredAssets }}</span>
                                </div>
                                {% if filteredAssets > 0 %}
                                    {% set firstItem = ((currentPage - 1) * itemsPerPage) + 1 %}
                                    {% set lastItem = min(currentPage * itemsPerPage, filteredAssets) %}
                                    <div class="small text-muted mt-1">
                                        Zeige {{ firstItem }}-{{ lastItem }} von {{ filteredAssets }}
                                    </div>
                                {% endif %}
                            </div>
                            <div class="p-3">
                                {% if assets is empty %}
                                    <div class="text-muted">Keine Dateien gefunden.</div>
                                {% else %}
                                    <div class="tfd-media-gallery">
                                        {% for asset in assets %}
                                            {% set fileUrl = asset.filePath ? ('/' ~ asset.filePath|trim('/')) : null %}
                                            {% set detailUrl = path('admin_media_asset_detail', { entityId: asset.id }) %}
                                            <div class="tfd-media-card">
                                                <a href="{{ detailUrl }}" class="tfd-media-card__preview text-decoration-none">
                                                    {% if fileUrl and asset.mediaType in ['image', 'icon'] %}
                                                        <img src="{{ fileUrl }}" alt="" class="tfd-media-card__image tfd-media-card__image--{{ asset.mediaType }}">
                                                    {% else %}
                                                        <span class="tfd-media-card__file-badge">{{ asset.mediaType|upper }}</span>
                                                    {% endif %}
                                                </a>
                                                <div class="tfd-media-card__body">
                                                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                                        <div class="min-w-0">
                                                            <a href="{{ detailUrl }}" class="tfd-media-card__title text-decoration-none text-reset">{{ asset.name }}</a>
                                                            {% if fileUrl %}
                                                                <a href="{{ fileUrl }}" target="_blank" rel="noopener" class="tfd-media-card__path">{{ asset.filePath|split('/')|last }}</a>
                                                            {% else %}
                                                                <div class="tfd-media-card__path text-muted">Keine Datei</div>
                                                            {% endif %}
                                                        </div>
                                                        <span class="badge text-bg-light shrink-0">{{ asset.mediaType }}</span>
                                                    </div>

                                                    {% if asset.mimeType %}
                                                        <div class="small text-muted mb-2">{{ asset.mimeType }}</div>
                                                    {% endif %}

                                                    <div class="small text-muted mb-3">
                                                        <i class="fa fa-folder-open me-1"></i>
                                                        {% if asset.folder %}
                                                            {{ asset.folder.fullPath }}
                                                        {% else %}
                                                            Ohne Ordner
                                                        {% endif %}
                                                    </div>

                                                    <form method="post" action="{{ path('admin_media_manager_move') }}" class="d-grid gap-2">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('media_manager_move') }}">
                                                        <input type="hidden" name="assetId" value="{{ asset.id }}">
                                                        <input type="hidden" name="currentFolder" value="{{ selectedFolderId }}">
                                                        <input type="hidden" name="currentScope" value="{{ currentScope }}">
                                                        <input type="hidden" name="currentPage" value="{{ currentPage }}">
                                                        <select name="folderId" class="form-select form-select-sm">
                                                            <option value="0" {% if asset.folder is null %}selected{% endif %}>Ohne Ordner</option>
                                                            {% for folderOption in folderOptions %}
                                                                <option value="{{ folderOption.id }}" {% if asset.folder and asset.folder.id == folderOption.id %}selected{% endif %}>{{ folderOption.label }}</option>
                                                            {% endfor %}
                                                        </select>
                                                        <div class="d-flex gap-2">
                                                            <button type="submit" class="btn btn-sm btn-outline-primary flex-fill">Verschieben</button>
                                                            <a class="btn btn-sm btn-light border" href="{{ detailUrl }}">Details</a>
                                                            <a class="btn btn-sm btn-light border" href="{{ path('admin_media_asset_edit', { entityId: asset.id }) }}">Bearbeiten</a>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                            {% if totalPages > 1 %}
                                {% set pageParams = { scope: currentScope } %}
                                {% if currentScope == 'all' and selectedFolderId > 0 %}
                                    {% set pageParams = pageParams|merge({ folder: selectedFolderId }) %}
                                {% endif %}
                                {% set pageStart = max(1, currentPage - 2) %}
                                {% set pageEnd = min(totalPages, currentPage + 2) %}
                                <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center px-3 py-3 border-top">
                                    <div class="small text-muted">Seite {{ currentPage }} von {{ totalPages }}</div>
                                    <nav aria-label="Dateien Pagination">
                                        <ul class="pagination pagination-sm mb-0">
                                            <li class="page-item {{ currentPage <= 1 ? 'disabled' : '' }}">
                                                <a class="page-link" href="{{ currentPage > 1 ? path('admin_media_manager', pageParams|merge({ page: currentPage - 1 })) : '#' }}">Zurueck</a>
                                            </li>
                                            {% if pageStart > 1 %}
                                                <li class="page-item">
                                                    <a class="page-link" href="{{ path('admin_media_manager', pageParams|merge({ page: 1 })) }}">1</a>
                                                </li>
                                                {% if pageStart > 2 %}
                                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                                {% endif %}
                                            {% endif %}
                                            {% for page in pageStart..pageEnd %}
                                                <li class="page-item {{ page == currentPage ? 'active' : '' }}">
                                                    <a class="page-link" href="{{ path('admin_media_manager', pageParams|merge({ page: page })) }}">{{ page }}</a>
                                                </li>
                                            {% endfor %}
                                            {% if pageEnd < totalPages %}
                                                {% if pageEnd < totalPages - 1 %}
                                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                                {% endif %}
                                                <li class="page-item">
                                                    <a class="page-link" href="{{ path('admin_media_manager', pageParams|merge({ page: totalPages })) }}">{{ totalPages }}</a>
                                                </li>
                                            {% endif %}
                                            <li class="page-item {{ currentPage >= totalPages ? 'disabled' : '' }}">
                                                <a class="page-link" href="{{ currentPage < totalPages ? path('admin_media_manager', pageParams|merge({ page: currentPage + 1 })) : '#' }}">Weiter</a>
                                            </li>
                                        </ul>
                                    </nav>
                                </div>
                            {% endif %}
                        </div>
                        <div class="tab-pane fade" id="media-pane-icons" role="tabpanel" aria-labelledby="media-tab-icons">
                            <div class="p-3">
                                {% if uxIconGroups is empty %}
                                    <div class="text-muted">Keine UX Icons gefunden.</div>
                                {% else %}
                                    <div class="tfd-ux-icon-groups">
                                        {% for group in uxIconGroups %}
                                            <div class="tfd-ux-icon-group">
                                                <div class="tfd-ux-icon-group__header">
                                                    <div class="fw-semibold">{{ group.collection }}</div>
                                                    <div class="text-muted small">{{ group.count }}</div>
                                                </div>
                                                <div class="tfd-ux-icon-grid">
                                                    {% for icon in group.icons %}
                                                        <div class="tfd-ux-icon-card">
                                                            <div class="tfd-ux-icon-preview">
                                                                {{ ux_icon(icon.id) }}
                                                            </div>
                                                            <div class="tfd-ux-icon-meta">
                                                                <div class="tfd-ux-icon-name">{{ icon.name }}</div>
                                                                <code class="tfd-ux-icon-id">{{ icon.id }}</code>
                                                            </div>
                                                        </div>
                                                    {% endfor %}
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}
