{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Bild annotieren — {{ asset.name }}{% endblock %}

{% block main %}
<div
    data-controller="image-annotator"
    data-image-annotator-image-url-value="/{{ asset.filePath|trim('/') }}"
    data-image-annotator-asset-id-value="{{ asset.id }}"
    data-image-annotator-back-url-value="{{ backUrl }}"
    data-image-annotator-api-get-value="{{ path('admin_api_media_asset_annotations_get', {id: asset.id}) }}"
    data-image-annotator-api-save-value="{{ path('admin_api_media_asset_annotations_save', {id: asset.id}) }}"
>
    {# ── Toolbar ── #}
    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <div class="btn-group btn-group-sm" role="group" aria-label="Werkzeug">
                    <button type="button" class="btn btn-dark active"
                        data-image-annotator-target="toolRect"
                        data-action="click->image-annotator#selectRect"
                        title="Rechteck zeichnen">
                        ▭ Rechteck
                    </button>
                    <button type="button" class="btn btn-outline-dark"
                        data-image-annotator-target="toolText"
                        data-action="click->image-annotator#selectText"
                        title="Text platzieren">
                        T Text
                    </button>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <label class="form-label mb-0 small fw-semibold">Farbe:</label>
                    <input type="color" value="#ff0000" class="form-control form-control-color form-control-sm"
                        data-image-annotator-target="colorPicker"
                        data-action="input->image-annotator#colorChanged"
                        title="Farbe wählen" style="width:40px;height:30px;padding:2px">
                </div>

                <div class="d-flex align-items-center gap-2" data-image-annotator-target="fontSizeGroup">
                    <label class="form-label mb-0 small fw-semibold">Schriftgr.:</label>
                    <select class="form-select form-select-sm" style="width:80px"
                        data-image-annotator-target="fontSize"
                        data-action="change->image-annotator#fontSizeChanged">
                        <option value="12">12px</option>
                        <option value="16">16px</option>
                        <option value="20" selected>20px</option>
                        <option value="28">28px</option>
                        <option value="36">36px</option>
                        <option value="48">48px</option>
                    </select>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <label class="form-label mb-0 small fw-semibold">Stärke:</label>
                    <select class="form-select form-select-sm" style="width:80px"
                        data-image-annotator-target="strokeWidth"
                        data-action="change->image-annotator#strokeWidthChanged">
                        <option value="1">1px</option>
                        <option value="2" selected>2px</option>
                        <option value="3">3px</option>
                        <option value="5">5px</option>
                        <option value="8">8px</option>
                    </select>
                </div>

                <div class="ms-auto d-flex gap-2 flex-wrap">
                    <button type="button" class="btn btn-sm btn-outline-danger"
                        data-action="click->image-annotator#undoLast"
                        title="Letzte Annotation rückgängig">
                        ↩ Rückgängig
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger"
                        data-action="click->image-annotator#clearAll"
                        title="Alle Annotationen entfernen">
                        🗑 Alle löschen
                    </button>
                    <button type="button" class="btn btn-sm btn-success"
                        data-action="click->image-annotator#save"
                        data-image-annotator-target="saveBtn">
                        💾 Speichern
                    </button>
                    {% if backUrl %}
                        <a href="{{ backUrl }}" class="btn btn-sm btn-secondary">← Zurück</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {# ── Status ── #}
    <div class="alert alert-success d-none mb-2" data-image-annotator-target="successMsg" role="alert">
        Annotationen gespeichert.
    </div>
    <div class="alert alert-danger d-none mb-2" data-image-annotator-target="errorMsg" role="alert">
        Fehler beim Speichern.
    </div>

    {# ── Text-Input Modal ── #}
    <div class="mb-2 d-none" data-image-annotator-target="textInputRow">
        <div class="card border-warning">
            <div class="card-body py-2">
                <div class="d-flex align-items-center gap-2">
                    <label class="form-label mb-0 small fw-semibold">Text:</label>
                    <input type="text" class="form-control form-control-sm" placeholder="Text eingeben …"
                        data-image-annotator-target="textInput" style="max-width:300px">
                    <button type="button" class="btn btn-sm btn-warning"
                        data-action="click->image-annotator#confirmText">Platzieren</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                        data-action="click->image-annotator#cancelText">Abbrechen</button>
                </div>
            </div>
        </div>
    </div>

    {# ── Canvas ── #}
    <div class="position-relative d-inline-block" style="max-width:100%;overflow:auto">
        <canvas
            data-image-annotator-target="canvas"
            data-action="mousedown->image-annotator#onMouseDown mouseup->image-annotator#onMouseUp mousemove->image-annotator#onMouseMove"
            style="cursor:crosshair;display:block;border:1px solid #dee2e6;max-width:100%">
        </canvas>
    </div>

    <div class="mt-2 text-muted small" data-image-annotator-target="hint">
        Klicken und ziehen um ein Rechteck zu zeichnen.
    </div>
</div>
{% endblock %}
