{% block javascripts %}
<script>
  // Runs immediately in <head> — only touches CSS variables, no DOM queries
  function applyAccentColor(color) {
    var root = document.documentElement;
    root.style.setProperty('--lime', color);
    root.style.setProperty('--lime-glow', color);
    root.style.setProperty('--lime-subtle', color + '19');
    root.style.setProperty('--lime-border', color + '4d');
  }
  var _savedAccent = localStorage.getItem('crmfux-accent-color') || '#bfff00';
  applyAccentColor(_savedAccent);

  // Everything else waits for the DOM
  document.addEventListener('DOMContentLoaded', function () {

    // ─── THEME TOGGLE ─────────────────────────────────────────────
    var savedTheme = localStorage.getItem('crmfux-widget-theme') || 'dark';
    if (savedTheme === 'light') document.body.classList.add('light-theme');

    var themeToggle = document.getElementById('theme-toggle');
    if (themeToggle) {
      themeToggle.textContent = savedTheme === 'light' ? '☀️' : '🌙';
      themeToggle.addEventListener('click', function () {
        var isLight = document.body.classList.toggle('light-theme');
        localStorage.setItem('crmfux-widget-theme', isLight ? 'light' : 'dark');
        themeToggle.textContent = isLight ? '☀️' : '🌙';
      });
    }

    // ─── ACCENT COLOR PICKER ──────────────────────────────────────
    var accentPresets = {
      '#bfff00': 'Neon Lime', '#ff3333': 'Rot', '#00cce3': 'Cyan',
      '#bb7dfa': 'Lila', '#f2711c': 'Orange', '#00ff88': 'Grün',
      '#ffff00': 'Gelb', '#ff00ff': 'Magenta'
    };
    var accentInput = document.getElementById('accent-color');
    var accentHint  = document.querySelector('.accent-hint');
    if (accentInput) {
      accentInput.value = _savedAccent;
      if (accentHint) accentHint.textContent = accentPresets[_savedAccent.toUpperCase()] || _savedAccent;
      accentInput.addEventListener('input', function (e) {
        var color = e.target.value;
        applyAccentColor(color);
        localStorage.setItem('crmfux-accent-color', color);
        if (accentHint) accentHint.textContent = accentPresets[color.toUpperCase()] || color.toUpperCase();
      });
    }

    // ─── TAB SWITCHING ────────────────────────────────────────────
    var tabs = document.querySelectorAll('.tab');
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var tabName = tab.dataset.tab;
        document.querySelectorAll('.tab').forEach(function (t) { t.classList.remove('active'); });
        document.querySelectorAll('.tab-content').forEach(function (c) { c.classList.remove('active'); });
        tab.classList.add('active');
        var panel = document.getElementById('tab-' + tabName);
        if (panel) panel.classList.add('active');
      });
    });

    // ─── TOGGLE SWITCHES (synced to native checkboxes) ────────────
    document.querySelectorAll('.toggle-switch[data-toggle-for]').forEach(function (toggle) {
      var checkbox = document.getElementById(toggle.dataset.toggleFor);
      if (!checkbox) return;
      // Initialise visual state from actual DOM checkbox (DB value)
      if (checkbox.checked) toggle.classList.add('active');
      toggle.addEventListener('click', function () {
        toggle.classList.toggle('active');
        checkbox.checked = toggle.classList.contains('active');
      });
    });

    // ─── COPY TO CLIPBOARD ────────────────────────────────────────
    document.querySelectorAll('.copy-btn[data-copy-source]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var source = document.getElementById(btn.dataset.copySource);
        if (!source) return;
        var text = source.textContent;
        var reset = function () {
          setTimeout(function () {
            btn.textContent = 'Kopieren';
            btn.classList.remove('copied');
          }, 2000);
        };
        if (navigator.clipboard) {
          navigator.clipboard.writeText(text).then(function () {
            btn.textContent = '✓ Kopiert!';
            btn.classList.add('copied');
            reset();
          });
        } else {
          var ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
          btn.textContent = '✓ Kopiert!';
          btn.classList.add('copied');
          reset();
        }
      });
    });

  }); // end DOMContentLoaded
</script>
{% endblock %}
