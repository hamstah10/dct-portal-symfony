<!DOCTYPE html>
<html{% block html_attributes %}{% endblock %}>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            <link
                href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
                rel="stylesheet"
                integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
                crossorigin="anonymous"
            >
            <style>
                @import url('https://fonts.googleapis.com/css2?family=Audiowide&family=Bungee+Spice&family=Chakra+Petch:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=Orbitron:wght@400..900&family=Oswald:wght@200..700&display=swap');

                h1,
                h2,
                h3,
                h4 {
                    font-family: 'Chakra Petch', sans-serif;
                }
            </style>
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
            <script
                src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
                crossorigin="anonymous"
            ></script>
        {% endblock %}
    </head>
    <body{% block body_attributes %}{% endblock %}>
        {% set appNotificationTopics = ['tfd/portal/global', 'tfd/portal/app'] %}
        {% set forwardedProto = app.request.headers.get('x-forwarded-proto') %}
        {% set cfVisitor = app.request.headers.get('cf-visitor') %}
        {% set schemeCandidate = forwardedProto ? (forwardedProto|split(',')|first|trim) : (cfVisitor and 'https' in cfVisitor ? 'https' : app.request.scheme) %}
        {% set scheme = schemeCandidate in ['http', 'https'] ? schemeCandidate : 'https' %}
        {% if scheme == 'http' %}
            {% set scheme = 'https' %}
        {% endif %}
        {% set portalHubUrl = scheme ~ '://' ~ app.request.httpHost ~ path('app_portal_mercure_hub') %}

        <div class="d-none"
            {{ stimulus_controller('@symfony/ux-notify/notify', {
                hub: portalHubUrl,
                topics: appNotificationTopics
            }) }}
        ></div>

        <div id="app-shell">
            {% block body %}{% endblock %}
        </div>

        <div id="tfd-toast-container"
             class="toast-container position-fixed top-0 end-0 p-3"
             data-turbo-permanent
             aria-live="polite"
             aria-atomic="true"></div>
    </body>
</html>
